# (名稱, 函式)。函式收 db，回傳新增的筆數；清單在各來源定義之後補上。
SOURCES = []


def read_jsonl(path, cursor=None):
    """逐行讀文字檔；讀不到就警告一次，回傳空的。
    給了 cursor 就從 cursor["offset"] 開始讀，只讀到最後一個完整的行為止，並把 offset 往後推；
    還沒寫完的最後一行留到下次。檔案變短（被重寫）就從頭讀。"""
    try:
        with open(path, "rb") as f:
            start = 0
            if cursor is not None:
                start = cursor.get("offset") or 0
                if start > os.fstat(f.fileno()).st_size:
                    start = 0
                    cursor["state"] = None
                f.seek(start)
            data = f.read()
    except OSError as e:
        warn("cannot read %s: %s" % (path, e.strerror))
        return
    end = data.rfind(b"\n") + 1
    if cursor is not None:
        data = data[:end]
        cursor["offset"] = start + end
    for line in data.decode("utf-8", "replace").splitlines(True):
        yield line


def line_hash(line):
    import hashlib
    return hashlib.sha1(line.encode("utf-8", "replace")).hexdigest()[:20]


def walk_files(root, suffix=".jsonl"):
    for dirpath, _dirs, names in os.walk(root):
        for n in names:
            if n.endswith(suffix):
                yield os.path.join(dirpath, n)


def import_files(db, source, paths, parse):
    """只讀有變動的檔案、而且只讀新追加的部分；parse(path, cursor) 回傳用量列。"""
    added = 0
    for path in paths:
        sig = file_changed(db, path)
        if sig is None:
            continue
        cursor = file_cursor(db, path)
        added += add_usage(db, parse(path, cursor))
        mark_file(db, path, sig, cursor)
    return added


def _int(v):
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return 0


# ---- Claude Code：~/.claude/projects/<專案>/<session>.jsonl

def claude_roots():
    """CLAUDE_CONFIG_DIR 可以用逗號列好幾個；沒設就看 ~/.claude 和 ~/.config/claude。"""
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        bases = [p.strip() for p in env.split(",") if p.strip()]
    else:
        home = os.path.expanduser("~")
        bases = [os.path.join(home, ".claude"), os.path.join(home, ".config", "claude")]
    return [os.path.join(b, "projects") for b in bases if os.path.isdir(os.path.join(b, "projects"))]


def parse_claude_file(path, cursor=None):
    """只取 assistant 行的用量欄位；訊息內容不看也不存。
    同一則訊息會出現在好幾行（串流途中），用 (message.id, requestId) 去重，留 token 最多的那筆。"""
    best = {}
    sub_path = (os.sep + "subagents" + os.sep) in path
    for line in read_jsonl(path, cursor):
        if '"usage"' not in line or '"assistant"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if not isinstance(d, dict) or d.get("type") != "assistant":
            continue
        msg = d.get("message") or {}
        u = msg.get("usage")
        model = msg.get("model") or ""
        if not isinstance(u, dict) or model == "<synthetic>":
            continue
        ts = iso_ts(d.get("timestamp"))
        if ts is None:
            continue
        mid, req = msg.get("id"), d.get("requestId")
        uid = "%s:%s" % (mid, req) if mid and req else "line:%s" % (d.get("uuid") or line_hash(line))
        cc = u.get("cache_creation") or {}
        c5, c1 = _int(cc.get("ephemeral_5m_input_tokens")), _int(cc.get("ephemeral_1h_input_tokens"))
        if not cc:  # 舊格式只有總數，當成 5 分鐘快取
            c5 = _int(u.get("cache_creation_input_tokens"))
        if u.get("speed") == "fast":
            model += "@fast"
        row = {"source": "claude", "uid": uid, "ts": int(ts), "model": normalize_model(model),
               "project": d.get("cwd") or "", "session": d.get("sessionId") or "",
               "input": _int(u.get("input_tokens")), "cache_read": _int(u.get("cache_read_input_tokens")),
               "cache_write_5m": c5, "cache_write_1h": c1, "output": _int(u.get("output_tokens")),
               "reasoning": _int((u.get("output_tokens_details") or {}).get("thinking_tokens")),
               "subagent": 1 if (d.get("isSidechain") or sub_path) else 0}
        old = best.get(uid)
        if old is None or row["output"] > old["output"]:
            best[uid] = row
    return list(best.values())


def sync_claude(db):
    paths = [p for root in claude_roots() for p in sorted(walk_files(root))]
    return import_files(db, "claude", paths, parse_claude_file)


SOURCES.append(("claude", sync_claude))


# ---- Codex：~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl 和 ~/.codex/archived_sessions/

def codex_home():
    return os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")


def codex_usage_row(u, ts, uid, model, session, project):
    """OpenAI 的 input 已含 cached，這裡扣掉，跟 Anthropic 的語意一致。"""
    inp, cached = _int(u.get("input_tokens")), _int(u.get("cached_input_tokens"))
    return {"source": "codex", "uid": uid, "ts": int(ts), "model": normalize_model(model),
            "project": project, "session": session, "input": max(inp - cached, 0),
            "cache_read": cached, "cache_write_5m": _int(u.get("cache_write_input_tokens")),
            "cache_write_1h": 0, "output": _int(u.get("output_tokens")),
            "reasoning": _int(u.get("reasoning_output_tokens"))}


def parse_codex_file(path, cursor=None):
    """回傳 (用量列, 額度列)。
    用量來自 event_msg/token_count：每次回應後 Codex 會寫一筆 last_token_usage 和累計的
    total_token_usage。累計值沒變的重複事件略過。加總起來跟 Codex 自己 state_5.sqlite 裡
    threads.tokens_used 一致。（新版另外有 token_usage_record，但它的加總比 Codex 自己記的
    多 2% 左右，對不上帳，所以不用。）"""
    rows, limits = [], []
    st = (cursor or {}).get("state") or {}
    model, session, project = st.get("model", ""), st.get("session", ""), st.get("project", "")
    prev = st.get("prev")
    for line in read_jsonl(path, cursor):
        if not any(k in line for k in ('"token_count"', '"turn_context"', '"session_meta"')):
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if not isinstance(d, dict):
            continue
        t, p = d.get("type"), d.get("payload")
        if not isinstance(p, dict):
            continue
        if t == "session_meta":
            session = session or p.get("id") or p.get("session_id") or ""
            project = project or p.get("cwd") or ""
            continue
        if t == "turn_context":
            model = p.get("model") or model
            project = p.get("cwd") or project
            continue
        if t != "event_msg" or p.get("type") != "token_count":
            continue
        ts = iso_ts(d.get("timestamp"))
        if ts is None:
            continue
        limits.extend(codex_limits(p.get("rate_limits"), ts))
        info = p.get("info") or {}
        total = info.get("total_token_usage")
        if not isinstance(total, dict):
            continue
        tt = _int(total.get("total_tokens"))
        ptt = None if prev is None else _int(prev.get("total_tokens"))
        if ptt is not None and tt == ptt:
            continue
        u = info.get("last_token_usage")
        if not isinstance(u, dict):  # 沒有單次用量就用累計值的差
            u = total if ptt is None or tt < ptt else {k: _int(total.get(k)) - _int(prev.get(k))
                                                       for k in total}
        prev = total
        # 用時間和累計值當 uid：fork 出來的 session 會複製父 session 的事件，這樣不會重複計算
        rows.append(codex_usage_row(u, ts, "tc:%s:%d" % (d.get("timestamp"), tt), model,
                                    session, project))
    if cursor is not None:
        cursor["state"] = {"model": model, "session": session, "project": project, "prev": prev}
    return rows, limits


def codex_limits(rl, ts):
    """rate_limits 的 primary（5 小時）和 secondary（每週）視窗。"""
    out = []
    if not isinstance(rl, dict):
        return out
    lid = rl.get("limit_id") or "codex"
    for key in ("primary", "secondary"):
        w = rl.get(key)
        if not isinstance(w, dict) or w.get("used_percent") is None:
            continue
        # primary／secondary 對應哪個視窗會變（現在 primary 是一週），所以用視窗長度命名
        minutes = _int(w.get("window_minutes")) or None
        name = window_label(minutes) if lid == "codex" else "%s %s" % (lid, window_label(minutes))
        out.append({"source": "codex", "name": name, "ts": int(ts),
                    "used_percent": float(w["used_percent"]),
                    "window_minutes": minutes,
                    "resets_at": _int(w.get("resets_at")) or None,
                    "plan": rl.get("plan_type") or ""})
    return out


def sync_codex(db):
    home = codex_home()
    paths = []
    for sub in ("sessions", "archived_sessions"):
        root = os.path.join(home, sub)
        if os.path.isdir(root):
            paths.extend(sorted(walk_files(root)))
    added = 0
    for path in paths:
        sig = file_changed(db, path)
        if sig is None:
            continue
        cursor = file_cursor(db, path)
        rows, limits = parse_codex_file(path, cursor)
        added += add_usage(db, rows)
        add_limits(db, limits)
        mark_file(db, path, sig, cursor)
    return added


SOURCES.append(("codex", sync_codex))


def sync(db, only=None, quiet=False):
    added = {}
    for name, fn in SOURCES:
        if only and name not in only:
            continue
        try:
            added[name] = fn(db)
        except Exception as e:  # 一個來源壞掉不要拖垮其他來源
            warn("%s: sync failed: %s" % (name, e))
            added[name] = 0
        db.commit()
    db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('last_sync', ?)", (str(int(now())),))
    db.commit()
    if not quiet:
        for name, n in added.items():
            print("%-8s +%d" % (name, n))
    return added


# ---------------------------------------------------------------- 彙總

def row_cost(r, price):
    """一列（或一組加總）的等值 API 花費；來源自己給了金額就用它。"""
    if r.get("cost_usd") is not None:
        return r["cost_usd"]
    if price is None:
        return None
    return (r["input"] * price["input"] + r["cache_read"] * price["cache_read"]
            + r["cache_write_5m"] * price["cache_write_5m"]
            + r["cache_write_1h"] * price["cache_write_1h"]
            + r["output"] * price["output"]) / 1e6


def summary(db, start, end, prices=None, plan_table=None, label=""):
    prices = load_prices() if prices is None else prices
    plan_table = plans() if plan_table is None else plan_table
    q = ("SELECT source, model, SUM(requests) AS requests, %s, SUM(cost_usd) AS cost_usd, "
         "COUNT(cost_usd) AS n_cost, COUNT(*) AS n, SUM(subagent * requests) AS sub "
         "FROM usage WHERE ts >= ? AND ts < ? GROUP BY source, model ORDER BY source, model"
         % ", ".join("SUM(%s) AS %s" % (c, c) for c in TOKEN_COLS))
    by_src = {}
    unpriced = set()
    for row in db.execute(q, (start, end)):
        r = dict(row)
        if r["n_cost"] != r["n"]:   # 只有部分列有實際金額時不能直接用
            r["cost_usd"] = None
        price = price_for(r["model"], prices)
        cost = row_cost(r, price)
        if cost is None:
            unpriced.add(r["model"])
        src = by_src.setdefault(r["source"], {"source": r["source"], "models": [],
                                              "totals": dict.fromkeys(("requests", "subagent_requests")
                                                                      + TOKEN_COLS, 0),
                                              "cost_usd": 0.0})
        m = {"model": r["model"], "requests": r["requests"], "cost_usd": cost}
        for c in TOKEN_COLS:
            m[c] = r[c] or 0
            src["totals"][c] += m[c]
        src["totals"]["requests"] += r["requests"] or 0
        src["totals"]["subagent_requests"] += r["sub"] or 0
        src["cost_usd"] += cost or 0.0
        src["models"].append(m)
    days = max((end - start) / 86400.0, 1e-9)
    out_sources = []
    for name in sorted(by_src):
        s = by_src[name]
        s["models"].sort(key=lambda m: -(m["cost_usd"] or 0))
        plan = plan_table.get(name)
        if plan:
            fee = plan["usd"] if 27 <= days <= 32 else plan["usd"] * days / 30.44
            s["plan"] = dict(plan, fee_in_range=round(fee, 2),
                             value_ratio=round(s["cost_usd"] / fee, 2) if fee else None)
        out_sources.append(s)
    return {"range": {"start": int(start), "end": int(end), "label": label},
            "sources": out_sources,
            "total_cost_usd": round(sum(s["cost_usd"] for s in out_sources), 4),
            "unpriced_models": sorted(unpriced)}


def fmt_dur(sec):
    sec = max(int(sec), 0)
    d, h, m = sec // 86400, sec % 86400 // 3600, sec % 3600 // 60
    if d:
        return "%dd%dh" % (d, h)
    if h:
        return "%dh%02dm" % (h, m)
    return "%dm" % m if m else "%ds" % sec


def window_label(minutes):
    if not minutes:
        return "?"
    if minutes % 10080 == 0:
        return "week" if minutes == 10080 else "%dw" % (minutes // 10080)
    if minutes % 1440 == 0:
        return "%dd" % (minutes // 1440)
    if minutes % 60 == 0:
        return "%dh" % (minutes // 60)
    return "%dm" % minutes


def current_limits(db, t=None):
    """每個額度視窗最新的一筆。已經過了重置時間的視窗當作 0%。"""
    t = now() if t is None else t
    out = []
    q = ("SELECT l.* FROM limits l JOIN (SELECT source, name, MAX(ts) AS ts FROM limits "
         "GROUP BY source, name) x ON l.source = x.source AND l.name = x.name AND l.ts = x.ts "
         "ORDER BY l.source, l.window_minutes")
    rows = [dict(r) for r in db.execute(q)]
    newest = {}
    for r in rows:
        newest[r["source"]] = max(newest.get(r["source"], 0), r["ts"])
    for r in rows:
        if newest[r["source"]] - r["ts"] > 8 * 86400:  # 這個視窗已經很久沒出現，大概是方案換了
            continue
        r["stale"] = bool(r["resets_at"] and r["resets_at"] <= t)
        if r["stale"]:
            r["used_percent"] = 0.0
            r["resets_in"] = None
        else:
            r["resets_in"] = int(r["resets_at"] - t) if r["resets_at"] else None
        r["window"] = window_label(r["window_minutes"])
        r["age"] = int(t - r["ts"])
        out.append(r)
    return out


def render_limits(limits):
    lines = []
    for r in limits:
        when = "reset since last seen" if r["stale"] else (
            "resets in " + fmt_dur(r["resets_in"]) if r["resets_in"] is not None else "")
        lines.append("  %-7s %-24s %5.0f%%  %s%s" % (
            r["source"], cell(r["name"], 24),
            r["used_percent"], when, ("  (plan %s)" % r["plan"]) if r["plan"] else ""))
    return "\n".join(["Limits"] + lines) if lines else ""


BREAKDOWNS = {
    "project": "project",
    "session": "session",
    "day": "date(ts, 'unixepoch', 'localtime')",
}


def breakdown(db, start, end, by, prices=None):
    """依專案、session 或日期拆開的花費。每一組都按模型分別換算再加總。"""
    prices = load_prices() if prices is None else prices
    key = BREAKDOWNS[by]
    q = ("SELECT source, %s AS k, model, SUM(requests) AS requests, %s, SUM(cost_usd) AS cost_usd, "
         "COUNT(cost_usd) AS n_cost, COUNT(*) AS n, SUM(subagent * requests) AS sub "
         "FROM usage WHERE ts >= ? AND ts < ? GROUP BY source, k, model"
         % (key, ", ".join("SUM(%s) AS %s" % (c, c) for c in TOKEN_COLS)))
    groups = {}
    for row in db.execute(q, (start, end)):
        r = dict(row)
        if r["n_cost"] != r["n"]:
            r["cost_usd"] = None
        cost = row_cost(r, price_for(r["model"], prices))
        g = groups.setdefault((r["source"], r["k"]), dict(
            {"source": r["source"], by: r["k"] or "", "requests": 0, "subagent_requests": 0,
             "cost_usd": 0.0, "models": []}, **dict.fromkeys(TOKEN_COLS, 0)))
        g["requests"] += r["requests"] or 0
        g["subagent_requests"] += r["sub"] or 0
        for c in TOKEN_COLS:
            g[c] += r[c] or 0
        g["cost_usd"] += cost or 0.0
        g["models"].append(r["model"])
    out = list(groups.values())
    if by == "day":
        out.sort(key=lambda g: (g["day"], g["source"]))
    else:
        out.sort(key=lambda g: -g["cost_usd"])
    for g in out:
        g["cost_usd"] = round(g["cost_usd"], 4)
    return out


def short_path(p, n=2):
    parts = [x for x in p.replace("\\", "/").split("/") if x]
    return "/".join(parts[-n:]) if parts else (p or "?")


def render_breakdown(groups, by, limit=30):
    lines = ["%-30s %-7s %8s %8s %9s %8s %10s" % ("by " + by, "source", "requests", "input",
                                                "cache rd", "output", "API equiv")]
    for g in groups[:limit] if by != "day" else groups:
        label = short_path(g[by]) if by == "project" else (g[by] or "?")
        lines.append("%s %-7s %8s %8s %9s %8s %10s" % (
            cell(label, 30, tail=True), g["source"], fmt_tok(g["requests"]), fmt_tok(g["input"]),
            fmt_tok(g["cache_read"]), fmt_tok(g["output"]), fmt_usd(g["cost_usd"])))
    if by != "day" and len(groups) > limit:
        lines.append("... %d more (use --json for all)" % (len(groups) - limit))
    return "\n".join(lines)


# 顯示寬度的小工具移植自 slurmtop（~/Documents/slurmtop，commit 84cd35d）的 vlen/pad/clip，
# 拿掉了色碼處理以外的部分。全形字佔兩格，對齊時要算進去。

ANSI = re.compile(r"\033\[[0-9;?]*[a-zA-Z]")


def vlen(s):
    w = 0
    for ch in ANSI.sub("", s):
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def cell(s, width, tail=False):
    """固定寬度欄位：太長就裁掉（tail=True 保留尾巴，適合路徑），太短補空白。"""
    s = s or ""
    if vlen(s) > width:
        chars = list(reversed(s)) if tail else list(s)
        out, w = [], 0
        for ch in chars:
            cw = vlen(ch)
            if w + cw > width:
                break
            out.append(ch)
            w += cw
        s = "".join(reversed(out)) if tail else "".join(out)
    return s + " " * (width - vlen(s))


def fmt_tok(n):
    n = n or 0
    for div, suf in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if abs(n) >= div:
            v = n / div
            return ("%.1f%s" % (v, suf)) if v < 100 else ("%d%s" % (v, suf))
    return str(int(n))


def fmt_usd(v):
    if v is None:
        return "?"
    if abs(v) >= 1000:
        return "$%s" % format(int(round(v)), ",")
    return "$%.2f" % v


def render_summary(s):
    lines = ["ComputAI  %s  (%s - %s)" % (s["range"]["label"], day_label(s["range"]["start"]),
                                         day_label(s["range"]["end"] - 1)), ""]
    if not s["sources"]:
        lines.append("No usage recorded in this range. Run `computai --sync` first.")
        return "\n".join(lines)
    head = "%-26s %8s %8s %9s %9s %8s %10s" % ("", "requests", "input", "cache rd", "cache wr",
                                                "output", "API equiv")
    lines.append(head)
    for src in s["sources"]:
        lines.append(src["source"])
        for m in src["models"]:
            lines.append("  %s %8s %8s %9s %9s %8s %10s" % (
                cell(m["model"] or "?", 24), fmt_tok(m["requests"]), fmt_tok(m["input"]),
                fmt_tok(m["cache_read"]), fmt_tok(m["cache_write_5m"] + m["cache_write_1h"]),
                fmt_tok(m["output"]), fmt_usd(m["cost_usd"])))
        t = src["totals"]
        lines.append("  %-24s %8s %8s %9s %9s %8s %10s" % (
            "total", fmt_tok(t["requests"]), fmt_tok(t["input"]), fmt_tok(t["cache_read"]),
            fmt_tok(t["cache_write_5m"] + t["cache_write_1h"]), fmt_tok(t["output"]),
            fmt_usd(src["cost_usd"])))
        extra = []
        if t["output"] and t["reasoning"]:
            extra.append("reasoning %d%% of output" % round(100.0 * t["reasoning"] / t["output"]))
        if t["requests"] and t["subagent_requests"]:
            extra.append("subagents %d%% of requests" % round(100.0 * t["subagent_requests"] / t["requests"]))
        if extra:
            lines.append("  " + ", ".join(extra))
        if src.get("plan"):
            p = src["plan"]
            lines.append("  plan: %s, %s for this range -> usage worth %sx the fee" % (
                p["name"], fmt_usd(p["fee_in_range"]),
                "?" if p["value_ratio"] is None else "%.1f" % p["value_ratio"]))
        lines.append("")
    lines.append("Total API-equivalent: %s" % fmt_usd(s["total_cost_usd"]))
    if s["unpriced_models"]:
        lines.append("No price for: %s (add them to prices.ini)" % ", ".join(s["unpriced_models"]))
    return "\n".join(lines)


# ---------------------------------------------------------------- 機器
#
# 讀取機器狀態的方式移植自 slurmtop（~/Documents/slurmtop，MIT，commit 84cd35d）：
# 遠端只跑 POSIX sh，輸出分成「@@段名」開頭的段落；本機一樣用 sh 跑同一份腳本。
# 移植了 cpu、load、mem、gpu（nvidia-smi）、amdgpu、applegpu 這幾段和對應的 parser，
# 拿掉 Slurm、行程、磁碟、網路。新增的 svc 段用 curl／wget 在機器自己身上探測推論服務，
# 所以服務只聽 127.0.0.1 也讀得到，被監控的機器也不用裝任何東西。

GPU_Q = "index,uuid,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw"
GPU_FIELDS = ("idx", "uuid", "util", "mem_used", "mem_total", "temp", "power")

# 推論服務的預設埠和要讀的路徑。prom 類的只留下需要的 metric，避免把整頁直方圖傳回來。
SERVICE_KINDS = {
    "ollama": ("/api/ps", None),
    "llamacpp": ("/metrics", "llamacpp:(prompt_tokens_total|tokens_predicted_total|requests_processing)"),
    "vllm": ("/metrics", "vllm:(prompt_tokens_total|generation_tokens_total|num_requests_running)"),
    "sglang": ("/metrics", "sglang:(prompt_tokens_total|generation_tokens_total|num_running_reqs)"),
    "lmstudio": ("/api/v0/models", None),
    "openai": ("/v1/models", None),
}
DEFAULT_SERVICES = "ollama:11434, llamacpp:8080, vllm:8000, sglang:30000, lmstudio:1234"

REMOTE = """
# 非互動的 ssh 不會讀登入設定，WSL 的 nvidia-smi（/usr/lib/wsl/lib）和某些驅動的路徑不在 PATH 裡
PATH="$PATH:/usr/lib/wsl/lib:/usr/local/nvidia/bin:/opt/bin"; export PATH
echo '@@cpu'
if [ -r /proc/stat ]; then
  head -1 /proc/stat
elif sysctl -n kern.cp_time >/dev/null 2>&1; then
  echo "CPUTIME $(sysctl -n kern.cp_time)"
else
  idle=$(top -l 1 -n 0 2>/dev/null | sed -n 's/^CPU usage:.*, \\([0-9.]*\\)% idle.*/\\1/p')
  echo "PCT $(awk -v i="${idle:-100}" 'BEGIN{printf "%.1f", 100 - i}')"
fi
echo '@@load'
if [ -r /proc/loadavg ]; then
  cut -d' ' -f1-3 /proc/loadavg
  nproc
else
  sysctl -n vm.loadavg 2>/dev/null | tr -d '{}'
  sysctl -n hw.ncpu 2>/dev/null || echo 0
fi
echo '@@mem'
if command -v free >/dev/null 2>&1; then
  free -m | awk '/^Mem:/{print $2, $3}'
elif command -v vm_stat >/dev/null 2>&1; then
  tot=$(( $(sysctl -n hw.memsize) / 1048576 ))
  vm_stat | awk -v ps="$(sysctl -n hw.pagesize)" -v tot="$tot" '
    /Pages free/ {f=$3} /Pages inactive/ {i=$3} /Pages speculative/ {s=$3}
    END {gsub(/\\./,"",f); gsub(/\\./,"",i); gsub(/\\./,"",s)
         printf "%d %d\\n", tot, tot - (f+i+s)*ps/1048576}'
else
  echo "0 0"
fi
echo '@@gpu'
command -v nvidia-smi >/dev/null 2>&1 && \\
  nvidia-smi --query-gpu=@GPU_Q@ --format=csv,noheader,nounits 2>/dev/null
echo '@@amdgpu'
rd() { v=$(cat "$1" 2>/dev/null); echo "${v:--}"; }
for d in /sys/class/drm/card[0-9]*/device; do
  case "$d" in */card*-*/device) continue ;; esac
  [ -r "$d/gpu_busy_percent" ] && [ "$(rd "$d/vendor")" = "0x1002" ] || continue
  hw=$(ls -d "$d"/hwmon/hwmon* 2>/dev/null | head -n 1)
  pw=$(rd "$hw/power1_average"); [ "$pw" = - ] && pw=$(rd "$hw/power1_input")
  echo "$(basename "$(dirname "$d")") $(rd "$d/gpu_busy_percent") $(rd "$d/mem_info_vram_used")" \\
       "$(rd "$d/mem_info_vram_total") $(rd "$hw/temp1_input") $pw $(rd "$d/unique_id")"
done
echo '@@applegpu'
command -v ioreg >/dev/null 2>&1 && \\
  ioreg -r -d 1 -w 0 -c IOAccelerator 2>/dev/null | \\
  grep -E '^\\+-o|"(model|PerformanceStatistics|gpu-core-count)"'
get() {
  if command -v curl >/dev/null 2>&1; then curl -fsS -m 2 "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then wget -qO- -T 2 "$1" 2>/dev/null
  fi
}
@SERVICES@
"""


def service_list(spec):
    """`ollama:11434, vllm:8000` -> [(kind, port)]；不認得的種類略過。"""
    out = []
    for item in (spec or "").split(","):
        item = item.strip()
        if ":" not in item:
            continue
        kind, port = item.split(":", 1)
        kind = kind.strip().lower()
        if kind in SERVICE_KINDS and port.strip().isdigit():
            out.append((kind, int(port)))
    return out


def remote_script(services):
    lines = []
    for kind, port in services:
        path, keep = SERVICE_KINDS[kind]
        lines.append("echo '@@svc %s %d'" % (kind, port))
        cmd = "get http://127.0.0.1:%d%s" % (port, path)
        if keep:
            cmd += " | grep -E '^(%s)' | head -n 200" % keep
        else:
            cmd += " | head -c 400000"
        lines.append(cmd)
        lines.append("echo")  # 回應最後沒有換行時，下一段的標題才不會黏上去
    return REMOTE.replace("@GPU_Q@", GPU_Q).replace("@SERVICES@", "\n".join(lines))


# 控制字元（ESC、BEL、C1…）：從別的機器讀回來的文字可能被拿來偽造終端機畫面，先去掉。
_CTRL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def untrusted(text):
    return _CTRL.sub("", text or "")


def run_cmd(argv, stdin=None, timeout=20, errors=None):
    """跑指令回傳 stdout。給了 errors（list）就把失敗原因（stderr 最後一行或逾時）放進去。"""
    try:
        p = subprocess.run(argv, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           text=True, timeout=timeout)
        if errors is not None and p.returncode != 0:
            lines = [ln.strip() for ln in untrusted(p.stderr or "").splitlines() if ln.strip()]
            errors.append(lines[-1][:200] if lines else "exit status %d" % p.returncode)
        return p.stdout or ""
    except subprocess.TimeoutExpired:
        if errors is not None:
            errors.append("no answer within %d s" % timeout)
        return ""
    except (OSError, subprocess.SubprocessError) as e:
        if errors is not None:
            errors.append(str(e)[:200])
        return ""


# 每台機器最近一次讀不到的原因（給警示和 --sample 用）
ssh_errors = {}


def ssh_hint(msg):
    """把 ssh 的錯誤訊息翻成下一步該做什麼。"""
    if "Host key verification failed" in msg:
        return "its host key is not in known_hosts under this name; use the name or IP you already " \
               "ssh to, or run `ssh HOST` once by hand"
    if "Permission denied" in msg:
        return "key login was refused; passwordless SSH (ssh -o BatchMode=yes HOST true) must work"
    if "no answer" in msg:
        return "it did not answer in time (Tailscale SSH waiting for a browser check?)"
    if "Could not resolve" in msg:
        return "the name does not resolve; try its Tailscale IP or MagicDNS name"
    return ""


SHELL_PICK = "command -v bash >/dev/null 2>&1 && exec bash -s || exec sh -s"


def run_script(host, script, timeout=25):
    """在機器上跑 REMOTE。host 是 local 就在本機跑，否則用 ssh（BatchMode，不會卡在密碼）。
    測試用 COMPUTAI_FIXTURES 指向一個目錄，讀 <目錄>/node/<host>.txt。"""
    fx = os.environ.get("COMPUTAI_FIXTURES")
    if fx:
        n = _fx_calls[host] = _fx_calls.get(host, 0) + 1
        for name in ("%s.%d.txt" % (host, n), host + ".txt"):
            path = os.path.join(fx, "node", name)
            if os.path.exists(path):
                with open(path, encoding="utf-8") as f:
                    return f.read()
        return ""
    if host == "local":
        if os.name == "nt":
            return local_windows(script)
        return run_cmd(["sh", "-c", SHELL_PICK], stdin=script, timeout=timeout)
    if host.startswith("-"):  # 不讓設定檔裡的名字被 ssh 當成選項
        return ""
    argv = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4"]
    cdir = ssh_control_dir()
    if cdir:
        # 第一次連線後重複使用，省掉每次取樣的 SSH 握手。socket 放在只有自己能進的資料夾，
        # 不放 /tmp：多人共用的機器上，別人可以在 /tmp 先建一個同名的 socket。
        argv += ["-o", "ControlMaster=auto", "-o", "ControlPath=" + os.path.join(cdir, "%C"),
                 "-o", "ControlPersist=120"]
    errs = []
    out = run_cmd(argv + ["--", host, "sh -c '%s'" % SHELL_PICK], stdin=script, timeout=timeout,
                  errors=errs)
    if errs and not out:
        ssh_errors[host] = errs[-1]
    else:
        ssh_errors.pop(host, None)
    return out


_fx_calls = {}


def ssh_control_dir():
    """SSH 連線共用的 socket 資料夾（權限 700）。Windows 的 OpenSSH 不支援；路徑太長
    （Unix socket 上限約 104 字元）也不用。"""
    if not hasattr(os, "getuid"):
        return None
    d = os.path.join(data_dir(), "ssh")
    if len(d) + 41 > 100:
        return None
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        os.chmod(d, 0o700)
    except OSError:
        return None
    return d


def local_windows(script):
    """Windows 本機沒有 sh：記憶體用 ctypes，GPU 用 nvidia-smi，服務用 urllib，組成同樣的段落。"""
    out = ["@@cpu", "@@load", "0 0 0", str(os.cpu_count() or 0), "@@mem"]
    try:
        import ctypes

        class MEMORYSTATUSEX(ctypes.Structure):
            _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong)] + \
                       [(n, ctypes.c_ulonglong) for n in (
                           "ullTotalPhys", "ullAvailPhys", "ullTotalPageFile", "ullAvailPageFile",
                           "ullTotalVirtual", "ullAvailVirtual", "ullAvailExtendedVirtual")]
        st = MEMORYSTATUSEX()
        st.dwLength = ctypes.sizeof(st)
        ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(st))
        out.append("%d %d" % (st.ullTotalPhys // 1048576, (st.ullTotalPhys - st.ullAvailPhys) // 1048576))
    except Exception:
        out.append("0 0")
    out.append("@@gpu")
    smi = shutil.which("nvidia-smi")
    if smi:
        out.append(run_cmd([smi, "--query-gpu=" + GPU_Q, "--format=csv,noheader,nounits"]).strip())
    for m in re.finditer(r"@@svc (\w+) (\d+)", script):
        kind, port = m.group(1), int(m.group(2))
        path, keep = SERVICE_KINDS[kind]
        body = http_get("http://127.0.0.1:%d%s" % (port, path), timeout=2) or ""
        if keep:
            body = "\n".join(ln for ln in body.splitlines() if re.match("^(%s)" % keep, ln))
        out += ["@@svc %s %d" % (kind, port), body[:400000]]
    return "\n".join(out) + "\n"


def http_get(url, timeout=3, headers=None):
    import urllib.request
    try:
        req = urllib.request.Request(url, headers=headers or {})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read(4 << 20).decode("utf-8", "replace")
    except Exception:
        return None


def sections(out):
    """依「@@段名」切開；段名後面可以帶參數（`@@svc ollama 11434`）。"""
    secs, cur = {}, None
    for ln in out.splitlines():
        m = re.match(r"^@@(\w+(?: [\w.-]+)*)\s*$", ln)
        if m:
            cur = m.group(1)
            secs[cur] = []
        elif cur:
            secs[cur].append(ln)
    return {k: "\n".join(v).strip() for k, v in secs.items()}


def num(s):
    """nvidia-smi 的數值欄位：[N/A]、[Not Supported]、空字串都當 None。"""
    try:
        v = float((s or "").strip())
    except ValueError:
        return None
    return v if math.isfinite(v) else None


def _gpu(idx, vendor, util=None, mem_used=None, mem_total=None, temp=None, power=None, model=None):
    return {"idx": str(idx), "vendor": vendor, "util": util, "mem_used": mem_used,
            "mem_total": mem_total, "temp": temp, "power": power, "model": model}


def parse_gpu(line):
    f = [x.strip() for x in line.split(",")]
    if not f[0].isdigit():
        return None
    f += [""] * (len(GPU_FIELDS) - len(f))
    g = _gpu(f[0], "nvidia")
    for k, v in zip(GPU_FIELDS[2:], f[2:]):
        g[k] = num(v)
    return g


def parse_amdgpu(text, start=0):
    def val(x, scale=1.0):
        v = num(x)
        return None if v is None else v / scale
    lines = [ln.split() for ln in (text or "").splitlines()]
    lines = [f for f in lines if len(f) >= 6 and re.match(r"^card\d+$", f[0])]
    lines.sort(key=lambda f: int(f[0][4:]))
    return [_gpu(start + i, "amd", val(f[1]), val(f[2], 1048576), val(f[3], 1048576),
                 val(f[4], 1000), val(f[5], 1e6)) for i, f in enumerate(lines)]


def parse_ioreg(text, mem_total_mib=None, start=0):
    """Apple Silicon 的使用率在 "Device Utilization %"，記憶體是共用的統一記憶體。
    溫度和功耗要 sudo powermetrics 才讀得到，這裡是 None。"""
    blocks = []
    for ln in (text or "").splitlines():
        if ln.startswith("+-o"):
            blocks.append({})
        elif blocks:
            m = re.search(r'"(model|gpu-core-count)"\s*=\s*(?:<?"?)([^">]*)', ln)
            if m:
                blocks[-1][m.group(1)] = m.group(2).strip()
            if '"PerformanceStatistics"' in ln:
                blocks[-1]["stats"] = {k: float(v) for k, v in
                                       re.findall(r'"([^"]+)"=(\d+(?:\.\d+)?)', ln)}
    gpus = []
    for b in blocks:
        st = b.get("stats")
        if st is None:
            continue
        util = st.get("Device Utilization %", st.get("GPU Activity(%)"))
        if "vramUsedBytes" in st:
            used = st["vramUsedBytes"] / 1048576
            total = used + st.get("vramFreeBytes", 0) / 1048576
        else:
            used = st["In use system memory"] / 1048576 if "In use system memory" in st else None
            total = mem_total_mib or None
        model = b.get("model") or None
        if model and b.get("gpu-core-count"):
            model += " %s-core" % b["gpu-core-count"]
        gpus.append(_gpu(start + len(gpus), "apple", util, used, total,
                         st.get("Temperature(C)"), st.get("Total Power(W)"), model))
    return gpus


def parse_cpu(line):
    """回傳 ("pct", 百分比) 或 ("raw", [累計值], 閒置欄位)。累計值要跟上一筆相減才是 CPU%。"""
    f = (line or "").split()
    if not f:
        return None
    try:
        if f[0] == "PCT":
            return ("pct", max(0.0, min(100.0, float(f[1]))))
        vals = [int(x) for x in f[1:]]
    except (ValueError, IndexError):
        return None
    return ("raw", vals, (4,) if f[0] == "CPUTIME" else (3, 4))


def cpu_pct(cur, prev):
    if not cur:
        return None
    if cur[0] == "pct":
        return cur[1]
    if not prev or prev[0] != "raw" or len(prev[1]) != len(cur[1]):
        return None
    idle_d = sum(cur[1][i] - prev[1][i] for i in cur[2])
    tot_d = sum(cur[1]) - sum(prev[1])
    return max(0.0, min(100.0, 100.0 * (tot_d - idle_d) / tot_d)) if tot_d > 0 else None


def snapshot(host, services):
    """一台機器的一次取樣：CPU、記憶體、GPU、推論服務。連不上回傳 None。"""
    secs = sections(untrusted(run_script(host, remote_script(services))))
    if "mem" not in secs:
        return None
    d = {"cpu": parse_cpu((secs.get("cpu") or "").splitlines()[0] if secs.get("cpu") else "")}
    try:
        mt, mu = secs.get("mem", "").split()[:2]
        d["mem_total"], d["mem_used"] = int(mt), int(mu)
    except ValueError:
        d["mem_total"] = d["mem_used"] = 0
    try:
        ln = secs.get("load", "").splitlines()
        d["load"] = [float(x) for x in ln[0].split()[:3]]
        d["ncpu"] = int(ln[1])
    except (ValueError, IndexError):
        d["load"], d["ncpu"] = None, None
    gpus = [g for g in map(parse_gpu, secs.get("gpu", "").splitlines()) if g]
    gpus += parse_amdgpu(secs.get("amdgpu", ""), len(gpus))
    gpus += parse_ioreg(secs.get("applegpu", ""), d["mem_total"], len(gpus))
    d["gpus"] = gpus
    d["services"] = []
    for key, body in secs.items():
        if key.startswith("svc "):
            _, kind, port = key.split()
            svc = parse_service(kind, int(port), body)
            if svc:
                d["services"].append(svc)
    return d


PROM_LINE = re.compile(r'^([a-zA-Z_:][\w:]*)(\{[^}]*\})?\s+([-+0-9.eE]+|NaN|\+Inf)')
PROM_NAMES = {
    "prompt_tokens_total": "prompt", "generation_tokens_total": "generation",
    "tokens_predicted_total": "generation", "num_requests_running": "running",
    "num_running_reqs": "running", "requests_processing": "running",
}


def parse_prom(text):
    """Prometheus 文字格式 -> {(短名, 模型): 值}，同名不同 label 的加總。"""
    out = {}
    for ln in (text or "").splitlines():
        m = PROM_LINE.match(ln.strip())
        if not m:
            continue
        name = m.group(1).split(":", 1)[-1]
        short = PROM_NAMES.get(name)
        if not short:
            continue
        model = ""
        lm = re.search(r'model_name="([^"]*)"', m.group(2) or "")
        if lm:
            model = lm.group(1)
        v = num(m.group(3))
        if v is None:
            continue
        out[(short, model)] = out.get((short, model), 0.0) + v
    return out


def parse_service(kind, port, body):
    """推論服務的回應 -> {kind, port, models: [{name, vram_mb}], counters: {model: {prompt, generation}},
    running}。沒有回應（服務沒開）回傳 None。"""
    body = (body or "").strip()
    if not body:
        return None
    svc = {"kind": kind, "port": port, "models": [], "counters": {}, "running": None}
    if kind in ("ollama", "lmstudio", "openai"):
        try:
            d = json.loads(body)
        except ValueError:
            return None
        if not isinstance(d, dict):
            return None
        if kind == "ollama":
            for mo in d.get("models") or []:
                if isinstance(mo, dict):
                    svc["models"].append({"name": str(mo.get("name") or mo.get("model") or "?"),
                                          "vram_mb": round(_int(mo.get("size_vram")) / 1048576),
                                          "expires_at": iso_ts(mo.get("expires_at"))})
        else:
            for mo in d.get("data") or []:
                if not isinstance(mo, dict):
                    continue
                if kind == "lmstudio" and mo.get("state") != "loaded":
                    continue
                svc["models"].append({"name": str(mo.get("id") or "?"), "vram_mb": None})
        return svc
    vals = parse_prom(body)
    if not vals:
        return None
    for (short, model), v in vals.items():
        if short == "running":
            svc["running"] = (svc["running"] or 0) + v
        else:
            svc["counters"].setdefault(model or kind, {})[short] = v
    svc["models"] = [{"name": n, "vram_mb": None} for n in sorted(svc["counters"])]
    return svc


def _float(v, default=None):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def machines(cp=None):
    """設定檔裡要監看的機器。"""
    cp = cp or load_config()
    out = []
    if not cp.has_section("machines"):
        return out
    for name, host in cp.items("machines"):
        sec = "machine." + name
        get = lambda k, d=None: cp.get(sec, k, fallback=d) if cp.has_section(sec) else d
        out.append({"name": name, "host": host.strip() or "local",
                    "services": service_list(get("services", DEFAULT_SERVICES)),
                    "base_watts": _float(get("base_watts"), 0.0),
                    "idle_watts": _float(get("idle_watts")),
                    "max_watts": _float(get("max_watts"))})
    return out


def parse_hours(spec):
    """`6-11, 14-24` -> [(6, 11), (14, 24)]。"""
    out = []
    for part in (spec or "").split(","):
        m = re.match(r"^\s*(\d{1,2})(?::00)?\s*-\s*(\d{1,2})(?::00)?\s*$", part)
        if m and 0 <= int(m.group(1)) < int(m.group(2)) <= 24:
            out.append((int(m.group(1)), int(m.group(2))))
    return out


def power_settings(cp=None):
    cp = cp or load_config()
    g = lambda k, d="": cp.get("power", k, fallback=d)
    tou = None
    if g("tariff", "flat").strip().lower() == "tou":
        tou = {"offset": _float(g("tou_utc_offset", "0"), 0.0),
               "summer": {_int(x) for x in g("tou_summer_months").split(",") if x.strip()},
               "summer_hours": parse_hours(g("tou_summer_peak_hours")),
               "summer_peak": _float(g("tou_summer_peak"), 0.0),
               "summer_off": _float(g("tou_summer_offpeak"), 0.0),
               "other_hours": parse_hours(g("tou_other_peak_hours")),
               "other_peak": _float(g("tou_other_peak"), 0.0),
               "other_off": _float(g("tou_other_offpeak"), 0.0),
               "weekend_off": g("tou_weekend_offpeak", "yes").strip().lower() in ("yes", "true", "1", "on")}
    return {"tou": tou,
            "price_per_kwh": _float(cp.get("power", "price_per_kwh", fallback="0"), 0.0),
            "currency": cp.get("power", "currency", fallback="USD").strip().upper() or "USD",
            "idle_alert_minutes": _float(cp.get("power", "idle_alert_minutes", fallback="15"), 15.0),
            "usd_to_local": _float(cp.get("general", "usd_to_local", fallback="0"), 0.0)}


def estimate_power(m, gpu_power, util, cpu):
    """整台機器的功耗（W）。讀得到 GPU 功耗就用「GPU + 其他部分」，
    讀不到（Mac、Jetson）就用設定的閒置／滿載功耗按負載內插；都沒設定回傳 None。"""
    if gpu_power is not None:
        return gpu_power + (m.get("base_watts") or 0.0)
    lo, hi = m.get("idle_watts"), m.get("max_watts")
    if hi is None:
        return lo
    lo = lo or 0.0
    load = max(util or 0.0, cpu or 0.0) / 100.0
    return lo + (hi - lo) * max(0.0, min(1.0, load))


AI_GPU_UTIL = 20.0   # 有模型載入、GPU 使用率超過這個值，就算在做推論
MAX_GAP = 600        # 兩次取樣隔超過 10 分鐘，中間的耗電當作不知道，不積分


def previous_sample(db, machine):
    return db.execute("SELECT * FROM samples WHERE machine = ? ORDER BY ts DESC LIMIT 1",
                      (machine,)).fetchone()


def record_sample(db, m, d, ts):
    """把一次取樣寫進帳本；推論服務的 token 計數器變多的部分記成 local 用量。回傳新增的用量列。"""
    prev = previous_sample(db, m["name"])
    prev_cpu = None
    if prev and prev["cpu_raw"]:
        try:
            prev_cpu = tuple(json.loads(prev["cpu_raw"]))
        except ValueError:
            prev_cpu = None
    cpu = d.get("cpu")
    pct = cpu_pct(cpu, prev_cpu)
    gpus = d.get("gpus") or []
    utils = [g["util"] for g in gpus if g["util"] is not None]
    powers = [g["power"] for g in gpus if g["power"] is not None]
    util = sum(utils) / len(utils) if utils else None
    gpu_power = sum(powers) if powers else None
    mem_used = sum(g["mem_used"] or 0 for g in gpus) if gpus else None
    mem_total = sum(g["mem_total"] or 0 for g in gpus) if gpus else None
    loaded, counters, running = [], {}, 0.0
    for svc in d.get("services") or []:
        for mo in svc["models"]:
            loaded.append({"service": svc["kind"], "port": svc["port"], "name": mo["name"],
                           "vram_mb": mo.get("vram_mb"), "expires_at": mo.get("expires_at")})
        for model, c in svc["counters"].items():
            counters["%s:%d:%s" % (svc["kind"], svc["port"], model)] = c
        running += svc["running"] or 0.0
    rows = []
    prev_counters = json.loads(prev["counters"]) if prev else {}
    for key, c in counters.items():
        p = prev_counters.get(key)
        if p is None:
            continue  # 第一次看到這個計數器，還沒有差值
        dp = c.get("prompt", 0) - p.get("prompt", 0)
        dg = c.get("generation", 0) - p.get("generation", 0)
        if dp < 0 or dg < 0:  # 服務重開，計數器歸零
            dp, dg = c.get("prompt", 0), c.get("generation", 0)
        if dp or dg:
            kind, _port, model = key.split(":", 2)
            rows.append({"source": "local", "uid": "%s:%s:%d" % (m["name"], key, ts), "ts": int(ts),
                         "model": model, "project": m["name"], "session": kind,
                         "input": int(dp), "output": int(dg), "cost_usd": 0.0})
    proxied = 0
    if prev:
        proxied = db.execute("SELECT COUNT(*) FROM usage WHERE source = 'local' AND project = ? "
                             "AND ts > ? AND ts <= ?", (m["name"], prev["ts"], ts)).fetchone()[0]
    # Ollama 每處理完一個請求就把 expires_at 往後推（= 最後使用時間 + keep_alive），
    # 所以 expires_at 變了就表示這段時間有人在用，不需要 proxy 也看得出來。
    prev_loaded = json.loads(prev["loaded"]) if prev else []
    prev_exp = {(x.get("service"), x.get("port"), x.get("name")): x.get("expires_at") for x in prev_loaded}
    touched = any(x.get("expires_at") and prev_exp.get((x["service"], x["port"], x["name"]))
                  and x["expires_at"] > prev_exp[(x["service"], x["port"], x["name"])] + 1
                  for x in loaded)
    # 沒有更好的訊號時才看 GPU 使用率；Mac 的 GPU 使用率包含畫面繪製，不能拿來判斷
    busy_gpu = any(g["vendor"] != "apple" and (g["util"] or 0) >= AI_GPU_UTIL for g in gpus)
    active = bool(rows or running or proxied or touched or (loaded and busy_gpu))
    power = estimate_power(m, gpu_power, util, pct)
    # 畫面要用的細節：每張 GPU、整台記憶體、負載、每個服務
    detail = {"gpus": gpus, "mem_used": d.get("mem_used"), "mem_total": d.get("mem_total"),
              "load": d.get("load"), "ncpu": d.get("ncpu"),
              "services": [{"kind": x["kind"], "port": x["port"], "running": x["running"],
                            "models": [mo["name"] for mo in x["models"]]} for x in d.get("services") or []]}
    db.execute("INSERT OR REPLACE INTO samples (machine, ts, cpu_raw, cpu_pct, gpu_util, gpu_mem_used, "
               "gpu_mem_total, gpu_power_w, power_w, ai_active, loaded, counters, detail) "
               "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
               (m["name"], int(ts), json.dumps(cpu) if cpu and cpu[0] == "raw" else None, pct, util,
                mem_used, mem_total, gpu_power, power, int(active), json.dumps(loaded),
                json.dumps(counters), json.dumps(detail)))
    add_usage(db, rows)
    return rows


def sample_machines(db, only=None, timeout=25):
    """所有機器同時取樣（一台卡住不會拖慢其他台），寫進帳本。回傳 {名稱: 取樣或 None}。"""
    ms = [m for m in machines() if not only or m["name"] in only]
    results = {}

    def work(m):
        try:
            results[m["name"]] = snapshot(m["host"], m["services"])
        except Exception:
            results[m["name"]] = None
    threads = [threading.Thread(target=work, args=(m,), daemon=True) for m in ms]
    for t in threads:
        t.start()
    deadline = time.time() + timeout
    for t in threads:
        t.join(max(0.0, deadline - time.time()))
    ts = int(now())
    for m in ms:
        d = results.get(m["name"])
        if d:
            record_sample(db, m, d, ts)
            machine_errors.pop(m["name"], None)
        else:
            why = ssh_errors.get(m["host"]) or "no data"
            hint = ssh_hint(why)
            machine_errors[m["name"]] = "%s (%s): cannot read: %s%s" % (
                m["name"], m["host"], why, ("; " + hint) if hint else "")
    db.commit()
    return {m["name"]: results.get(m["name"]) for m in ms}


machine_errors = {}


def machine_alerts():
    return [{"kind": "machine_unreachable", "machine": k, "message": v}
            for k, v in sorted(machine_errors.items())]


def price_at(ts, ps):
    """這個時間點每度電的價格，和是不是尖峰。flat 電價永遠不是尖峰。"""
    tou = ps.get("tou")
    if not tou:
        return ps["price_per_kwh"], False
    t = time.gmtime(ts + tou["offset"] * 3600)
    summer = t.tm_mon in tou["summer"]
    hours = tou["summer_hours"] if summer else tou["other_hours"]
    peak = not (tou["weekend_off"] and t.tm_wday >= 5) and any(a <= t.tm_hour < b for a, b in hours)
    if summer:
        return (tou["summer_peak"] if peak else tou["summer_off"]), peak
    return (tou["other_peak"] if peak else tou["other_off"]), peak


def offpeak_price(ts, ps):
    tou = ps["tou"]
    summer = time.gmtime(ts + tou["offset"] * 3600).tm_mon in tou["summer"]
    return tou["summer_off"] if summer else tou["other_off"]


def to_usd(amount, ps):
    """當地貨幣換成美元；沒有匯率回傳 None。"""
    if amount is None:
        return None
    if ps["currency"] == "USD":
        return amount
    return amount / ps["usd_to_local"] if ps["usd_to_local"] else None


def machine_report(db, start, end, ps=None):
    """每台機器在範圍內的耗電、AI 佔比、電費和 J/token。耗電由相鄰兩次取樣的平均功耗乘上
    間隔積分；間隔超過 MAX_GAP 的那段當作不知道（covered_hours 會比範圍短）。"""
    ps = ps or power_settings()
    out = []
    names = [r[0] for r in db.execute("SELECT DISTINCT machine FROM samples WHERE ts >= ? AND ts < ?",
                                      (start, end))]
    for name in sorted(names):
        rows = db.execute("SELECT ts, power_w, ai_active, gpu_util FROM samples WHERE machine = ? "
                          "AND ts >= ? AND ts < ? ORDER BY ts", (name, start - MAX_GAP, end)).fetchall()
        energy = ai_energy = covered = ai_secs = 0.0
        unknown_power = cost = ai_peak_j = peak_saving = 0.0
        for a, b in zip(rows, rows[1:]):
            if b["ts"] < start:
                continue
            dt = b["ts"] - max(a["ts"], start)
            if dt <= 0 or b["ts"] - a["ts"] > MAX_GAP:
                continue
            covered += dt
            ai = a["ai_active"] or b["ai_active"]
            if ai:
                ai_secs += dt
            ps_ = [p for p in (a["power_w"], b["power_w"]) if p is not None]
            if not ps_:
                unknown_power += dt
                continue
            j = sum(ps_) / len(ps_) * dt
            energy += j
            price, peak = price_at(b["ts"] - dt / 2.0, ps)
            cost += j / 3.6e6 * price
            if ai:
                ai_energy += j
                if peak and ps.get("tou"):  # 這段推論如果挪到離峰可以省多少
                    ai_peak_j += j
                    peak_saving += j / 3.6e6 * (price - offpeak_price(b["ts"] - dt / 2.0, ps))
        tok = db.execute("SELECT COALESCE(SUM(input), 0) AS i, COALESCE(SUM(output), 0) AS o, "
                         "COUNT(*) AS n FROM usage WHERE source = 'local' AND project = ? "
                         "AND ts >= ? AND ts < ?", (name, start, end)).fetchone()
        kwh = energy / 3.6e6
        ai_cost = cost * (ai_energy / energy) if energy else 0.0
        last = db.execute("SELECT loaded FROM samples WHERE machine = ? ORDER BY ts DESC LIMIT 1",
                          (name,)).fetchone()
        out.append({
            "machine": name, "samples": sum(1 for r in rows if r["ts"] >= start),
            "loaded": [{k: x.get(k) for k in ("service", "port", "name", "vram_mb")}
                       for x in json.loads(last["loaded"] or "[]")] if last else [], "covered_hours": round(covered / 3600, 2),
            "power_unknown_hours": round(unknown_power / 3600, 2),
            "kwh": round(kwh, 4), "ai_kwh": round(ai_energy / 3.6e6, 4),
            "ai_share": round(ai_secs / covered, 3) if covered else None,
            "energy_cost": round(cost, 4), "currency": ps["currency"],
            "energy_cost_usd": None if to_usd(cost, ps) is None else round(to_usd(cost, ps), 4),
            "input_tokens": tok["i"], "output_tokens": tok["o"], "requests": tok["n"],
            "j_per_token": round(ai_energy / tok["o"], 3) if tok["o"] and ai_energy else None,
            "ai_peak_kwh": round(ai_peak_j / 3.6e6, 4),
            "usd_per_mtok": (round(to_usd(ai_cost, ps) / tok["o"] * 1e6, 4)
                             if tok["o"] and ai_energy and to_usd(ai_cost, ps) is not None else None),
            "offpeak_saving": round(peak_saving, 4),
        })
    return out


def idle_alerts(db, t=None, minutes=None):
    """模型載入在記憶體裡、卻有一段時間沒在用：佔著 GPU（或 Mac 的統一記憶體）不放。"""
    t = now() if t is None else t
    if minutes is None:
        minutes = power_settings()["idle_alert_minutes"]
    out = []
    for (name,) in db.execute("SELECT DISTINCT machine FROM samples").fetchall():
        rows = db.execute("SELECT ts, ai_active, loaded FROM samples WHERE machine = ? "
                          "ORDER BY ts DESC LIMIT 500", (name,)).fetchall()
        if not rows or t - rows[0]["ts"] > MAX_GAP:  # 最近沒有取樣，不知道現在的狀況
            continue
        latest = json.loads(rows[0]["loaded"] or "[]")
        if not latest or rows[0]["ai_active"]:
            continue
        since, later = rows[0]["ts"], rows[0]["ts"]
        for r in rows[1:]:
            if r["ai_active"] or not json.loads(r["loaded"] or "[]") or later - r["ts"] > MAX_GAP:
                break
            since = later = r["ts"]
        idle = t - since
        if idle >= minutes * 60:
            vram = sum(m.get("vram_mb") or 0 for m in latest)
            out.append({"kind": "idle_model", "machine": name, "idle_minutes": int(idle // 60),
                        "models": sorted({m["name"] for m in latest}), "vram_mb": vram or None,
                        "message": "%s: %s loaded but idle for %s%s" % (
                            name, ", ".join(sorted({m["name"] for m in latest})), fmt_dur(idle),
                            (" (holding %s MB)" % format(vram, ",")) if vram else "")})
    return out


def render_machines(report, alerts=None):
    lines = ["%-16s %7s %8s %8s %9s %9s %10s" % ("Machines", "hours", "kWh", "AI share", "power $",
                                                  "tokens", "J/token")]
    for r in report:
        cost = r["energy_cost"]
        cost_s = ("$%.2f" % r["energy_cost_usd"]) if r["energy_cost_usd"] is not None else \
            "%.1f %s" % (cost, r["currency"])
        lines.append("%s %7.1f %8.3f %8s %9s %9s %10s" % (
            cell(r["machine"], 16), r["covered_hours"], r["kwh"],
            "-" if r["ai_share"] is None else "%d%%" % round(100 * r["ai_share"]), cost_s,
            fmt_tok(r["input_tokens"] + r["output_tokens"]),
            "-" if r["j_per_token"] is None else "%.2f" % r["j_per_token"]))
        for x in r.get("loaded") or []:
            lines.append("  loaded: %s (%s:%s%s)" % (x["name"], x["service"], x["port"],
                                                     ", %s MB" % format(x["vram_mb"], ",") if x["vram_mb"] else ""))
        if r.get("offpeak_saving"):
            lines.append("  %.2f kWh of AI work ran at peak price; off-peak would save %.2f %s"
                         % (r["ai_peak_kwh"], r["offpeak_saving"], r["currency"]))
        if r["power_unknown_hours"] and not r["kwh"]:
            lines.append("  power unknown: set idle_watts/max_watts in [machine.%s]" % r["machine"])
    for a in alerts or []:
        lines.append("! " + a["message"])
    return "\n".join(lines)


# ---------------------------------------------------------------- token 計數 proxy
#
# Ollama 沒有 /metrics，token 數只出現在每次回應裡，所以要統計就得讓流量經過這裡。
# 只讀回應裡的用量欄位（prompt_eval_count、eval_count、usage），請求和回應的內容
# 原樣轉送，不記錄、不保存。這是 ComputAI 唯一可以常駐的部分。

HOP_HEADERS = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te",
               "trailers", "transfer-encoding", "upgrade", "content-length", "host"}


class UsageMeter:
    """邊轉送邊看回應：NDJSON（Ollama 串流）、SSE（OpenAI 串流）逐行看，一般 JSON 等收完再看。
    只解析含有用量欄位的那幾行；其他行（裡面是生成的內容）直接略過。"""

    MAX_BODY = 64 << 20

    def __init__(self, content_type):
        ct = (content_type or "").lower()
        self.mode = "lines" if ("ndjson" in ct or "event-stream" in ct) else \
            "json" if "json" in ct else None
        self.buf = b""
        self.too_big = False
        self.prompt = self.completion = self.cached = 0
        self.model = None
        self.found = False

    def feed(self, chunk):
        if not self.mode or self.too_big:
            return
        self.buf += chunk
        if self.mode == "json":
            if len(self.buf) > self.MAX_BODY:
                self.too_big, self.buf = True, b""
            return
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            self._line(line)
        if len(self.buf) > self.MAX_BODY:
            self.buf = b""

    def _line(self, line):
        if b"eval_count" not in line and b'"usage"' not in line:
            return
        line = line.strip()
        if line.startswith(b"data:"):
            line = line[5:].strip()
        self._take(line)

    def _take(self, raw):
        try:
            d = json.loads(raw.decode("utf-8", "replace"))
        except ValueError:
            return
        if not isinstance(d, dict):
            return
        if isinstance(d.get("response"), dict) and isinstance(d["response"].get("usage"), dict):
            d = d["response"]  # Responses API 的 response.completed 事件
        if isinstance(d.get("model"), str):
            self.model = d["model"]
        if "eval_count" in d or "prompt_eval_count" in d:   # Ollama 原生 API
            if d.get("done") is False:
                return
            self.prompt, self.completion = _int(d.get("prompt_eval_count")), _int(d.get("eval_count"))
            self.found = True
            return
        u = d.get("usage")
        if isinstance(u, dict):                             # OpenAI 相容 API
            self.prompt = _int(u.get("prompt_tokens", u.get("input_tokens")))
            self.completion = _int(u.get("completion_tokens", u.get("output_tokens")))
            det = u.get("prompt_tokens_details") or u.get("input_tokens_details") or {}
            self.cached = _int(det.get("cached_tokens")) if isinstance(det, dict) else 0
            self.found = True

    def finish(self):
        if self.mode == "json" and not self.too_big and self.buf:
            self._take(self.buf)
        elif self.mode == "lines" and self.buf:
            self._line(self.buf)
        self.buf = b""
        return self.found


def prepare_request(body, path, inject=True):
    """從請求裡只拿模型名稱。OpenAI 相容的串流請求如果沒有要求用量，替它加上
    stream_options.include_usage，不然串流回應裡根本沒有 token 數。回傳 (body, model)。"""
    try:
        d = json.loads(body.decode("utf-8")) if body else None
    except (ValueError, UnicodeDecodeError):
        return body, None
    if not isinstance(d, dict):
        return body, None
    model = d.get("model") if isinstance(d.get("model"), str) else None
    if inject and d.get("stream") is True and path.split("?")[0].rstrip("/").endswith(
            ("/chat/completions", "/v1/completions")):
        so = d.get("stream_options")
        if not isinstance(so, dict) or not so.get("include_usage"):
            d["stream_options"] = dict(so or {}, include_usage=True)
            body = json.dumps(d).encode("utf-8")
    return body, model


def make_proxy(upstream, machine, db_path=None, inject=True, bind="127.0.0.1"):
    import http.client
    import http.server
    import urllib.parse
    up = urllib.parse.urlsplit(upstream if "://" in upstream else "http://" + upstream)
    if up.scheme not in ("http", "https") or not up.hostname:
        raise SystemExit("computai: bad --upstream %r" % upstream)
    up_port = up.port or (443 if up.scheme == "https" else 80)
    lock = threading.Lock()
    db_holder = {"db": open_ledger(db_path, shared=True)}

    def record(model, meter):
        row = {"source": "local", "uid": "proxy:%s:%d:%s" % (machine, time.time() * 1e6, os.urandom(4).hex()),
               "ts": int(now()), "model": normalize_model(model or "?"), "project": machine,
               "session": "proxy", "input": max(meter.prompt - meter.cached, 0),
               "cache_read": meter.cached, "output": meter.completion, "cost_usd": 0.0}
        with lock:
            add_usage(db_holder["db"], [row])
            db_holder["db"].commit()

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "computai-proxy"

        def log_message(self, fmt, *a):  # 不記錄請求
            pass

        def _body(self):
            if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
                parts = []
                while True:
                    size = int(self.rfile.readline().split(b";")[0].strip() or b"0", 16)
                    if size == 0:
                        while self.rfile.readline() not in (b"\r\n", b"\n", b""):
                            pass
                        break
                    parts.append(self.rfile.read(size))
                    self.rfile.readline()
                return b"".join(parts)
            n = _int(self.headers.get("Content-Length"))
            return self.rfile.read(n) if n > 0 else b""

        def _forward(self):
            if not host_header_ok(self.headers.get("Host"), bind):
                # 直接轉給 Ollama 的話，Ollama 自己會擋；我們改寫了 Host，所以要替它擋
                self.send_error(403, "forbidden host")
                return
            try:
                body = self._body()
            except (ValueError, OSError):
                self.send_error(400)
                return
            body, model = prepare_request(body, self.path, inject)
            headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP_HEADERS}
            headers["Host"] = up.netloc
            headers["Accept-Encoding"] = "identity"  # 壓縮過的回應讀不到用量
            if body or self.command in ("POST", "PUT", "PATCH"):
                headers["Content-Length"] = str(len(body))
            cls = http.client.HTTPSConnection if up.scheme == "https" else http.client.HTTPConnection
            conn = cls(up.hostname, up_port, timeout=900)
            try:
                conn.request(self.command, self.path, body=body or None, headers=headers)
                resp = conn.getresponse()
            except (OSError, http.client.HTTPException) as e:
                msg = json.dumps({"error": "computai proxy: upstream unreachable (%s)" % type(e).__name__})
                self.send_response(502)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(msg)))
                self.end_headers()
                self.wfile.write(msg.encode())
                conn.close()
                return
            meter = UsageMeter(resp.getheader("Content-Type"))
            self.send_response(resp.status, resp.reason)
            for k, v in resp.getheaders():
                if k.lower() not in HOP_HEADERS:
                    self.send_header(k, v)
            length = resp.getheader("Content-Length")
            no_body = self.command == "HEAD" or resp.status in (204, 304) or 100 <= resp.status < 200
            chunked = not no_body and length is None
            if length is not None:
                self.send_header("Content-Length", length)
            elif chunked:
                self.send_header("Transfer-Encoding", "chunked")
            else:
                self.send_header("Content-Length", "0")
            self.end_headers()
            try:
                while not no_body:
                    data = resp.read1(65536) if hasattr(resp, "read1") else resp.read(65536)
                    if not data:
                        break
                    meter.feed(data)
                    if chunked:
                        self.wfile.write(b"%x\r\n%s\r\n" % (len(data), data))
                    else:
                        self.wfile.write(data)
                    self.wfile.flush()
                if chunked:
                    self.wfile.write(b"0\r\n\r\n")
                    self.wfile.flush()
            except OSError:
                self.close_connection = True
            finally:
                conn.close()
            if 200 <= resp.status < 300 and meter.finish():
                record(meter.model or model, meter)

        do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = _forward

    return Handler, db_holder


def parse_listen(s, default_port):
    """`8080`、`:8080`、`127.0.0.1:8080`、`[::1]:8080` -> (host, port)。沒寫 host 就是 127.0.0.1。"""
    s = (s or "").strip()
    host, port = "127.0.0.1", default_port
    if s.startswith("["):
        h, _, rest = s[1:].partition("]")
        host = h or host
        if rest.startswith(":") and rest[1:].isdigit():
            port = int(rest[1:])
    elif s.isdigit():
        port = int(s)
    elif ":" in s:
        h, p = s.rsplit(":", 1)
        host = h or host
        if p.isdigit():
            port = int(p)
    elif s:
        host = s
    return host, port


def is_loopback(host):
    return host in ("localhost", "::1") or host.startswith("127.")


def host_header_ok(header, bind):
    """只聽本機時，Host 標頭也必須是本機的名字；擋掉 DNS rebinding（別的網站把自己的網域
    指到 127.0.0.1，瀏覽器就會把它當成同一個來源）。寫法移植自 slurmtop 84cd35d。"""
    if not is_loopback(bind):
        return True
    host = (header or "").strip()
    if host.startswith("["):
        name = host[1:].split("]", 1)[0]
    else:
        name = host.rsplit(":", 1)[0] if host.count(":") == 1 else host
    return is_loopback(name)


def serve_proxy(listen, upstream, machine, sample_every=60, inject=True):
    import http.server
    host, port = parse_listen(listen, 11435)
    if not is_loopback(host):
        warn("listening on %s: anyone who can reach this port can use your models through it" % host)
    Handler, holder = make_proxy(upstream, machine, inject=inject, bind=host)

    class Server(http.server.ThreadingHTTPServer):
        daemon_threads = True
        address_family = socket.AF_INET6 if ":" in host else socket.AF_INET

    srv = Server((host, port), Handler)
    print("computai proxy: http://%s:%d -> %s  (machine %s)" % (host, port, upstream, machine), flush=True)
    stop = threading.Event()
    if sample_every and sample_every > 0 and machines():
        def sampler():
            db = open_ledger()
            try:
                while True:
                    try:
                        sample_machines(db)
                    except Exception as e:
                        warn("sampling failed: %s" % e)
                    if stop.wait(sample_every):
                        break
            finally:
                db.close()
        threading.Thread(target=sampler, daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        srv.server_close()
        holder["db"].close()
    return 0


# ---------------------------------------------------------------- 雲端 GPU
#
# 只呼叫唯讀的 API（列出自己的機器），不會開機、關機或改任何設定。
# 金鑰從環境變數或權限 600 的 secrets.ini 讀（RUNPOD_API_KEY、VAST_API_KEY、LAMBDA_API_KEY），
# 錯誤訊息只寫平台和 HTTP 狀態碼，不會帶出金鑰或完整網址。

class ApiError(Exception):
    pass


def api_json(provider, name, url, key, body=None, headers=None):
    """呼叫一個 API 回傳 JSON。測試用 COMPUTAI_FIXTURES/http/<provider>-<name>.json 代替
    （分頁的第 n 頁是 <provider>-<name>-<n>.json）。"""
    fx = os.environ.get("COMPUTAI_FIXTURES")
    if fx:
        path = os.path.join(fx, "http", "%s-%s.json" % (provider, name))
        if not os.path.exists(path):
            raise ApiError("%s: no fixture %s" % (provider, name))
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    import urllib.error
    import urllib.request
    headers = dict(headers or {"Authorization": "Bearer " + key}, Accept="application/json")
    headers["User-Agent"] = "computai/" + __version__
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read(16 << 20).decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        raise ApiError("%s: HTTP %d from the %s API" % (provider, e.code, name))
    except (OSError, ValueError) as e:
        raise ApiError("%s: %s API unreachable (%s)" % (provider, name, type(e).__name__))


def _inst(provider, iid, name, status, billing, gpu, count, usd_hr, util=None, ip=None, started=None):
    return {"provider": provider, "id": str(iid), "name": name or str(iid), "status": status,
            "billing": bool(billing), "gpu": gpu or "?", "gpu_count": _int(count) or 0,
            "usd_per_hour": _float(usd_hr), "gpu_util": _float(util), "ip": ip, "started_at": started}


def fetch_runpod(key):
    """REST 拿狀態和價格，GraphQL 拿 GPU 使用率（REST 沒有），用 pod id 對起來。"""
    pods = api_json("runpod", "pods", "https://rest.runpod.io/v1/pods", key)
    if isinstance(pods, dict):
        pods = pods.get("data") or pods.get("pods") or []
    util = {}
    try:
        g = api_json("runpod", "graphql", "https://api.runpod.io/graphql", key, {
            "query": "query { myself { pods { id runtime { gpus { id gpuUtilPercent } } } } }"})
        for p in (((g or {}).get("data") or {}).get("myself") or {}).get("pods") or []:
            gpus = ((p.get("runtime") or {}).get("gpus")) or []
            vals = [_float(x.get("gpuUtilPercent")) for x in gpus if _float(x.get("gpuUtilPercent")) is not None]
            if vals:
                util[p.get("id")] = sum(vals) / len(vals)
    except ApiError as e:
        warn(str(e))
    out = []
    for p in pods if isinstance(pods, list) else []:
        st = (p.get("desiredStatus") or "").upper()
        gpu = p.get("gpu") or {}
        name = gpu.get("displayName") or ((p.get("machine") or {}).get("gpuType") or {}).get("displayName")
        rate = p.get("adjustedCostPerHr", p.get("costPerHr"))
        # RUNNING 才是 GPU 在計費；EXITED 只收磁碟費（很少），TERMINATED 已經不收
        out.append(_inst("runpod", p.get("id"), p.get("name"), st.lower(), st == "RUNNING",
                         name, gpu.get("count") or p.get("gpuCount"), rate if st == "RUNNING" else 0,
                         util.get(p.get("id")), p.get("publicIp"), iso_ts(p.get("lastStartedAt"))))
    return out


def fetch_vast(key):
    rows, token = [], None
    for _ in range(20):  # 每頁最多 25 台
        url = "https://console.vast.ai/api/v1/instances/?limit=25"
        if token:
            import urllib.parse
            url += "&after_token=" + urllib.parse.quote(str(token))
        d = api_json("vast", "instances", url, key)
        rows += d.get("instances") or []
        token = d.get("next_token")
        if not token:
            break
    out = []
    for i in rows:
        st = (i.get("actual_status") or i.get("cur_state") or "").lower()
        running = st == "running"
        # 停止的機器還是會收儲存費（storage_cost），但 GPU 的 dph 不收
        rate = i.get("dph_total") if running else (i.get("storage_cost") or 0)
        out.append(_inst("vast", i.get("id"), i.get("label") or str(i.get("id")), st or "?", running,
                         i.get("gpu_name"), i.get("num_gpus"), rate, i.get("gpu_util"),
                         i.get("public_ipaddr"), _float(i.get("start_date"))))
    return out


def fetch_lambda(key):
    d = api_json("lambda", "instances", "https://cloud.lambda.ai/api/v1/instances", key)
    out = []
    for i in d.get("data") or []:
        st = (i.get("status") or "").lower()
        t = i.get("instance_type") or {}
        cents = _float(t.get("price_cents_per_hour"))
        billing = st in ("booting", "active", "unhealthy")
        gpus = (t.get("specs") or {}).get("gpus")
        out.append(_inst("lambda", i.get("id"), i.get("name") or t.get("name"), st, billing,
                         t.get("gpu_description") or t.get("name"), gpus,
                         cents / 100.0 if cents is not None and billing else 0, None, i.get("ip")))
    return out


CLOUDS = (("runpod", "RUNPOD_API_KEY", fetch_runpod), ("vast", "VAST_API_KEY", fetch_vast),
          ("lambda", "LAMBDA_API_KEY", fetch_lambda))


def cloud_settings(cp=None):
    cp = cp or load_config()
    return {"idle_util": _float(cp.get("cloud", "idle_gpu_util", fallback="5"), 5.0),
            "idle_minutes": _float(cp.get("cloud", "idle_alert_minutes", fallback="20"), 20.0),
            "ssh_user": cp.get("cloud", "ssh_user", fallback="").strip(),
            "max_gap_hours": _float(cp.get("cloud", "max_gap_hours", fallback="6"), 6.0)}


def ssh_gpu_util(inst, user):
    """API 沒給 GPU 使用率（Lambda）時，用 SSH 到機器上跑 nvidia-smi 讀。"""
    if not inst.get("ip") or not user or not re.match(r"^[\w.-]+$", user + inst["ip"]):
        return None
    d = snapshot("%s@%s" % (user, inst["ip"]), [])
    utils = [g["util"] for g in (d or {}).get("gpus", []) if g["util"] is not None]
    return sum(utils) / len(utils) if utils else None


def fetch_clouds(only=None):
    """有設定金鑰的平台都問一次。回傳 (機器清單, 錯誤訊息)。"""
    cs = cloud_settings()
    insts, errors = [], []
    for name, env, fn in CLOUDS:
        if only and name not in only:
            continue
        key = secret(env)
        if not key and not os.environ.get("COMPUTAI_FIXTURES"):
            continue
        try:
            got = fn(key or "")
        except ApiError as e:
            errors.append(str(e))
            continue
        for i in got:
            if i["billing"] and i["gpu_util"] is None and cs["ssh_user"]:
                i["gpu_util"] = ssh_gpu_util(i, cs["ssh_user"])
        insts += got
    return insts, errors


def record_cloud(db, insts, ts):
    """存一次快照，並把上一次快照到現在的計費時間記成 cloud 用量（金額照每小時價格算）。"""
    cs = cloud_settings()
    rows = []
    for i in insts:
        prev = db.execute("SELECT * FROM cloud WHERE provider = ? AND id = ? ORDER BY ts DESC LIMIT 1",
                          (i["provider"], i["id"])).fetchone()
        db.execute("INSERT OR REPLACE INTO cloud (provider, id, ts, name, status, billing, gpu, gpu_count, "
                   "usd_per_hour, gpu_util) VALUES (?,?,?,?,?,?,?,?,?,?)",
                   (i["provider"], i["id"], int(ts), i["name"], i["status"], int(i["billing"]), i["gpu"],
                    i["gpu_count"], i["usd_per_hour"], i["gpu_util"]))
        # 停機的機器可能還在收儲存費，所以看費率，不看 billing（billing 是「GPU 在計費」）
        if not prev or not prev["usd_per_hour"]:
            continue
        dt = ts - prev["ts"]
        if dt <= 0 or dt > cs["max_gap_hours"] * 3600:
            continue  # 隔太久沒看，中間發生什麼不知道，不亂算
        hours = dt / 3600.0
        rows.append({"source": "cloud", "uid": "%s:%s:%d" % (i["provider"], i["id"], ts), "ts": int(ts),
                     "model": "%s x%d" % (prev["gpu"], prev["gpu_count"] or 1),
                     "project": "%s/%s" % (i["provider"], prev["name"]), "session": i["id"],
                     "requests": 0, "cost_usd": round(prev["usd_per_hour"] * hours, 6),
                     "input": 0, "output": 0})
    add_usage(db, rows)
    db.commit()
    return rows


def cloud_alerts(db, t=None):
    """最重要的警示：機器還在計費，GPU 卻閒著。只在讀得到使用率時判斷。"""
    t = now() if t is None else t
    cs = cloud_settings()
    out = []
    latest = db.execute("SELECT c.* FROM cloud c JOIN (SELECT provider, id, MAX(ts) AS ts FROM cloud "
                        "GROUP BY provider, id) x ON c.provider = x.provider AND c.id = x.id "
                        "AND c.ts = x.ts").fetchall()
    for r in latest:
        if not r["billing"] or t - r["ts"] > 3600:
            continue
        if r["gpu_util"] is None:
            out.append({"kind": "cloud_unknown_util", "provider": r["provider"], "id": r["id"],
                        "message": "%s %s is billing %s/h; GPU use unknown (set [cloud] ssh_user)"
                        % (r["provider"], r["name"], fmt_usd(r["usd_per_hour"]))})
            continue
        if r["gpu_util"] >= cs["idle_util"]:
            continue
        since = r["ts"]
        for p in db.execute("SELECT ts, billing, gpu_util FROM cloud WHERE provider = ? AND id = ? "
                            "AND ts < ? ORDER BY ts DESC LIMIT 500", (r["provider"], r["id"], r["ts"])):
            if not p["billing"] or p["gpu_util"] is None or p["gpu_util"] >= cs["idle_util"]:
                break
            since = p["ts"]
        idle = t - since
        if idle >= cs["idle_minutes"] * 60:
            wasted = (r["usd_per_hour"] or 0) * idle / 3600
            out.append({"kind": "cloud_idle_billing", "provider": r["provider"], "id": r["id"],
                        "idle_minutes": int(idle // 60), "usd_per_hour": r["usd_per_hour"],
                        "wasted_usd": round(wasted, 2),
                        "message": "%s %s: GPU idle for %s but still billing %s/h (%s so far)"
                        % (r["provider"], r["name"], fmt_dur(idle), fmt_usd(r["usd_per_hour"]),
                           fmt_usd(wasted))})
    return out


def latest_cloud(db):
    return [dict(r) for r in db.execute(
        "SELECT c.* FROM cloud c JOIN (SELECT provider, id, MAX(ts) AS ts FROM cloud GROUP BY provider, id) x "
        "ON c.provider = x.provider AND c.id = x.id AND c.ts = x.ts "
        "WHERE c.ts >= ? ORDER BY c.provider, c.name", (now() - 86400,))]


def render_cloud(insts, alerts=None, errors=None):
    lines = ["%-28s %-10s %-18s %9s %8s" % ("Cloud GPUs", "status", "GPU", "$/hour", "GPU use")]
    for i in insts:
        lines.append("%s %-10s %s %9s %8s" % (
            cell("%s/%s" % (i["provider"], i["name"]), 28), cell(i["status"], 10),
            cell("%s x%d" % (i["gpu"], i["gpu_count"] or 1), 18),
            fmt_usd(i["usd_per_hour"]) if i["billing"] else "-",
            "-" if i["gpu_util"] is None else "%d%%" % round(i["gpu_util"])))
    for e in errors or []:
        lines.append("  " + e)
    for a in alerts or []:
        lines.append("! " + a["message"])
    return "\n".join(lines)


def sample_clouds(db, only=None):
    insts, errors = fetch_clouds(only)
    record_cloud(db, insts, int(now()))
    for e in errors:
        warn(e)
    return insts, errors


