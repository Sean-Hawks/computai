GREY, CYAN, MAG, RED, AMBER, GREEN = (THEMES["cyber"][k] for k in ("grey", "cyan", "mag", "red", "amber", "green"))


def set_style(color=False, ascii_=False, theme=None):
    """顏色、ASCII、主題。主題沒給就沿用目前的。"""
    global _color, _ascii, _theme, GREY, CYAN, MAG, RED, AMBER, GREEN
    _color, _ascii = color, ascii_
    if theme in THEMES:
        _theme = theme
    t = THEMES[_theme]
    GREY, CYAN, MAG, RED, AMBER, GREEN = (t[k] for k in ("grey", "cyan", "mag", "red", "amber", "green"))


def theme():
    return THEMES[_theme]


def glyphs():
    """(sparkline 字元, 填滿, 空, 左端, 右端, 框線 TL TR BL BR H V)"""
    if _ascii:
        return SPARK_ASCII, "#", ".", "[", "]", ("+", "+", "+", "+", "-", "|")
    full, empty, lcap, rcap = theme()["bar"]
    return SPARK, full, empty, lcap, rcap, theme()["box"]


def sym(u, a):
    """ASCII 模式用 a，其他時候用 u。"""
    return a if _ascii else u


def rgb(c, s):
    return "\033[38;2;%d;%d;%dm%s\033[0m" % (c[0], c[1], c[2], s) if _color else s


def sgr(code, s):
    return "\033[%sm%s\033[0m" % (code, s) if _color else s


def bold(s):
    return sgr("1", s)


def dim(s):
    """次要資訊。cyber 用 meta 灰（很多終端機把 SGR 2 畫得幾乎看不見）。"""
    meta = theme().get("meta")
    return rgb(meta, s) if meta else sgr("2", s)


def tone(level):
    """用途 -> 顏色：ok／warn／fail／brand／text。"""
    return {"ok": GREEN, "warn": AMBER, "fail": RED, "brand": CYAN, "text": MAG}.get(level, MAG)


def limit_level(used):
    return "fail" if (used or 0) >= LIMIT_FAIL else "warn" if (used or 0) >= LIMIT_WARN else "brand"


def badge(level, s):
    """反白色塊（總結列專用）：色底黑字；沒有顏色時用方括號。"""
    if not _color:
        return "[%s]" % s
    c = tone(level)
    return "\033[1;38;2;0;0;0;48;2;%d;%d;%dm %s \033[0m" % (c[0], c[1], c[2], s)


def heat(pct):
    """0-100 的熱度顏色，照主題的漸層停靠點內插（classic：綠 -> 黃 -> 紅；cyber 沒有漸層，一律品牌青）。"""
    pct = max(0.0, min(100.0, pct or 0.0))
    stops = theme()["heat"]
    for (p0, c0), (p1, c1) in zip(stops, stops[1:]):
        if pct <= p1:
            t = (pct - p0) / float(p1 - p0) if p1 > p0 else 0.0
            return tuple(int(c0[i] + (c1[i] - c0[i]) * t) for i in range(3))
    return stops[-1][1]


