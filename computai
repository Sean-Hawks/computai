# ---------------------------------------------------------------- 路徑

def config_dir():
    """設定檔目錄：COMPUTAI_CONFIG_DIR > XDG_CONFIG_HOME > ~/.config（Windows 用 %APPDATA%）。"""
    d = os.environ.get("COMPUTAI_CONFIG_DIR")
    if d:
        return d
    if os.name == "nt" and os.environ.get("APPDATA"):
        return os.path.join(os.environ["APPDATA"], "computai")
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "computai")


def data_dir():
    """帳本目錄：COMPUTAI_DATA_DIR > XDG_DATA_HOME > ~/.local/share（Windows 用 %LOCALAPPDATA%）。"""
    d = os.environ.get("COMPUTAI_DATA_DIR")
    if d:
        return d
    if os.name == "nt" and os.environ.get("LOCALAPPDATA"):
        return os.path.join(os.environ["LOCALAPPDATA"], "computai")
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(base, "computai")


