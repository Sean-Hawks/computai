def cache_report(db, start, end, prices=None, top=10):
    """快取效率：同一個對話裡，前面已經寫進快取的內容又被整段重寫，就是浪費。
    每個 (來源, session, 模型) 依時間排，非第一筆的請求如果有一半以上的 context 是新寫入的快取，
    就算一次重寫；浪費 = 那些 token 用寫入價減去讀取價。跟上一筆隔超過快取壽命（5 分鐘／1 小時）
    的，原因是「閒置過期」，其他的是「前綴變了」（換了系統提示、工具、壓縮對話等）。
    subagent 的請求各有自己的對話，混在一起會誤判，所以不算。"""
    prices = load_prices() if prices is None else prices
    q = ("SELECT source, session, project, model, ts, input, cache_read, cache_write_5m, cache_write_1h "
         "FROM usage WHERE ts >= ? AND ts < ? AND subagent = 0 AND session != '' "
         "AND source IN ('claude', 'codex') ORDER BY source, session, model, ts")
    sessions = {}
    prev = None
    for r in db.execute(q, (start, end)):
        key = (r["source"], r["session"], r["model"])
        st = sessions.get(key)
        if st is None:
            st = sessions[key] = {"source": r["source"], "session": r["session"], "project": r["project"],
                                  "model": r["model"], "requests": 0, "rewrites": 0, "expired": 0,
                                  "read": 0, "written": 0, "total_in": 0, "wasted_usd": 0.0}
            prev = None
        cw = r["cache_write_5m"] + r["cache_write_1h"]
        ctx = r["input"] + r["cache_read"] + cw
        st["requests"] += 1
        st["read"] += r["cache_read"]
        st["written"] += cw
        st["total_in"] += ctx
        if prev is not None and ctx >= 2048 and cw >= 0.5 * ctx:
            st["rewrites"] += 1
            ttl = 3600 if r["cache_write_1h"] > r["cache_write_5m"] else 300
            if r["ts"] - prev > ttl:
                st["expired"] += 1
            p = price_for(r["model"], prices)
            if p:
                st["wasted_usd"] += (r["cache_write_5m"] * (p["cache_write_5m"] - p["cache_read"])
                                     + r["cache_write_1h"] * (p["cache_write_1h"] - p["cache_read"])) / 1e6
        prev = r["ts"]
    rows = list(sessions.values())
    for st in rows:
        st["hit_ratio"] = round(st["read"] / st["total_in"], 3) if st["total_in"] else None
        st["wasted_usd"] = round(st["wasted_usd"], 4)
    rows.sort(key=lambda x: -x["wasted_usd"])
    total = sum(x["wasted_usd"] for x in rows)
    read = sum(x["read"] for x in rows)
    tin = sum(x["total_in"] for x in rows)
    return {"wasted_usd": round(total, 2), "rewrites": sum(x["rewrites"] for x in rows),
            "expired": sum(x["expired"] for x in rows), "hit_ratio": round(read / tin, 3) if tin else None,
            "sessions": [x for x in rows if x["wasted_usd"] > 0][:top]}


def render_cache(c):
    lines = ["Cache efficiency: %s of input came from cache; %d rewrites (%d after idle expiry) cost %s extra"
             % ("-" if c["hit_ratio"] is None else "%d%%" % round(100 * c["hit_ratio"]), c["rewrites"],
                c["expired"], fmt_usd(c["wasted_usd"]))]
    if c["sessions"]:
        lines.append("  %-28s %-18s %8s %8s %9s" % ("worst sessions (project)", "model", "rewrites",
                                                    "expired", "wasted"))
    for x in c["sessions"]:
        lines.append("  %s %s %8d %8d %9s" % (cell(short_path(x["project"]) or x["session"][:8], 28),
                                              cell(x["model"], 18), x["rewrites"], x["expired"],
                                              fmt_usd(x["wasted_usd"])))
    if c["expired"] and c["expired"] >= c["rewrites"] / 2:
        lines.append("  Most rewrites follow an idle gap longer than the cache lifetime: "
                     "pausing a session for more than 5 min (or 1 h) makes the next message re-send everything.")
    return "\n".join(lines)


SUBSCRIPTION_SOURCES = ("claude", "codex")


def forecast(db, t=None, ps=None, month_machines=None):
    """這個月月底大概會花多少：訂閱月費 + 到今天為止的變動花費 + 最近 7 天的日均 × 剩下的天數。
    訂閱用量另外推估「照目前速度，這個月的等值 API 花費」，看方案划不划算。"""
    t = now() if t is None else t
    start, end, label = month_range(time.strftime("%Y-%m", time.localtime(t)))
    elapsed = max((t - start) / 86400.0, 1 / 24.0)
    remaining = max((end - t) / 86400.0, 0.0)
    s = summary(db, start, min(end, t + 1), plan_table={})
    fixed = sum(p["usd"] for p in plans().values())
    variable = {x["source"]: x["cost_usd"] for x in s["sources"]
                if x["source"] not in SUBSCRIPTION_SOURCES and x["source"] != "local"}
    if month_machines is None:
        month_machines = machine_report(db, start, t + 1, ps)
    elec = sum(r["energy_cost_usd"] or 0 for r in month_machines)
    if elec:
        variable["electricity"] = elec
    mtd = sum(variable.values())
    w0 = max(start, t - 7 * 86400)
    recent_days = max((t - w0) / 86400.0, 1 / 24.0)
    rs = summary(db, w0, t + 1, plan_table={})
    recent = sum(x["cost_usd"] for x in rs["sources"]
                 if x["source"] not in SUBSCRIPTION_SOURCES and x["source"] != "local")
    recent += sum(r["energy_cost_usd"] or 0 for r in machine_report(db, w0, t + 1, ps))
    rate = recent / recent_days
    projected = fixed + mtd + rate * remaining
    subs = {}
    for x in s["sources"]:
        if x["source"] in SUBSCRIPTION_SOURCES:
            subs[x["source"]] = round(x["cost_usd"] / elapsed * (elapsed + remaining), 2)
    budget = _float(load_config().get("budget", "monthly_usd", fallback="0"), 0.0)
    out = {"month": label, "days_left": round(remaining, 1), "subscriptions_usd": round(fixed, 2),
           "variable_so_far_usd": round(mtd, 2), "variable_by_source": {k: round(v, 2) for k, v in variable.items()},
           "daily_rate_usd": round(rate, 2), "projected_usd": round(projected, 2),
           "subscription_value_projected": subs, "budget_usd": budget or None, "over_budget": None}
    if budget:
        out["over_budget"] = projected > budget
    return out


def render_forecast(f):
    lines = ["Month-end forecast (%s, %.0f days left): %s" % (f["month"], f["days_left"], fmt_usd(f["projected_usd"])),
             "  subscriptions %s + spent so far %s + %s/day from here" % (
                 fmt_usd(f["subscriptions_usd"]), fmt_usd(f["variable_so_far_usd"]), fmt_usd(f["daily_rate_usd"]))]
    for src, v in sorted(f["subscription_value_projected"].items()):
        lines.append("  at this pace %s usage would be worth %s at API prices this month" % (src, fmt_usd(v)))
    if f["budget_usd"]:
        lines.append(("! over the %s budget" if f["over_budget"] else "  within the %s budget")
                     % fmt_usd(f["budget_usd"]))
    return "\n".join(lines)


def plan_options(cp=None):
    cp = cp or load_config()
    out = {}
    if not cp.has_section("plan_options"):
        return out
    for src, val in cp.items("plan_options"):
        opts = []
        for item in val.split(","):
            m = re.match(r"^\s*(.*?)\s+(\d+(?:\.\d+)?)\s+x(\d+(?:\.\d+)?)\s*$", item)
            if m:
                opts.append({"name": m.group(1), "usd": float(m.group(2)), "capacity": float(m.group(3))})
        if opts:
            out[src] = sorted(opts, key=lambda o: o["usd"])
    return out


def simulate_plans(db, t=None, days=30):
    """換方案會怎樣：用過去 30 天額度視窗的最高使用率，按方案倍數換算到其他方案；
    最便宜、而且推估最高使用率還在 90% 以下的就是建議。另外比較同期的等值 API 花費，
    用得很少時直接付 API 可能比較便宜。"""
    t = now() if t is None else t
    current = plans()
    out = []
    for src, opts in plan_options().items():
        cur = current.get(src)
        cur_opt = None
        if cur:
            for o in opts:
                if o["name"].lower() == cur["name"].lower() or abs(o["usd"] - cur["usd"]) < 0.01:
                    cur_opt = o
                    break
        rows = db.execute("SELECT name, MAX(used_percent) AS peak, COUNT(*) AS n, "
                          "SUM(CASE WHEN used_percent >= 95 THEN 1 ELSE 0 END) AS hits "
                          "FROM limits WHERE source = ? AND ts >= ? GROUP BY name",
                          (src, t - days * 86400)).fetchall()
        peak = max((r["peak"] for r in rows), default=None)
        window = max(rows, key=lambda r: r["peak"])["name"] if rows else None
        api = summary(db, t - days * 86400, t + 1, plan_table={})
        api_cost = sum(x["cost_usd"] for x in api["sources"] if x["source"] == src)
        res = {"source": src, "current": cur_opt["name"] if cur_opt else (cur or {}).get("name"),
               "current_usd": cur_opt["usd"] if cur_opt else (cur or {}).get("usd"),
               "peak_percent": peak, "peak_window": window, "api_equivalent_usd": round(api_cost, 2),
               "options": [], "recommend": None, "reason": ""}
        if peak is not None and cur_opt:
            for o in opts:
                proj = peak * cur_opt["capacity"] / o["capacity"]
                res["options"].append(dict(o, projected_peak=round(proj, 1), fits=proj < 90))
            fits = [o for o in res["options"] if o["fits"]]
            best = fits[0] if fits else res["options"][-1]
            res["recommend"] = best["name"]
            if best["name"] == cur_opt["name"]:
                if not fits:
                    res["reason"] = "reached %d%% of the %s limit and no bigger plan is listed" % (peak, window)
                elif opts.index(cur_opt) > 0:
                    res["reason"] = "peak %d%% of the %s limit; a smaller plan would not fit" % (peak, window)
                else:
                    res["reason"] = "peak %d%% of the %s limit" % (peak, window)
            elif best["usd"] < cur_opt["usd"]:
                res["reason"] = "peak was only %d%% of the %s limit; %s would peak around %d%%" % (
                    peak, window, best["name"], best["projected_peak"])
            else:
                res["reason"] = "you reached %d%% of the %s limit; %s would peak around %d%%" % (
                    peak, window, best["name"], best["projected_peak"])
        elif not rows:
            res["reason"] = "no limit data yet" + (" (set up `computai --statusline`)" if src == "claude" else "")
        cheapest = (min(o["usd"] for o in opts) if opts else None)
        if api_cost and cheapest and api_cost < cheapest:
            res["api_cheaper"] = True
            res["reason"] += ("; " if res["reason"] else "") + \
                "pay-as-you-go would have cost only %s" % fmt_usd(api_cost)
        out.append(res)
    return out


def render_plans(sims):
    lines = ["Plan check (last 30 days)"]
    for r in sims:
        rec = r["recommend"]
        head = "  %-7s on %s (%s): API-equivalent %s" % (
            r["source"], r["current"] or "?", fmt_usd(r["current_usd"]), fmt_usd(r["api_equivalent_usd"]))
        lines.append(head)
        if rec and rec != r["current"]:
            lines.append("    -> consider %s: %s" % (rec, r["reason"]))
        elif r["reason"]:
            lines.append("    %s" % r["reason"])
    return "\n".join(lines)


def average_kwh_price(ps, hours_per_day):
    """一度電的平均價格。時間電價就假設工作盡量排在離峰，離峰時數不夠才用到尖峰（取一年平均）。"""
    tou = ps.get("tou")
    if not tou:
        return ps["price_per_kwh"]
    total = 0.0
    for summer in (True, False):
        peak_h = sum(b - a for a, b in (tou["summer_hours"] if summer else tou["other_hours"]))
        off_h = 24 - peak_h
        on, off = (tou["summer_peak"], tou["summer_off"]) if summer else (tou["other_peak"], tou["other_off"])
        h_off = min(hours_per_day, off_h)
        h_on = max(hours_per_day - h_off, 0)
        avg = (h_off * off + h_on * on) / hours_per_day if hours_per_day else off
        months = len(tou["summer"]) if summer else 12 - len(tou["summer"])
        total += avg * months
    return total / 12


def payback(db, price_usd, watts=350.0, hours_per_day=8.0, rent_per_hour=None, t=None):
    """買一張卡要多久回本：跟租雲端 GPU 比，扣掉自己的電費。沒給租金就用帳本裡
    過去 30 天雲端 GPU 的平均每小時花費。"""
    t = now() if t is None else t
    ps = power_settings()
    source = "given"
    if rent_per_hour is None:
        rates = [r[0] for r in db.execute("SELECT usd_per_hour / MAX(gpu_count, 1) FROM cloud "
                                          "WHERE billing = 1 AND ts >= ? AND usd_per_hour > 0",
                                          (t - 30 * 86400,))]
        if not rates:
            return {"error": "no cloud GPU history; pass --rent-per-hour"}
        rent_per_hour = sum(rates) / len(rates)
        source = "your cloud GPUs, last 30 days (per GPU)"
    days = 30.44
    rent = rent_per_hour * hours_per_day * days
    kwh = watts / 1000.0 * hours_per_day * days
    elec_local = kwh * average_kwh_price(ps, hours_per_day)
    elec = to_usd(elec_local, ps)
    if elec is None:
        return {"error": "set [general] usd_to_local to convert %s electricity prices" % ps["currency"]}
    saving = rent - elec
    return {"gpu_price_usd": price_usd, "watts": watts, "hours_per_day": hours_per_day,
            "rent_per_hour": round(rent_per_hour, 4), "rent_source": source,
            "rent_monthly_usd": round(rent, 2), "kwh_monthly": round(kwh, 1),
            "electricity_monthly_usd": round(elec, 2), "saving_monthly_usd": round(saving, 2),
            "payback_months": round(price_usd / saving, 1) if saving > 0 else None}


def render_payback(r):
    if r.get("error"):
        return "Payback: " + r["error"]
    lines = ["GPU payback: %s card, %.0f W, %g h/day" % (fmt_usd(r["gpu_price_usd"]), r["watts"], r["hours_per_day"]),
             "  renting: %s/h (%s) = %s/month" % (fmt_usd(r["rent_per_hour"]), r["rent_source"],
                                                  fmt_usd(r["rent_monthly_usd"])),
             "  owning:  %.0f kWh/month = %s/month in electricity" % (r["kwh_monthly"],
                                                                      fmt_usd(r["electricity_monthly_usd"]))]
    if r["payback_months"] is None:
        lines.append("  -> never pays back: electricity costs more than renting")
    else:
        lines.append("  -> pays for itself in %.1f months (saves %s/month)" % (
            r["payback_months"], fmt_usd(r["saving_monthly_usd"])))
    return "\n".join(lines)


