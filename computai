# ---- 週報（--weekly，--send 送到 Discord／Telegram）

def weekly(db, t=None):
    """最近 7 天：花費、最常用的模型、額度最高點、機器耗電、警示和建議。"""
    t = now() if t is None else t
    start, end = t - 7 * 86400, t + 1
    s = summary(db, start, end, plan_table={})
    lines = [T("wk_title") % (day_label(start), day_label(t)), ""]
    for src in s["sources"]:
        top = ", ".join(m["model"] for m in src["models"][:2])
        lines.append("- " + T("wk_src") % (T("src").get(src["source"], src["source"]), fmt_usd(src["cost_usd"]),
                                                   fmt_tok(src["totals"]["output"]), ("; " + top) if top else ""))
    if not s["sources"]:
        lines.append("- " + T("wk_none"))
    peaks = db.execute("SELECT source, name, MAX(used_percent) AS p FROM limits WHERE ts >= ? GROUP BY source, name "
                       "ORDER BY p DESC", (start,)).fetchall()
    if peaks:
        lines.append("- " + T("wk_peaks") + ", ".join("%s %s %d%%" % (r["source"], r["name"], r["p"]) for r in peaks))
    energy = [r for r in machine_report(db, start, end) if r["kwh"]]
    if energy:
        lines.append("- " + T("wk_machines") + ", ".join("%s %.2f kWh" % (r["machine"], r["kwh"]) for r in energy))
    lines.append("- " + T("wk_total") % fmt_usd(s["total_cost_usd"]))
    for a in idle_alerts(db, t) + cloud_alerts(db, t):
        lines.append("! " + a["message"])
    for x in insights(db, t):
        lines.append("> " + x["text"])
    return "\n".join(lines)


def send_report(text):
    """送到有設定的地方：DISCORD_WEBHOOK_URL、TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID。
    回傳 [(目的地, 成功, 訊息)]。錯誤訊息不會帶出網址或 token。"""
    import urllib.error
    import urllib.request
    out = []
    targets = []
    hook = secret("DISCORD_WEBHOOK_URL")
    if hook:
        targets.append(("discord", hook, {"content": text[:1990]}))
    tok, chat = secret("TELEGRAM_BOT_TOKEN"), secret("TELEGRAM_CHAT_ID")
    if tok and chat:
        targets.append(("telegram", "https://api.telegram.org/bot%s/sendMessage" % tok,
                        {"chat_id": chat, "text": text[:4000]}))
    for name, url, body in targets:
        if not url.startswith("https://"):
            out.append((name, False, "the URL must start with https://"))
            continue
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={
            "Content-Type": "application/json", "User-Agent": "computai/" + __version__})
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                out.append((name, 200 <= r.status < 300, "HTTP %d" % r.status))
        except urllib.error.HTTPError as e:
            out.append((name, False, "HTTP %d" % e.code))
        except (OSError, ValueError) as e:
            out.append((name, False, type(e).__name__))
    return out


# ---- 年度回顧（--recap）

def recap(db, year):
    """一年的回顧：要拿去分享的，所以不放專案名稱和機器名稱。"""
    start, end = local_ts(year, 1, 1), local_ts(year + 1, 1, 1)
    s = summary(db, start, end, plan_table={})
    days = {}
    for g in breakdown(db, start, end, "day"):
        days[g["day"]] = days.get(g["day"], 0.0) + g["cost_usd"]
    active = sorted(d for d, v in days.items() if v > 0)
    streak = best = 0
    prev = None
    for d in active:
        t = time.mktime(time.strptime(d, "%Y-%m-%d"))
        streak = streak + 1 if prev is not None and abs(t - prev - 86400) < 7200 else 1
        best = max(best, streak)
        prev = t
    models = {}
    for src in s["sources"]:
        for m in src["models"]:
            if src["source"] in ("cloud",):
                continue
            models[m["model"]] = models.get(m["model"], 0) + m["input"] + m["cache_read"] + m["output"]
    tokens = sum(sum(src["totals"][c] for c in ("input", "cache_read", "cache_write_5m", "cache_write_1h", "output"))
                 for src in s["sources"] if src["source"] != "cloud")
    months = max(1, len({d[:7] for d in active}))
    fees = sum(p["usd"] for p in plans().values()) * months
    subs = sum(src["cost_usd"] for src in s["sources"] if src["source"] in SUBSCRIPTION_SOURCES)
    energy = machine_report(db, start, end)
    busiest = max(days.items(), key=lambda kv: kv[1]) if days else None
    return {"year": year, "tokens": tokens, "api_equivalent_usd": round(s["total_cost_usd"], 2),
            "subscription_usage_usd": round(subs, 2), "subscription_fees_usd": round(fees, 2),
            "value_ratio": round(subs / fees, 1) if fees else None, "active_days": len(active),
            "longest_streak": best, "busiest_day": busiest[0] if busiest else None,
            "busiest_day_usd": round(busiest[1], 2) if busiest else None,
            "top_models": [k for k, _ in sorted(models.items(), key=lambda kv: -kv[1])[:3]],
            "output_tokens": sum(src["totals"]["output"] for src in s["sources"]),
            "local_tokens": sum(src["totals"]["input"] + src["totals"]["output"] for src in s["sources"]
                                if src["source"] == "local"),
            "kwh": round(sum(r["kwh"] for r in energy), 2)}


