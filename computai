def api_days(db, source, days=31):
    """從上次同步的前一天開始抓；第一次抓 31 天。"""
    row = db.execute("SELECT value FROM meta WHERE key = ?", ("api_since:" + source,)).fetchone()
    start = now() - days * 86400
    if row:
        start = max(start, float(row["value"]) - 86400)
    return int(start // 86400 * 86400)


def mark_api(db, source):
    db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES (?, ?)", ("api_since:" + source, str(int(now()))))


