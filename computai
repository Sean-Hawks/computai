def claude_statusline_limits(payload, ts):
    """Claude Code 的 statusline 會把 JSON 從 stdin 傳進來；Pro/Max 帳號裡有
    rate_limits.five_hour／seven_day 的 used_percentage 和 resets_at（epoch 秒）。
    這是 Claude 額度百分比唯一的官方來源。其他欄位（路徑、模型、對話）一律不看。"""
    out = []
    rl = payload.get("rate_limits") if isinstance(payload, dict) else None
    if not isinstance(rl, dict):
        return out
    for key, minutes in (("five_hour", 300), ("seven_day", 10080)):
        w = rl.get(key)
        if not isinstance(w, dict) or w.get("used_percentage") is None:
            continue
        try:
            used = float(w["used_percentage"])
        except (TypeError, ValueError):
            continue
        out.append({"source": "claude", "name": window_label(minutes), "ts": int(ts),
                    "used_percent": used, "window_minutes": minutes,
                    "resets_at": _int(w.get("resets_at")) or None, "plan": ""})
    return out


def read_statusline_stdin():
    if sys.stdin is None or sys.stdin.isatty():
        return {}
    try:
        data = sys.stdin.read(1 << 20)
        d = json.loads(data) if data.strip() else {}
        return d if isinstance(d, dict) else {}
    except (ValueError, OSError):
        return {}


def render_line(info, sep="\uff5c"):
    out = []
    for p in info["limits"]:
        txt = "%s %d%%" % (p["label"], round(p["used_percent"]))
        if p["used_percent"] >= 90 and p["resets_in"] is not None:
            txt += " (%s)" % fmt_dur(p["resets_in"])
        out.append(txt)
    v = info["today_usd"]
    out.append("today $%s" % (("%.1f" % v) if v < 100 else "%d" % round(v)))
    return sep.join(out)


