def machine_panel(m, width, energy=None, error=None):
    """一台機器的面板（版面照 slurmtop 的 node_panel）：標題列有負載燈號和摘要，
    內容是 CPU、記憶體、每張 GPU（長條、走勢、VRAM、溫度、功耗）、功耗走勢、推論服務。"""
    lines = []
    led = "o" if _ascii else "◉"
    if error and not m:
        title = "%s %s" % (bold(rgb(CYAN, error["machine"])), rgb(RED, led))
        return panel(title, "", ["  " + rgb(RED, error["message"].split(": ", 1)[-1])], width, 100)
    gpus = m.get("gpus") or []
    load = (m["gpu_util"] if m["gpu_util"] is not None else m["cpu_pct"]) or 0.0
    where = T("local") if m.get("host") == "local" else T("ssh")
    ai = " " + rgb(GREEN, "AI") if m["ai_active"] else ""
    stale = (" " + rgb(AMBER, T("ago") % fmt_dur(m["age"]))) if m["age"] > 300 else ""
    left = "%s %s %s %s%s%s" % (dim(T("node")), bold(rgb(CYAN, m["machine"])), rgb(heat(load), led), dim(where), ai, stale)
    bits = []
    if gpus:
        names = sorted({g.get("model") or g.get("vendor") or "GPU" for g in gpus})
        bits.append("%dx %s" % (len(gpus), names[0]) if len(names) == 1 else T("gpus_n") % len(gpus))
    if m["power_w"] is not None:
        bits.append(rgb(MAG, "%.0f W" % m["power_w"]))
    temps = [g["temp"] for g in gpus if g.get("temp") is not None]
    if temps:
        bits.append(rgb(temp_color(max(temps)), "%.0f°C" % max(temps)))
    right = dim(sym(" \u00b7 ", " | ")).join(bits)
    sp_w = 10 if width >= 70 else 6
    cpu = m["cpu_pct"]
    ld = m.get("load")
    lines.append(" %s %s %s %s %s" % (rgb(CYAN, "CPU"), gradbar(cpu or 0), _num(cpu, "%5.1f%%", "    -"),
                                       spark(m["history"]["cpu"], sp_w),
                                       dim(T("load") % ld[0]) if ld else ""))
    if m.get("mem_total"):
        mp = 100.0 * (m["mem_used"] or 0) / m["mem_total"]
        lines.append(" %s %s %5.1f%% %s" % (rgb(CYAN, "MEM"), gradbar(mp), mp,
                                           dim("%.0f/%.0f GiB" % ((m["mem_used"] or 0) / 1024.0, m["mem_total"] / 1024.0))))
    for g in gpus:
        u = g.get("util")
        mem = ""
        if g.get("mem_total"):
            mem = "%.1f/%.0fG" % ((g.get("mem_used") or 0) / 1024.0, g["mem_total"] / 1024.0)
        temp = rgb(temp_color(g["temp"]), "%2.0f°" % g["temp"]) if g.get("temp") is not None else dim("  -")
        pw = dim(_num(g.get("power"), "%4.0fW", "    "))
        lines.append(" %s%s %s %s %s %s %s %s" % (rgb(CYAN, "G"), bold(str(g.get("idx"))), gradbar(u or 0),
                                                 _num(u, "%3.0f%%", "  -"), spark(g.get("history"), sp_w),
                                                 dim(mem), temp, pw))
    ph = [p for p in m["history"]["power"] if p is not None]
    if ph:
        top = max(ph + [1.0])
        extra = ""
        if energy and energy.get("kwh"):
            extra = dim("  " + T("kwh_month") % (
                energy["kwh"], "-" if energy["ai_share"] is None else "%d%%" % round(100 * energy["ai_share"])))
        lines.append(" %s %s %s%s" % (rgb(CYAN, "PWR"), rgb(MAG, "%5.0f W" % (m["power_w"] or 0)),
                                       spark(ph, sp_w + 6, color=MAG, relative=True), extra))
    by_svc = {}
    for x in m.get("loaded") or []:
        by_svc.setdefault((x["service"], x.get("port")), []).append(x)
    for svc in m.get("services") or []:
        key = (svc["kind"], svc["port"])
        models = by_svc.pop(key, [])
        busy = svc.get("busy", m["ai_active"])
        state = rgb(GREEN, sym("\u25cf", "*") + " " + T("busy")) if busy else dim(sym("\u25cb", "o") + " " + T("idle"))
        names = ", ".join("%s%s" % (x["name"], dim(" %s MB" % format(x["vram_mb"], ",")) if x.get("vram_mb") else "")
                          for x in models) or dim(T("no_model"))
        rate = ""
        req, tok_s = svc.get("requests", m["recent"]["requests"]), svc.get("tok_s", m["recent"]["tok_s"])
        if req:
            rate = dim("  " + T("rate") % (req, tok_s))
        elif tok_s:
            rate = dim("  " + T("rate_tok") % tok_s)
        lines.append(" %s %s %s%s" % (rgb(MAG, "%s:%s" % key), state, names, rate))
    if not m.get("services"):
        lines.append(dim(" " + T("no_server")))
    f = m.get("fits")
    if f:
        lines.append(dim(" " + (T("fits") % (f["free_gb"], "%gB" % f["params_b"]) if f["params_b"]
                                else T("fits_none") % f["free_gb"]) + (" " + T("fits_multi") if f["multi_gpu"] else "")))
    return panel(left, right, lines, width, load)


