def web_handler(state, bind, interval):
    """移植自 slurmtop 84cd35d 的 web_handler：安全標頭、只聽本機時檢查 Host 擋 DNS rebinding。"""
    import http.server
    js = WEB_JS.replace("REFRESH_MS", str(int(max(interval, 1) * 1000)))

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "computai/" + __version__
        timeout = 30

        def log_message(self, *a):
            pass

        def send(self, code, body, ctype):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Content-Security-Policy",
                             "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(data)

        def do_GET(self):
            if not host_header_ok(self.headers.get("Host"), bind):
                return self.send(403, "forbidden host\n", "text/plain; charset=utf-8")
            path = self.path.split("?", 1)[0]
            with state["lock"]:
                st, metrics = state.get("state"), state.get("metrics")
            if path in ("/", "/index.html"):
                return self.send(200, WEB_HTML, "text/html; charset=utf-8")
            if path == "/app.css":
                return self.send(200, WEB_CSS, "text/css; charset=utf-8")
            if path == "/app.js":
                return self.send(200, js, "text/javascript; charset=utf-8")
            if path == "/api/state":
                if st is None:
                    return self.send(503, '{"message": "loading"}', "application/json; charset=utf-8")
                return self.send(200, json.dumps(st, ensure_ascii=False), "application/json; charset=utf-8")
            if path == "/metrics":
                if metrics is None:
                    return self.send(503, "# no sample yet\n", "text/plain; charset=utf-8")
                return self.send(200, metrics, "text/plain; version=0.0.4; charset=utf-8")
            if path == "/healthz":
                return self.send(200, "ok\n", "text/plain; charset=utf-8")
            return self.send(404, "not found\n", "text/plain; charset=utf-8")

        do_HEAD = do_GET

    return Handler


def serve_web(listen, interval, sample_every):
    import http.server
    state = {"lock": threading.Lock(), "state": None, "metrics": None}
    host, port = parse_listen(listen, 8765)

    class Server(http.server.ThreadingHTTPServer):
        daemon_threads = True
        address_family = socket.AF_INET6 if ":" in host else socket.AF_INET

        def handle_error(self, request, client_address):
            err = sys.exc_info()[1]
            if not isinstance(err, (ConnectionError, socket.timeout)):
                warn("request failed: %r" % (err,))
    try:
        httpd = Server((host, port), web_handler(state, host, interval))
    except OSError as e:
        raise SystemExit("computai: cannot serve on %s:%d: %s" % (host, port, e.strerror or e))

    def on_state(st):
        text = prometheus(st)
        with state["lock"]:
            state["state"], state["metrics"] = st, text
    upd = Updater(sample_every=sample_every)
    threading.Thread(target=upd.run, args=(on_state, interval), daemon=True).start()
    shown = "[%s]" % host if ":" in host else host
    print("computai: dashboard on http://%s:%d/  (metrics at /metrics)" % (shown, httpd.server_address[1]),
          flush=True)
    if is_loopback(host):
        print("  only this computer can open it. From a phone, use an SSH tunnel or Tailscale serve.", flush=True)
    else:
        print("  WARNING: anyone who can reach this address sees your usage, project names and machines.",
              flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        upd.stop.set()
        httpd.server_close()
    return 0


