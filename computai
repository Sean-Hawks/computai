def edge_title(s, load=0.0):
    """面板標題兩側的字元跟框線同色（目前兩個主題都是空白）。"""
    return rgb(heat(load), s) if s.strip() else s


def side_by_side(a, b, gap=2):
    """兩欄面板並排；短的那欄補空白。"""
    wa = max([vlen(x) for x in a] or [0])
    n = max(len(a), len(b))
    a = a + [""] * (n - len(a))
    b = b + [""] * (n - len(b))
    return [pad(x, wa) + " " * gap + y for x, y in zip(a, b)]


HISTORY = 40  # sparkline 用最近幾次取樣


# 常見模型大小在 4-bit 量化（Q4_K_M）下大約要多少記憶體（GB，含一點 context）。粗估，給「現在放得下多大的模型」用。
MODEL_SIZES = ((1.5, 1.5), (4, 3.0), (8, 5.5), (14, 9.5), (32, 20.0), (70, 42.0), (120, 70.0), (235, 140.0))


def fits(m):
    """這台機器現在還放得下多大的模型（十億參數，4-bit）。NVIDIA／AMD 看空的 VRAM；
    Mac 的 GPU 用統一記憶體，看沒在用的記憶體的 75%（macOS 預設只讓 GPU 用掉大約這麼多）。"""
    gpus = m.get("gpus") or []
    discrete = [g for g in gpus if g.get("vendor") != "apple" and g.get("mem_total")]
    if discrete:
        free = max((g["mem_total"] - (g.get("mem_used") or 0)) for g in discrete) / 1024.0
        total = sum(g["mem_total"] - (g.get("mem_used") or 0) for g in discrete) / 1024.0
    elif m.get("mem_total") and any(g.get("vendor") == "apple" for g in gpus):
        free = total = max(0.0, (m["mem_total"] - (m.get("mem_used") or 0)) / 1024.0 * 0.75)
    else:
        return None
    best = None
    for params, need in MODEL_SIZES:
        if need <= free or (len(discrete) > 1 and need <= total * 0.9):
            best = params
    return {"free_gb": round(free, 1), "params_b": best, "multi_gpu": bool(best and len(discrete) > 1 and
                                                                         dict(MODEL_SIZES)[best] > free)}


def latest_samples(db, t=None, n=HISTORY):
    """每台機器最新的狀態，加上最近 n 次取樣的走勢（CPU、GPU、功耗、每張卡）和最近 5 分鐘的 token 速率。"""
    t = now() if t is None else t
    hosts = {m["name"]: m["host"] for m in machines()}
    out = []
    for (name,) in db.execute("SELECT DISTINCT machine FROM samples ORDER BY machine").fetchall():
        rows = [dict(r) for r in db.execute("SELECT * FROM samples WHERE machine = ? ORDER BY ts DESC LIMIT ?",
                                            (name, n)).fetchall()][::-1]
        r = rows[-1]
        try:
            detail = json.loads(r.get("detail") or "{}")
        except ValueError:
            detail = {}
        gpus_hist = {}
        for x in rows:
            try:
                for g in json.loads(x.get("detail") or "{}").get("gpus") or []:
                    gpus_hist.setdefault(str(g.get("idx")), []).append(g.get("util"))
            except ValueError:
                pass
        # 請求數只有 proxy 知道；從計數器算出來的列是一段時間的加總，不是一個請求
        rec = db.execute("SELECT COALESCE(SUM(CASE WHEN session = 'proxy' THEN 1 ELSE 0 END), 0) AS n, "
                         "COALESCE(SUM(output), 0) AS o, "
                         "COALESCE(SUM(CASE WHEN ts > ? THEN output ELSE 0 END), 0) AS o1 FROM usage "
                         "WHERE source = 'local' AND project = ? AND ts > ?", (t - 60, name, t - 300)).fetchone()
        out.append({"machine": name, "host": hosts.get(name, ""), "age": int(t - r["ts"]),
                    "cpu_pct": r["cpu_pct"], "gpu_util": r["gpu_util"], "gpu_mem_used": r["gpu_mem_used"],
                    "gpu_mem_total": r["gpu_mem_total"], "power_w": r["power_w"],
                    "ai_active": bool(r["ai_active"]),
                    "mem_used": detail.get("mem_used"), "mem_total": detail.get("mem_total"),
                    "load": detail.get("load"), "ncpu": detail.get("ncpu"),
                    "gpus": [dict(g, history=gpus_hist.get(str(g.get("idx")), [])) for g in detail.get("gpus") or []],
                    "services": detail.get("services") or [],
                    "loaded": [{k: x.get(k) for k in ("service", "port", "name", "vram_mb")}
                               for x in json.loads(r["loaded"] or "[]")],
                    "history": {"cpu": [x["cpu_pct"] for x in rows], "gpu": [x["gpu_util"] for x in rows],
                                "power": [x["power_w"] for x in rows], "ai": [x["ai_active"] for x in rows]},
                    # 請求數和 token 是最近 5 分鐘，速率是最近 1 分鐘（正在跑的時候才看得出快慢）
                    "recent": {"requests": rec["n"], "output": rec["o"], "tok_s": round(rec["o1"] / 60.0, 1)}})
        out[-1]["fits"] = fits(out[-1])
        # 每個服務自己的速率和忙碌狀態：計數器算出來的列 session 是服務種類，proxy 的列看模型名稱
        loaded_by = {}
        for x in out[-1]["loaded"]:
            loaded_by.setdefault((x["service"], x.get("port")), set()).add(normalize_model(x["name"]))
        for svc in out[-1]["services"]:
            models = loaded_by.get((svc["kind"], svc["port"]), set()) | {normalize_model(n) for n in svc.get("models") or []}
            r1 = db.execute("SELECT COALESCE(SUM(output), 0) AS o, "
                            "COALESCE(SUM(CASE WHEN session = 'proxy' THEN 1 ELSE 0 END), 0) AS n FROM usage "
                            "WHERE source = 'local' AND project = ? AND ts > ? AND (session = ? OR (session = 'proxy' "
                            "AND model IN (%s)))" % ",".join("?" * len(models) or ["''"]),
                            [name, t - 60, svc["kind"]] + sorted(models)).fetchone()
            n5 = db.execute("SELECT COALESCE(SUM(CASE WHEN session = 'proxy' THEN 1 ELSE 0 END), 0) FROM usage "
                            "WHERE source = 'local' AND project = ? AND ts > ? AND session = 'proxy' AND model IN (%s)"
                            % ",".join("?" * len(models) or ["''"]), [name, t - 300] + sorted(models)).fetchone()[0]
            svc["tok_s"] = round(r1["o"] / 60.0, 1)
            svc["requests"] = n5
            busy = bool(svc.get("running")) or svc["tok_s"] > 0
            if not busy and len(out[-1]["services"]) == 1:
                busy = out[-1]["ai_active"]  # 只有一個服務時，機器的活動（例如 Ollama 的 expires_at）就是它的
            svc["busy"] = busy
    return out


def local_compare(prices=None, cp=None):
    """本地 token 拿來比的 API 價格：[local] compare_model，沒設就用 prices.ini 裡輸出最便宜的模型。"""
    prices = load_prices() if prices is None else prices
    cp = cp or load_config()
    name = (cp.get("local", "compare_model", fallback="") or "").strip().lower()
    if name and price_for(name, prices):
        return name, price_for(name, prices)
    best = sorted((p["output"], n) for n, p in prices.items() if p.get("output"))
    return (best[0][1], prices[best[0][1]]) if best else (None, None)


def local_overview(db, machines_state, energy, t=None):
    """本地模型一覽：每台機器的每個模型一列——狀態、現在多快、今天和本月的 token，
    以及「這些 token 照 API 價格值多少」。也列出載入了但這個月還沒用過的模型。"""
    t = now() if t is None else t
    ms, me, _l = month_range()
    ts, _te = today_range()
    rows = {}
    q = ("SELECT project AS machine, model, session, SUM(input + cache_read) AS i, SUM(output) AS o, "
         "SUM(CASE WHEN ts >= ? THEN input + cache_read + output ELSE 0 END) AS today, COUNT(*) AS n "
         "FROM usage WHERE source = 'local' AND ts >= ? AND ts < ? GROUP BY project, model")
    for r in db.execute(q, (ts, ms, me)):
        key = (r["machine"], normalize_model(r["model"]))   # 計數器記的名字保留大小寫，比對時統一小寫
        row = rows.setdefault(key, {"machine": r["machine"], "model": r["model"], "input": 0, "output": 0,
                                    "today_tokens": 0, "service": None, "busy": False, "tok_s": 0.0})
        row["input"] += r["i"] or 0
        row["output"] += r["o"] or 0
        row["today_tokens"] += r["today"] or 0
    for m in machines_state:
        for svc in m.get("services") or []:
            names = {normalize_model(x["name"]) for x in m.get("loaded") or []
                     if x.get("service") == svc["kind"] and x.get("port") in (None, svc["port"])}
            names |= {normalize_model(x if isinstance(x, str) else x.get("name")) for x in svc.get("models") or []}
            for name in names:
                row = rows.setdefault((m["machine"], name), {
                    "machine": m["machine"], "model": name, "input": 0, "output": 0, "today_tokens": 0,
                    "service": None, "busy": False, "tok_s": 0.0})
                row["service"] = "%s:%s" % (svc["kind"], svc["port"])
                row["busy"] = bool(svc.get("busy"))
                row["tok_s"] = svc.get("tok_s") or 0.0
    name, price = local_compare()
    out = sorted(rows.values(), key=lambda r: (-r["busy"], -(r["input"] + r["output"])))
    for r in out:
        r["month_tokens"] = r["input"] + r["output"]
        r["api_usd"] = round((r["input"] * price["input"] + r["output"] * price["output"]) / 1e6, 2) if price else None
    power = sum((e.get("energy_cost_usd") or 0) * (e.get("ai_share") or 0) for e in energy)
    return {"rows": out, "compare": name,
            "today_tokens": sum(r["today_tokens"] for r in out), "month_tokens": sum(r["month_tokens"] for r in out),
            "api_usd": round(sum(r["api_usd"] or 0 for r in out), 2), "power_usd": round(power, 2)}


def daily_costs(db, days=14, t=None):
    """最近 days 天每天的花費（每個來源分開），給 sparkline 用。"""
    t = now() if t is None else t
    lt = time.localtime(t)
    end = local_ts(lt.tm_year, lt.tm_mon, lt.tm_mday) + 86400
    start = end - days * 86400
    labels = [day_label(start + i * 86400 + 3600) for i in range(days)]
    out = {}
    for g in breakdown(db, start, end, "day"):
        out.setdefault(g["source"], dict.fromkeys(labels, 0.0))
        if g["day"] in out[g["source"]]:
