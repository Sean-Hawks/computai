def usage_panel(st, width):
    """AI 訂閱與花費。金額分兩種，寫清楚：訂閱的是「照 API 價格算的價值」，雲端和 API 是真的花掉的錢。"""
    lines = []
    lim = {}
    for r in st["limits"]:
        lim.setdefault(r["source"], []).append(r)
    daily = st.get("daily") or {"days": [], "sources": {}}
    bar_w = 16 if width >= 70 else 10
    for x in st["sources"]:
        src = x["source"]
        name = T("src").get(src, src)
        plan = x.get("plan")
        if src == "local":
            lines.append(" %s %s" % (bold(cell(name, 14)), T("local_free") % fmt_tok(x["tokens"])))
            continue
        if src in SUBSCRIPTION_SOURCES:
            bits = [bold(T("worth") % fmt_usd(x["cost_usd"])) if theme().get("flat")
                    else rgb(CYAN, T("worth") % fmt_usd(x["cost_usd"]))]
            if plan:
                ratio = plan["value_ratio"] or 0
                bits.append(dim(T("plan_fee") % (fmt_usd(plan["fee_in_range"]), plan["name"])))
                bits.append(rgb(GREEN if ratio >= 1 else AMBER, T("value_x") % ratio))
            elif x.get("plan_missing"):
                bits.append(rgb(AMBER, T("plan_unset")))
        else:
            bits = [rgb(MAG, T("spent") % fmt_usd(x["cost_usd"]))]
        sep = dim(sym(" \u00b7 ", " | "))
        row = " %s %s" % (bold(cell(name, 14)), sep.join(bits))
        if vlen(row) <= width - 2:
            lines.append(row)
        else:  # 放不下就把月費、回本換到下一行，對齊在名字後面，不要被框線切掉
            lines.append(" %s %s" % (bold(cell(name, 14)), bits[0]))
            lines.append(" " * 16 + sep.join(bits[1:]))
        for r in sorted(lim.pop(src, []), key=lambda r: r["window_minutes"] or 0) if not QUOTA_PANEL else []:
            used = r["used_percent"]
            lv = limit_level(used)
            state = T("used_up") if used >= LIMIT_FAIL else T("used_pct") % used
            state = bold(rgb(tone(lv), state)) if lv != "brand" else state
            when = dim(" " + sym("\u00b7", "|") + " " + T("resets") % fmt_dur(r["resets_in"])) if r["resets_in"] is not None else ""
            lines.append("   %s %s %s%s" % (dim(cell(limit_label(r["name"]), 12)),
                                            gradbar(used, bar_w, lv if theme().get("flat") else None), state, when))
        series = daily["sources"].get(src)
        if series and any(series):
            lines.append("   %s %s %s" % (dim(cell(T("d14"), 12)), spark(series, len(series), top=max(series), color=CYAN),
                                           dim(T("today_worth" if src in SUBSCRIPTION_SOURCES else "today_spent")
                                               % fmt_usd(series[-1]))))
    for src, rows in (lim.items() if not QUOTA_PANEL else []):  # 有額度但這個月還沒有用量的來源
        for r in rows:
            lines.append(" %s %s %s %s" % (bold(cell(T("src").get(src, src), 14)), dim(limit_label(r["name"])),
                                          gradbar(r["used_percent"], bar_w), T("used_pct") % r["used_percent"]))
    if not lines:
        lines.append(dim(" " + T("no_usage")))
    f = st["forecast"]
    lines.append("")
    lines.append(" " + T("sum_value") % (bold(fmt_usd(st["total_cost_usd"])), bold(fmt_usd(st["today_usd"]))))
    pay = bold(rgb(RED, fmt_usd(f["projected_usd"])) if f.get("over_budget") else
               fmt_usd(f["projected_usd"]) if theme().get("flat") else rgb(CYAN, fmt_usd(f["projected_usd"])))
    lines.append(" " + T("sum_pay") % pay + (("  " + rgb(RED, T("over_budget") % fmt_usd(f["budget_usd"])))
                                            if f.get("over_budget") else ""))
    if not theme().get("flat"):
        return panel(bold(T("usage")) + " " + dim(st["month"]), dim(T("api_equiv")), lines, width, 0)
    # cyber：右上角是狀態字（幾個額度用完／快用完），「金額怎麼算」是來源，放在下框線
    full = sum(1 for r in st["limits"] if (r["used_percent"] or 0) >= LIMIT_FAIL)
    high = sum(1 for r in st["limits"] if LIMIT_WARN <= (r["used_percent"] or 0) < LIMIT_FAIL)
    state = rgb(RED, T("n_used_up") % full) if full else rgb(AMBER, T("n_high") % high) if high else ""
    return panel(ptitle(4, T("usage")) + " " + dim(st["month"]), "", lines, width, 0, foot=dim(T("api_equiv")))


