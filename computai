# ---- 週報（--weekly，--send 送到 Discord／Telegram）

def weekly(db, t=None):
    """最近 7 天：花費、最常用的模型、額度最高點、機器耗電、警示和建議。"""
    t = now() if t is None else t
    start, end = t - 7 * 86400, t + 1
    s = summary(db, start, end, plan_table={})
    lines = [T("wk_title") % (day_label(start), day_label(t)), ""]
    for src in s["sources"]:
        top = ", ".join(m["model"] for m in src["models"][:2])
        lines.append("- " + T("wk_src") % (T("src").get(src["source"], src["source"]), fmt_usd(src["cost_usd"]),
                                                   fmt_tok(src["totals"]["output"]), ("; " + top) if top else ""))
    if not s["sources"]:
        lines.append("- " + T("wk_none"))
    peaks = db.execute("SELECT source, name, MAX(used_percent) AS p FROM limits WHERE ts >= ? GROUP BY source, name "
                       "ORDER BY p DESC", (start,)).fetchall()
    if peaks:
        lines.append("- " + T("wk_peaks") + ", ".join("%s %s %d%%" % (r["source"], r["name"], r["p"]) for r in peaks))
    energy = [r for r in machine_report(db, start, end) if r["kwh"]]
    if energy:
        lines.append("- " + T("wk_machines") + ", ".join("%s %.2f kWh" % (r["machine"], r["kwh"]) for r in energy))
    lines.append("- " + T("wk_total") % fmt_usd(s["total_cost_usd"]))
    for a in idle_alerts(db, t) + cloud_alerts(db, t):
        lines.append("! " + a["message"])
    for x in insights(db, t):
        lines.append("> " + x["text"])
    return "\n".join(lines)


def send_report(text):
    """送到有設定的地方：DISCORD_WEBHOOK_URL、TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID。
    回傳 [(目的地, 成功, 訊息)]。錯誤訊息不會帶出網址或 token。"""
    import urllib.error
    import urllib.request
    out = []
    targets = []
    hook = secret("DISCORD_WEBHOOK_URL")
    if hook:
        targets.append(("discord", hook, {"content": text[:1990]}))
    tok, chat = secret("TELEGRAM_BOT_TOKEN"), secret("TELEGRAM_CHAT_ID")
    if tok and chat:
        targets.append(("telegram", "https://api.telegram.org/bot%s/sendMessage" % tok,
                        {"chat_id": chat, "text": text[:4000]}))
    for name, url, body in targets:
        if not url.startswith("https://"):
            out.append((name, False, "the URL must start with https://"))
            continue
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={
            "Content-Type": "application/json", "User-Agent": "computai/" + __version__})
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                out.append((name, 200 <= r.status < 300, "HTTP %d" % r.status))
        except urllib.error.HTTPError as e:
            out.append((name, False, "HTTP %d" % e.code))
        except (OSError, ValueError) as e:
            out.append((name, False, type(e).__name__))
    return out


# ---- 通知：有事時主動告訴你（狀態改變才送一次）

def notify_settings(cp=None):
    cp = cp or load_config()
    yes = lambda k, d: (cp.get("notify", k, fallback=d) or d).strip().lower() in ("yes", "true", "1", "on")
    return {"desktop": yes("desktop", "yes"), "chat": yes("chat", "no")}


def notify_events(db, st):
    """跟上次比，哪些事情變了：額度到 80%、用完、重置（又可以用了）、新的警示。
    狀態存在帳本的 meta（notify_state），所以重開程式不會重講；同時跑好幾個 computai 也只會有一個講。
    第一次執行只記下現況，不通知。回傳 [(等級, 白話句子)]。"""
    db.commit()
    db.execute("BEGIN IMMEDIATE")
    try:
        row = db.execute("SELECT value FROM meta WHERE key = 'notify_state'").fetchone()
        first = row is None
        old = json.loads(row["value"]) if row else {}
        new, out = {}, []
        worst = {}
        for r in st["limits"]:
            worst[r["source"]] = max(worst.get(r["source"], 0.0), r["used_percent"] or 0.0)
        for r in st["limits"]:
            key = "limit:%s:%s" % (r["source"], r["name"])
            used = r["used_percent"] or 0.0
            lv = "full" if used >= LIMIT_FAIL else "high" if used >= LIMIT_WARN else "ok"
            new[key] = [lv, r["resets_at"]]
            was = old.get(key)
            if not was:
                continue
            src, win = T("src").get(r["source"], r["source"]), limit_label(r["name"])
            reset = fmt_dur(r["resets_in"]) if r.get("resets_in") is not None else "?"
            if was[0] != "ok" and lv == "ok" and (r.get("stale") or r["resets_at"] != was[1]):
                out.append(("ok", T("nt_reset") % (src, win)))
            elif lv == "full" and was[0] != "full":
                alt = sorted((u, s_) for s_, u in worst.items() if s_ != r["source"] and u <= 90)
                more = (" " + T("nt_alt") % (T("src").get(alt[0][1], alt[0][1]), round(100 - alt[0][0]))) if alt else ""
                out.append(("fail", T("nt_full") % (src, win, reset) + more))
            elif lv == "high" and was[0] == "ok":
                pace = (" " + T("nt_pace") % fmt_dur(r["eta_full"])) if r.get("eta_full") else ""
                out.append(("warn", T("nt_high") % (src, win, round(used)) + pace))
        for a in st["alerts"]:
            key = "alert:%s:%s" % (a["kind"], a.get("machine") or a.get("id") or "")
            new[key] = 1
            if not first and key not in old:
                out.append((alert_level(a), a["message"]))
        if (st.get("forecast") or {}).get("over_budget"):
            new["budget"] = 1
            if not first and "budget" not in old:
                f = st["forecast"]
                out.append(("fail", T("v_budget") % (fmt_usd(f["projected_usd"]), fmt_usd(f["budget_usd"]))))
        db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('notify_state', ?)", (json.dumps(new),))
        db.commit()
    except Exception:
        db.rollback()
        raise
    return out


def notify_desktop(title, text):
    """系統通知。文字一律當參數或環境變數傳，不拼進指令碼（避免被名稱裡的引號注入）。"""
    if os.environ.get("COMPUTAI_FIXTURES"):  # 測試和示範資料不跳真的通知
        return
    if sys.platform == "darwin":
        run_cmd(["osascript", "-e", "on run argv", "-e",
                 "display notification (item 2 of argv) with title (item 1 of argv)", "-e", "end run",
                 title, text], timeout=10)
    elif os.name == "nt":
        ps = ("Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; "
              "$n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; "
              "$n.ShowBalloonTip(10000, $env:COMPUTAI_NT, $env:COMPUTAI_NX, 'Info'); Start-Sleep 11; $n.Dispose()")
        try:
            subprocess.Popen(["powershell", "-NoProfile", "-WindowStyle", "Hidden", "-Command", ps],
                             env=dict(os.environ, COMPUTAI_NT=title, COMPUTAI_NX=text),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
    elif shutil.which("notify-send"):
        run_cmd(["notify-send", "--app-name=ComputAI", title, text], timeout=10)


def deliver(events, settings=None):
    """把事情送出去：桌面通知（每件一則），聊天（合成一則）。回傳送了幾件。"""
    if not events:
        return 0
    settings = settings or notify_settings()
    mark = {"ok": "\u2713", "warn": "\u26a0", "fail": "\u26a0"}
    if settings["desktop"]:
        for lv, text in events[:5]:  # 一次很多件時只跳前五則，避免洗版
            notify_desktop("ComputAI " + mark.get(lv, ""), text)
    if settings["chat"]:
        send_report("\n".join("%s %s" % (mark.get(lv, "-"), text) for lv, text in events))
    return len(events)


def notify_tick(db, st):
    """Updater 每一輪呼叫：有變化就送。通知失敗不影響畫面。"""
    settings = notify_settings()
    if not (settings["desktop"] or settings["chat"]):
        return []
    try:
        events = notify_events(db, st)
        deliver(events, settings)
        return events
    except Exception as e:
        warn("notify failed: %r" % (e,))
        return []


def run_watch(interval, sample_every):
    """不開畫面，只在背景更新帳本並通知（--watch；--install-watch 讓它開機自動跑）。"""
    print("computai: watching limits, machines and alerts; notifications: %s (Ctrl-C to stop)"
          % ", ".join(k for k, v in notify_settings().items() if v) or "off")
    upd = Updater(sample_every=sample_every)
    try:
        upd.run(lambda st: None, max(30.0, interval))
    except KeyboardInterrupt:
        pass
    return 0


WATCH_LABEL = "com.computai.watch"


def watch_service(install=True):
    """讓 --watch 登入後自動在背景跑：macOS launchd、Linux systemd --user、Windows 工作排程器。
    回傳 (做了什麼, 檔案或工作名稱)。移除時 install=False。"""
    script = os.path.abspath(sys.argv[0])
    py = sys.executable
    log = os.path.join(data_dir(), "watch.log")
    if sys.platform == "darwin":
        path = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % WATCH_LABEL)
        uid = str(os.getuid())
        run_cmd(["launchctl", "bootout", "gui/%s/%s" % (uid, WATCH_LABEL)], timeout=15)
        if not install:
            if os.path.exists(path):
                os.remove(path)
            return "removed", path
        from xml.sax.saxutils import escape as x
        os.makedirs(os.path.dirname(path), exist_ok=True)
        os.makedirs(data_dir(), exist_ok=True)
        with open(path, "w") as f:
            f.write('<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
                    '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict>\n'
                    '<key>Label</key><string>%s</string>\n<key>ProgramArguments</key><array>'
                    '<string>%s</string><string>%s</string><string>--watch</string></array>\n'
                    '<key>RunAtLoad</key><true/>\n<key>KeepAlive</key><true/>\n'
                    '<key>StandardOutPath</key><string>%s</string>\n<key>StandardErrorPath</key><string>%s</string>\n'
                    '</dict></plist>\n' % (WATCH_LABEL, x(py), x(script), x(log), x(log)))
        err = []
        run_cmd(["launchctl", "bootstrap", "gui/" + uid, path], timeout=15, errors=err)
        return ("installed" if not err else "written (launchctl: %s)" % err[0]), path
    if os.name == "nt":
        name = "ComputAI watch"
        if not install:
            run_cmd(["schtasks", "/Delete", "/TN", name, "/F"], timeout=30)
            return "removed", name
        pyw = os.path.join(os.path.dirname(py), "pythonw.exe")
        cmd = '"%s" "%s" --watch' % (pyw if os.path.exists(pyw) else py, script)
        err = []
        run_cmd(["schtasks", "/Create", "/SC", "ONLOGON", "/TN", name, "/TR", cmd, "/F"], timeout=30, errors=err)
        return ("installed" if not err else "failed: %s" % err[0]), name
    path = os.path.expanduser("~/.config/systemd/user/computai-watch.service")
    if not install:
        run_cmd(["systemctl", "--user", "disable", "--now", "computai-watch.service"], timeout=30)
        if os.path.exists(path):
            os.remove(path)
        return "removed", path
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("[Unit]\nDescription=ComputAI: notify about AI limits, machines and alerts\n\n[Service]\n"
                "ExecStart=%s %s --watch\nRestart=on-failure\n\n[Install]\nWantedBy=default.target\n"
                % (shlex_quote(py), shlex_quote(script)))
    err = []
    run_cmd(["systemctl", "--user", "daemon-reload"], timeout=30)
    run_cmd(["systemctl", "--user", "enable", "--now", "computai-watch.service"], timeout=30, errors=err)
    return ("installed" if not err else "written (systemctl: %s)" % err[0]), path


# ---- 本地模型跑分（--bench）：在自己的機器上跑，划不划算？

BENCH_PROMPT = "Explain in plain words how a refrigerator keeps food cold."  # 固定題目，不含任何使用者資料
BENCH_TOKENS = 256
BENCH_SECONDS = 8.0


def bench_body(kind, model):
    if kind == "ollama":
        return "/api/generate", {"model": model, "prompt": BENCH_PROMPT, "stream": False,
                                 "options": {"num_predict": BENCH_TOKENS, "temperature": 0}}
    return "/v1/chat/completions", {"model": model, "messages": [{"role": "user", "content": BENCH_PROMPT}],
                                    "max_tokens": BENCH_TOKENS, "temperature": 0, "stream": False}


def bench_script(kind, port, model):
    """在那台機器上用 curl 送一次生成，印出 API 回應和總耗時（@@time）。"""
    path, body = bench_body(kind, model)
    return ("command -v curl >/dev/null 2>&1 || { echo '@@error curl not found'; exit 0; }\n"
            "curl -sS -m 300 -H 'Content-Type: application/json' -w '\\n@@time %%{time_total}\\n' "
            "--data-binary @- http://127.0.0.1:%d%s <<'COMPUTAI_EOF'\n%s\nCOMPUTAI_EOF\n"
            % (port, path, json.dumps(body)))


def bench_models_script(kind, port):
    path = "/api/tags" if kind == "ollama" else "/v1/models"
    return ("if command -v curl >/dev/null 2>&1; then curl -fsS -m 5 http://127.0.0.1:%d%s; "
            "else wget -qO- -T 5 http://127.0.0.1:%d%s; fi | head -c 200000" % (port, path, port, path))


def bench_pick_model(kind, text, loaded):
    """跑哪個模型：已經載入的優先（不用等載入）；Ollama 沒有載入的就挑最小的。"""
    if loaded:
        return loaded[0]
    try:
        d = json.loads(text or "{}")
    except ValueError:
        return None
    if kind == "ollama":
        ms = sorted(d.get("models") or [], key=lambda x: x.get("size") or 0)
        return ms[0].get("name") if ms else None
    ids = [x.get("id") for x in d.get("data") or [] if x.get("id")]
    return ids[0] if ids else None


def bench_parse(kind, text):
    """一次生成的結果：(產生的 token 數, 生成花的秒數)。只讀用量欄位，模型寫的內容直接丟掉。"""
    body, _, tail = (text or "").rpartition("@@time")
    try:
        total = float(tail.split()[0])
        d = json.loads(body.strip() or "{}")
    except (ValueError, IndexError):
        return None
    if kind == "ollama":
        n, ns = d.get("eval_count"), d.get("eval_duration")
        return (int(n), ns / 1e9) if n and ns else None
    n = (d.get("usage") or {}).get("completion_tokens")
    return (int(n), total) if n and total > 0 else None


def bench(db, only=None):
    """對每台機器上在跑的推論服務各跑幾次生成（合計至少 BENCH_SECONDS 秒），中途取樣一次功耗。
    回傳每個服務一列：速度（tok/s）、功耗、每 token 幾焦耳、每百萬 token 電費、和最便宜的 API 比。"""
    ms = [m for m in machines() if not only or m["name"] in only]
    sample_machines(db, only=[m["name"] for m in ms])
    latest = {r["machine"]: r for r in latest_samples(db)}
    ps = power_settings()
    price, _peak = price_at(now(), ps)
    to_usd = (1.0 if ps["currency"] == "USD" else (1.0 / ps["usd_to_local"] if ps["usd_to_local"] else None))
    api = sorted(((p["output"], name) for name, p in load_prices().items() if p.get("output")), key=lambda x: x[0])
    rows = []
    for m in ms:
        snap = latest.get(m["name"])
        for svc in (snap or {}).get("services") or []:
            kind, port = svc["kind"], svc["port"]
            loaded = [x["name"] for x in (snap.get("loaded") or []) if x.get("service") == kind]
            model = bench_pick_model(kind, run_script(m["host"], bench_models_script(kind, port), timeout=15), loaded)
            row = {"machine": m["name"], "service": "%s:%d" % (kind, port), "model": model, "tok_s": None,
                   "power_w": None, "j_per_token": None, "usd_per_mtok": None, "error": None}
            rows.append(row)
            if not model:
                row["error"] = T("b_nomodel")
                continue
            done, toks, secs = {}, [0], [0.0]

            def work():
                t0 = time.time()
                while time.time() - t0 < BENCH_SECONDS and not done.get("stop"):
                    out = untrusted(run_script(m["host"], bench_script(kind, port, model), timeout=320))
                    if "@@error" in out:
                        done["error"] = out.split("@@error", 1)[1].strip()[:120]
                        return
                    r = bench_parse(kind, out)
                    if not r:
                        done["error"] = T("b_noanswer")
                        return
                    toks[0] += r[0]
                    secs[0] += r[1]
            th = threading.Thread(target=work, daemon=True)
            th.start()
            th.join(BENCH_SECONDS / 2)          # 跑到一半取樣一次，量的是「正在生成」時的功耗
            if th.is_alive():
                sample_machines(db, only=[m["name"]])
                cur = {r["machine"]: r for r in latest_samples(db)}.get(m["name"]) or {}
                row["power_w"] = cur.get("power_w")
            th.join(330)
            done["stop"] = True
            if done.get("error"):
                row["error"] = done["error"]
                continue
            if not secs[0]:
                row["error"] = T("b_noanswer")
                continue
            row["tok_s"] = round(toks[0] / secs[0], 1)
            if row["power_w"] and row["tok_s"]:
                row["j_per_token"] = round(row["power_w"] / row["tok_s"], 3)
                if price and to_usd:
                    row["usd_per_mtok"] = round(row["j_per_token"] * 1e6 / 3.6e6 * price * to_usd, 4)
    return {"rows": rows, "api_cheapest": {"model": api[0][1], "usd_per_mtok": api[0][0]} if api else None,
            "tokens": BENCH_TOKENS, "price_per_kwh": price, "currency": ps["currency"]}


def render_bench(b):
    cols = ((T("b_machine"), 14, False), (T("b_service"), 14, False), (T("b_model"), 22, False),
            (T("b_speed"), 12, True), (T("b_power"), 7, True), ("J/token", 8, True), (T("b_cost"), 18, True))
    row_ = lambda vals: " ".join(cell(v, w, tail=False) if not right else " " * max(0, w - vlen(v)) + v
                                 for v, (_h, w, right) in zip(vals, cols))
    lines = [row_([h for h, _w, _r in cols])]
    for r in b["rows"]:
        if r["error"]:
            lines.append(row_([r["machine"], r["service"], r["model"] or "-"]) + " " + r["error"])
            continue
        lines.append(row_([r["machine"], r["service"], r["model"], "%.1f tok/s" % r["tok_s"],
                           _num(r["power_w"], "%.0f W"), _num(r["j_per_token"], "%.2f"),
                           fmt_usd(r["usd_per_mtok"]) if r["usd_per_mtok"] is not None else "-"]))
    if not b["rows"]:
        lines.append(T("b_none"))
    api = b["api_cheapest"]
    best = [r for r in b["rows"] if r["usd_per_mtok"]]
    lines.append("")
    if api:
        lines.append(T("b_api") % (api["model"], fmt_usd(api["usd_per_mtok"])))
    for r in best:
        if api and r["usd_per_mtok"] > 0:
            lines.append("  " + T("b_vs") % (r["machine"], r["model"], api["usd_per_mtok"] / r["usd_per_mtok"]))
    if any(r["tok_s"] and r["power_w"] is None for r in b["rows"]):
        lines.append(T("b_nopower"))
    lines.append(T("b_note") % b["tokens"])
    return "\n".join(lines)


# ---- 年度回顧（--recap）

def recap(db, year):
    """一年的回顧：要拿去分享的，所以不放專案名稱和機器名稱。"""
    start, end = local_ts(year, 1, 1), local_ts(year + 1, 1, 1)
    s = summary(db, start, end, plan_table={})
    days = {}
    for g in breakdown(db, start, end, "day"):
        days[g["day"]] = days.get(g["day"], 0.0) + g["cost_usd"]
    active = sorted(d for d, v in days.items() if v > 0)
    streak = best = 0
    prev = None
    for d in active:
        t = time.mktime(time.strptime(d, "%Y-%m-%d"))
        streak = streak + 1 if prev is not None and abs(t - prev - 86400) < 7200 else 1
        best = max(best, streak)
        prev = t
    models = {}
    for src in s["sources"]:
        for m in src["models"]:
            if src["source"] in ("cloud",):
                continue
            models[m["model"]] = models.get(m["model"], 0) + m["input"] + m["cache_read"] + m["output"]
    tokens = sum(sum(src["totals"][c] for c in ("input", "cache_read", "cache_write_5m", "cache_write_1h", "output"))
                 for src in s["sources"] if src["source"] != "cloud")
    months = max(1, len({d[:7] for d in active}))
    fees = sum(p["usd"] for p in plans().values()) * months
    subs = sum(src["cost_usd"] for src in s["sources"] if src["source"] in SUBSCRIPTION_SOURCES)
    energy = machine_report(db, start, end)
    busiest = max(days.items(), key=lambda kv: kv[1]) if days else None
    return {"year": year, "tokens": tokens, "api_equivalent_usd": round(s["total_cost_usd"], 2),
            "subscription_usage_usd": round(subs, 2), "subscription_fees_usd": round(fees, 2),
            "value_ratio": round(subs / fees, 1) if fees else None, "active_days": len(active),
            "longest_streak": best, "busiest_day": busiest[0] if busiest else None,
            "busiest_day_usd": round(busiest[1], 2) if busiest else None,
            "top_models": [k for k, _ in sorted(models.items(), key=lambda kv: -kv[1])[:3]],
            "output_tokens": sum(src["totals"]["output"] for src in s["sources"]),
            "local_tokens": sum(src["totals"]["input"] + src["totals"]["output"] for src in s["sources"]
                                if src["source"] == "local"),
            "kwh": round(sum(r["kwh"] for r in energy), 2)}


