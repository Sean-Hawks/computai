def local_models(db, start, end):
    """本地推論：每台機器、每個模型的 token。"""
    return [dict(r) for r in db.execute(
        "SELECT project AS machine, model, session AS via, SUM(input + cache_read) AS prompt, SUM(output) AS output, "
        "SUM(requests) AS requests FROM usage WHERE source = 'local' AND ts >= ? AND ts < ? "
        "GROUP BY project, model, session ORDER BY SUM(output) DESC", (start, end))]


