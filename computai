# ---- 智慧插座：實測整台機器的功耗
#
# [machine.名稱] plug = shelly:192.168.1.50     Shelly Gen2/3（RPC，Switch.GetStatus 的 apower）
#                plug = shelly1:192.168.1.50    Shelly Gen1（/status 的 meters[0].power）
#                plug = tasmota:192.168.1.51    Tasmota（Status 8 的 ENERGY.Power）
#                plug = ha:sensor.gpu_box_power Home Assistant 的功率感測器（HA_URL、HA_TOKEN）
# 插座在區網，由跑 computai 的這台直接用 HTTP 讀；讀不到就退回估算值。

def plug_url(spec):
    kind, _, target = (spec or "").partition(":")
    kind, target = kind.strip().lower(), target.strip()
    if not target or not re.match(r"^[\w.:\-\[\]]+$", target):
        return None, None
    if kind == "shelly":
        return kind, "http://%s/rpc/Switch.GetStatus?id=0" % target
    if kind == "shelly1":
        return kind, "http://%s/status" % target
    if kind == "tasmota":
        return kind, "http://%s/cm?cmnd=Status%%208" % target
    if kind == "ha":
        base = (secret("HA_URL") or "").rstrip("/")
        return (kind, "%s/api/states/%s" % (base, target)) if base else (None, None)
    return None, None


def read_plug(spec):
    """插座現在的瓦數；讀不到回傳 None。"""
    kind, url = plug_url(spec)
    if not url:
        return None
    fx = os.environ.get("COMPUTAI_FIXTURES")
    if fx:
        path = os.path.join(fx, "http", "plug-%s.json" % kind)
        body = open(path, encoding="utf-8").read() if os.path.exists(path) else None
    else:
        headers = {"Authorization": "Bearer " + (secret("HA_TOKEN") or "")} if kind == "ha" else None
        body = http_get(url, timeout=3, headers=headers)
    try:
        d = json.loads(body or "")
    except ValueError:
        return None
    try:
        if kind == "shelly":
            return float(d["apower"])
        if kind == "shelly1":
            return float(d["meters"][0]["power"])
        if kind == "tasmota":
            return float(d["StatusSNS"]["ENERGY"]["Power"])
        if kind == "ha":
            w = float(d["state"])
            unit = (d.get("attributes") or {}).get("unit_of_measurement", "W")
            return w * 1000 if unit == "kW" else w
    except (KeyError, IndexError, TypeError, ValueError):
        return None
    return None


# ---- Wake-on-LAN（--wake）

def magic_packet(mac):
    """6 個 0xFF 加上 16 次 MAC。MAC 格式不對回傳 None。"""
    h = re.sub(r"[^0-9a-fA-F]", "", mac or "")
    if len(h) != 12:
        return None
    return b"\xff" * 6 + bytes.fromhex(h) * 16


def wake(name, addr="255.255.255.255", port=9):
    """喚醒 [machines] 裡的機器（要在 [machine.名稱] 設 mac，可選 wol_address 指定廣播位址）。"""
    cp = load_config()
    sec = "machine." + name
    mac = cp.get(sec, "mac", fallback="") if cp.has_section(sec) else ""
    pkt = magic_packet(mac)
    if pkt is None:
        raise SystemExit("computai: set mac = aa:bb:cc:dd:ee:ff under [%s] first" % sec)
    addr = cp.get(sec, "wol_address", fallback=addr) or addr
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.sendto(pkt, (addr, port))
    finally:
        sock.close()
    return mac, addr


def suggest_power(d):
    """依取樣到的硬體給功耗設定的建議值（粗估；有智慧插座就用插座）。回傳 (設定 dict, 說明)。"""
    host = d.get("host") or {}
    laptop = host.get("battery") == "yes"
    gpus = d.get("gpus") or []
    apple = [g for g in gpus if g.get("vendor") == "apple"]
    measured = [g for g in gpus if g.get("power") is not None]
    if apple:
        name = (apple[0].get("model") or "")
        tier = "ultra" if "Ultra" in name else "max" if "Max" in name else "pro" if "Pro" in name else "base"
        peak = {"base": 30, "pro": 55, "max": 90, "ultra": 180}[tier]
        if laptop:
            return {"idle_watts": 5, "max_watts": peak}, "Apple %s laptop" % tier
        return {"idle_watts": 10 if tier in ("base", "pro") else 20, "max_watts": peak + 20}, "Apple %s desktop" % tier
    if measured:
        if host.get("wsl") == "yes" or not laptop:
            base = 150 if len(gpus) > 2 else 60
            return {"base_watts": base, "cpu_watts": 90}, "desktop with %d measured GPU%s" % (
                len(gpus), "" if len(gpus) == 1 else "s")
        return {"base_watts": 15, "cpu_watts": 30}, "laptop with a measured GPU"
    if laptop:
        return {"idle_watts": 6, "max_watts": 35}, "laptop"
    return {"idle_watts": 25, "max_watts": 120}, "desktop or server without readable GPU power"


def estimate_power(m, gpu_power, util, cpu):
    """整台機器的功耗（W）。讀得到 GPU 功耗就用「GPU + 其他部分」，
    讀不到（Mac、Jetson）就用設定的閒置／滿載功耗按負載內插；都沒設定回傳 None。"""
    if gpu_power is not None:
        # cpu_watts：CPU 從閒置到全速多出來的功耗（CPU 推論、編譯時 GPU 功耗看不到這部分）
        return gpu_power + (m.get("base_watts") or 0.0) + (m.get("cpu_watts") or 0.0) * (cpu or 0.0) / 100.0
    lo, hi = m.get("idle_watts"), m.get("max_watts")
    if hi is None:
        return lo
    lo = lo or 0.0
    load = max(util or 0.0, cpu or 0.0) / 100.0
    return lo + (hi - lo) * max(0.0, min(1.0, load))


AI_GPU_UTIL = 20.0   # 有模型載入、GPU 使用率超過這個值，就算在做推論
MAX_GAP = 600        # 兩次取樣隔超過 10 分鐘，中間的耗電當作不知道，不積分


def previous_sample(db, machine):
    return db.execute("SELECT * FROM samples WHERE machine = ? ORDER BY ts DESC LIMIT 1",
                      (machine,)).fetchone()


def record_sample(db, m, d, ts):
    """把一次取樣寫進帳本；推論服務的 token 計數器變多的部分記成 local 用量。回傳新增的用量列。"""
    prev = previous_sample(db, m["name"])
    prev_cpu = None
    if prev and prev["cpu_raw"]:
        try:
            prev_cpu = tuple(json.loads(prev["cpu_raw"]))
        except ValueError:
            prev_cpu = None
    cpu = d.get("cpu")
    pct = cpu_pct(cpu, prev_cpu)
    gpus = d.get("gpus") or []
    utils = [g["util"] for g in gpus if g["util"] is not None]
    powers = [g["power"] for g in gpus if g["power"] is not None]
    util = sum(utils) / len(utils) if utils else None
    gpu_power = sum(powers) if powers else None
    mem_used = sum(g["mem_used"] or 0 for g in gpus) if gpus else None
    mem_total = sum(g["mem_total"] or 0 for g in gpus) if gpus else None
    loaded, counters, running = [], {}, 0.0
    for svc in d.get("services") or []:
        for mo in svc["models"]:
            loaded.append({"service": svc["kind"], "port": svc["port"], "name": mo["name"],
                           "vram_mb": mo.get("vram_mb"), "expires_at": mo.get("expires_at")})
        for model, c in svc["counters"].items():
            counters["%s:%d:%s" % (svc["kind"], svc["port"], model)] = c
        running += svc["running"] or 0.0
    rows = []
    prev_counters = json.loads(prev["counters"]) if prev else {}
    for key, c in counters.items():
        p = prev_counters.get(key)
        if p is None:
            continue  # 第一次看到這個計數器，還沒有差值
        dp = c.get("prompt", 0) - p.get("prompt", 0)
        dg = c.get("generation", 0) - p.get("generation", 0)
        if dp < 0 or dg < 0:  # 服務重開，計數器歸零
            dp, dg = c.get("prompt", 0), c.get("generation", 0)
        if dp or dg:
            kind, _port, model = key.split(":", 2)
            rows.append({"source": "local", "uid": "%s:%s:%d" % (m["name"], key, ts), "ts": int(ts),
                         "model": model, "project": m["name"], "session": kind,
                         "input": int(dp), "output": int(dg), "cost_usd": 0.0,
                         "requests": 0})  # 計數器只有 token 總數，不知道是幾個請求
    proxied = 0
    if prev:
        proxied = db.execute("SELECT COUNT(*) FROM usage WHERE source = 'local' AND project = ? "
                             "AND ts > ? AND ts <= ?", (m["name"], prev["ts"], ts)).fetchone()[0]
    # Ollama 每處理完一個請求就把 expires_at 往後推（= 最後使用時間 + keep_alive），
    # 所以 expires_at 變了就表示這段時間有人在用，不需要 proxy 也看得出來。
    prev_loaded = json.loads(prev["loaded"]) if prev else []
    prev_exp = {(x.get("service"), x.get("port"), x.get("name")): x.get("expires_at") for x in prev_loaded}
    touched = any(x.get("expires_at") and prev_exp.get((x["service"], x["port"], x["name"]))
                  and x["expires_at"] > prev_exp[(x["service"], x["port"], x["name"])] + 1
                  for x in loaded)
    # 沒有更好的訊號時才看 GPU 使用率；Mac 的 GPU 使用率包含畫面繪製，不能拿來判斷
    busy_gpu = any(g["vendor"] != "apple" and (g["util"] or 0) >= AI_GPU_UTIL for g in gpus)
    active = bool(rows or running or proxied or touched or (loaded and busy_gpu))
    plug = read_plug(m["plug"]) if m.get("plug") else None
    power = plug if plug is not None else estimate_power(m, gpu_power, util, pct)
    # 畫面要用的細節：每張 GPU、整台記憶體、負載、每個服務
    detail = {"gpus": gpus, "mem_used": d.get("mem_used"), "mem_total": d.get("mem_total"),
              "load": d.get("load"), "ncpu": d.get("ncpu"),
              "services": [{"kind": x["kind"], "port": x["port"], "running": x["running"],
                            "models": [mo["name"] for mo in x["models"]]} for x in d.get("services") or []]}
    db.execute("INSERT OR REPLACE INTO samples (machine, ts, cpu_raw, cpu_pct, gpu_util, gpu_mem_used, "
               "gpu_mem_total, gpu_power_w, power_w, ai_active, loaded, counters, detail) "
               "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
               (m["name"], int(ts), json.dumps(cpu) if cpu and cpu[0] == "raw" else None, pct, util,
                mem_used, mem_total, gpu_power, power, int(active), json.dumps(loaded),
                json.dumps(counters), json.dumps(detail)))
    add_usage(db, rows)
    return rows


# ---- 找機器（--discover）

def ssh_config_hosts(path="~/.ssh/config"):
    """~/.ssh/config 裡的 Host 名稱（移植自 slurmtop 84cd35d）：萬用字元、否定、Match 區塊略過。"""
    try:
        with open(os.path.expanduser(path), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return []
    hosts = []
    for ln in text.splitlines():
        m = re.match(r"^\s*host\s*(?:=|\s)\s*(.+?)\s*$", ln.split("#", 1)[0], re.I)
        if not m:
            continue
        for h in m.group(1).split():
            h = h.strip('"')
            if h and not re.search(r"[*?!]", h) and h not in hosts:
                hosts.append(h)
    return hosts


def tailscale_peers():
    """Tailscale 上的其他機器：[(名稱, IP, 作業系統, 是否在線)]。沒裝 Tailscale 就是空的。"""
    exe = shutil.which("tailscale") or "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
    if not os.path.exists(exe) and not shutil.which("tailscale"):
        return []
    try:
        d = json.loads(run_cmd([exe, "status", "--json"], timeout=10) or "{}")
    except ValueError:
        return []
    out = []
    for p in (d.get("Peer") or {}).values():
        ips = [ip for ip in p.get("TailscaleIPs") or [] if "." in ip]
        name = (p.get("HostName") or p.get("DNSName") or "").split(".")[0]
        if ips and name:
            out.append((name, ips[0], (p.get("OS") or "").lower(), bool(p.get("Online"))))
    return out


def try_ssh(host, timeout=8):
    """能不能不經提示就用 ssh 登入；回傳 (成功, 系統資訊或錯誤原因)。"""
    errs = []
    out = run_cmd(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "--", host,
                   "uname -sm; command -v nvidia-smi /usr/lib/wsl/lib/nvidia-smi 2>/dev/null | head -1"],
                  timeout=timeout, errors=errs)
    if out.strip():
        lines = untrusted(out).strip().splitlines()
        return True, lines[0] + (" + NVIDIA" if len(lines) > 1 else "")
    return False, errs[-1] if errs else "no answer"


def discover():
    """候選機器：ssh config 的 Host、Tailscale 上在線的 Linux／macOS 機器（同一台優先用 IP，
    因為 known_hosts 裡常常只記了 IP）。同時試連，回傳每台的結果。"""
    cands = []
    for h in ssh_config_hosts():
        cands.append({"name": re.sub(r"[^\w-]", "-", h), "host": h, "via": "ssh config"})
    have = {c["host"] for c in cands}
    for name, ip, os_, online in tailscale_peers():
        match = [c for c in cands if c["host"] in (name, ip)]
        for c in match:
            c["via"] += " + tailscale"
            if re.match(r"^[\d.]+$", c["host"]):  # ssh config 裡寫的是 IP：名字用 Tailscale 上的
                c["name"] = name
        # 只有 ssh config 沒寫到、而且在線的 Linux／macOS 才另外加進來（手機、Windows 通常沒有 sh）
        if not match and online and os_ in ("linux", "macos", "darwin", "freebsd") and ip not in have:
            cands.append({"name": name, "host": ip, "via": "tailscale"})
    configured = {m["host"] for m in machines()}
    results = [None] * len(cands)

    def work(i, c):
        ok, info = try_ssh(c["host"])
        results[i] = dict(c, ok=ok, info=info, hint="" if ok else ssh_hint(info),
                          configured=c["host"] in configured)
    threads = [threading.Thread(target=work, args=(i, c), daemon=True) for i, c in enumerate(cands)]
    for th in threads:
        th.start()
    for th in threads:
        th.join(15)
    return [r for r in results if r]


def render_discover(found):
    if not found:
        return "No candidates found in ~/.ssh/config or Tailscale."
    lines = []
    for r in found:
        mark = "ok " if r["ok"] else "-- "
        state = r["info"] if r["ok"] else "%s%s" % (r["info"], ("; " + r["hint"]) if r["hint"] else "")
        lines.append("%s %s %s %s%s" % (mark, cell(r["name"], 18), cell(r["host"], 22), state,
                                        "  (already in config)" if r["configured"] else ""))
    new = [r for r in found if r["ok"] and not r["configured"]]
    if new:
        lines += ["", "Add these under [machines] in %s:" % os.path.join(config_dir(), "config.ini"), ""]
        lines += ["%s = %s" % (r["name"], r["host"]) for r in new]
    return "\n".join(lines)


def add_machines(found, with_power=True):
    """把 discover 找到、連得上、還沒設定的機器寫進 [machines]，再依硬體填功耗建議值。回傳加了哪些。"""
    have = {m["name"] for m in machines()}
    changes, added = [], []
    for r in found:
        if not r.get("ok") or r.get("configured"):
            continue
        name = r["name"]
        n = 2
        while name in have:
            name = "%s-%d" % (r["name"], n)
            n += 1
        have.add(name)
        changes.append(("machines", name, r["host"]))
        sug = {}
        if with_power:
            d = snapshot(r["host"], [])
            if d:
                sug, _why = suggest_power(d)
        for k, v in sorted(sug.items()):
            changes.append(("machine." + name, k, "%g" % v))
        added.append({"name": name, "host": r["host"], "power": sug})
    if changes:
        write_config(changes)
    return added


def sample_machines(db, only=None, timeout=25):
    """所有機器同時取樣（一台卡住不會拖慢其他台），寫進帳本。回傳 {名稱: 取樣或 None}。"""
    ms = [m for m in machines() if not only or m["name"] in only]
    results = {}

    def work(m):
        try:
            results[m["name"]] = snapshot(m["host"], m["services"])
        except Exception:
            results[m["name"]] = None
    threads = [threading.Thread(target=work, args=(m,), daemon=True) for m in ms]
    for t in threads:
        t.start()
    deadline = time.time() + timeout
    for t in threads:
        t.join(max(0.0, deadline - time.time()))
    ts = int(now())
    for m in ms:
        d = results.get(m["name"])
        if d:
            record_sample(db, m, d, ts)
            machine_errors.pop(m["name"], None)
        else:
            why = ssh_errors.get(m["host"]) or "no data"
            hint = ssh_hint(why)
            machine_errors[m["name"]] = "%s (%s): cannot read: %s%s" % (
                m["name"], m["host"], why, ("; " + hint) if hint else "")
    db.commit()
    return {m["name"]: results.get(m["name"]) for m in ms}


