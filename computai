            (sym("\u25cb", "o") + " " + T("idle") if theme().get("flat") else dim(sym("\u25cb", "o") + " " + T("idle")))
        names = ", ".join("%s%s" % (x["name"], dim(" %s MB" % format(x["vram_mb"], ",")) if x.get("vram_mb") else "")
                          for x in models) or dim(T("no_model"))
        rate = ""
        req, tok_s = svc.get("requests", m["recent"]["requests"]), svc.get("tok_s", m["recent"]["tok_s"])
