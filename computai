def cloud_settings(cp=None):
    cp = cp or load_config()
    return {"idle_util": _float(cp.get("cloud", "idle_gpu_util", fallback="5"), 5.0),
            "idle_minutes": _float(cp.get("cloud", "idle_alert_minutes", fallback="20"), 20.0),
            "ssh_user": cp.get("cloud", "ssh_user", fallback="").strip(),
            "max_gap_hours": _float(cp.get("cloud", "max_gap_hours", fallback="6"), 6.0)}


def ssh_gpu_util(inst, user):
    """API 沒給 GPU 使用率（Lambda）時，用 SSH 到機器上跑 nvidia-smi 讀。"""
    if not inst.get("ip") or not user or not re.match(r"^[\w.-]+$", user + inst["ip"]):
        return None
    d = snapshot("%s@%s" % (user, inst["ip"]), [])
    utils = [g["util"] for g in (d or {}).get("gpus", []) if g["util"] is not None]
    return sum(utils) / len(utils) if utils else None


def fetch_clouds(only=None):
    """有設定金鑰的平台都問一次。回傳 (機器清單, 錯誤訊息)。"""
    cs = cloud_settings()
    insts, errors = [], []
    for name, env, fn in CLOUDS:
        if only and name not in only:
            continue
        key = secret(env)
        if not key and not os.environ.get("COMPUTAI_FIXTURES"):
            continue
        try:
            got = fn(key or "")
        except ApiError as e:
            errors.append(str(e))
            continue
        for i in got:
            if i["billing"] and i["gpu_util"] is None and cs["ssh_user"]:
                i["gpu_util"] = ssh_gpu_util(i, cs["ssh_user"])
        insts += got
    return insts, errors


def record_cloud(db, insts, ts):
    """存一次快照，並把上一次快照到現在的計費時間記成 cloud 用量（金額照每小時價格算）。"""
    cs = cloud_settings()
    rows = []
    for i in insts:
        prev = db.execute("SELECT * FROM cloud WHERE provider = ? AND id = ? ORDER BY ts DESC LIMIT 1",
                          (i["provider"], i["id"])).fetchone()
        db.execute("INSERT OR REPLACE INTO cloud (provider, id, ts, name, status, billing, gpu, gpu_count, "
                   "usd_per_hour, gpu_util) VALUES (?,?,?,?,?,?,?,?,?,?)",
                   (i["provider"], i["id"], int(ts), i["name"], i["status"], int(i["billing"]), i["gpu"],
                    i["gpu_count"], i["usd_per_hour"], i["gpu_util"]))
        # 停機的機器可能還在收儲存費，所以看費率，不看 billing（billing 是「GPU 在計費」）
        if not prev or not prev["usd_per_hour"]:
            continue
        dt = ts - prev["ts"]
        if dt <= 0 or dt > cs["max_gap_hours"] * 3600:
            continue  # 隔太久沒看，中間發生什麼不知道，不亂算
        hours = dt / 3600.0
        rows.append({"source": "cloud", "uid": "%s:%s:%d" % (i["provider"], i["id"], ts), "ts": int(ts),
                     "model": "%s x%d" % (prev["gpu"], prev["gpu_count"] or 1),
                     "project": "%s/%s" % (i["provider"], prev["name"]), "session": i["id"],
                     "requests": 0, "cost_usd": round(prev["usd_per_hour"] * hours, 6),
                     "input": 0, "output": 0})
    add_usage(db, rows)
    db.commit()
    return rows


def cloud_alerts(db, t=None):
    """最重要的警示：機器還在計費，GPU 卻閒著。只在讀得到使用率時判斷。"""
    t = now() if t is None else t
    cs = cloud_settings()
    out = []
    latest = db.execute("SELECT c.* FROM cloud c JOIN (SELECT provider, id, MAX(ts) AS ts FROM cloud "
                        "GROUP BY provider, id) x ON c.provider = x.provider AND c.id = x.id "
                        "AND c.ts = x.ts").fetchall()
    for r in latest:
        if not r["billing"] or t - r["ts"] > 3600:
            continue
        if r["gpu_util"] is None:
            out.append({"kind": "cloud_unknown_util", "provider": r["provider"], "id": r["id"],
                        "message": "%s %s is billing %s/h; GPU use unknown (set [cloud] ssh_user)"
                        % (r["provider"], r["name"], fmt_usd(r["usd_per_hour"]))})
            continue
        if r["gpu_util"] >= cs["idle_util"]:
            continue
        since = r["ts"]
        for p in db.execute("SELECT ts, billing, gpu_util FROM cloud WHERE provider = ? AND id = ? "
                            "AND ts < ? ORDER BY ts DESC LIMIT 500", (r["provider"], r["id"], r["ts"])):
            if not p["billing"] or p["gpu_util"] is None or p["gpu_util"] >= cs["idle_util"]:
                break
            since = p["ts"]
        idle = t - since
        if idle >= cs["idle_minutes"] * 60:
            wasted = (r["usd_per_hour"] or 0) * idle / 3600
            out.append({"kind": "cloud_idle_billing", "provider": r["provider"], "id": r["id"],
                        "idle_minutes": int(idle // 60), "usd_per_hour": r["usd_per_hour"],
                        "wasted_usd": round(wasted, 2),
                        "message": "%s %s: GPU idle for %s but still billing %s/h (%s so far)"
                        % (r["provider"], r["name"], fmt_dur(idle), fmt_usd(r["usd_per_hour"]),
                           fmt_usd(wasted))})
    return out


def latest_cloud(db):
    return [dict(r) for r in db.execute(
        "SELECT c.* FROM cloud c JOIN (SELECT provider, id, MAX(ts) AS ts FROM cloud GROUP BY provider, id) x "
        "ON c.provider = x.provider AND c.id = x.id AND c.ts = x.ts "
        "WHERE c.ts >= ? ORDER BY c.provider, c.name", (now() - 86400,))]


def render_cloud(insts, alerts=None, errors=None):
    lines = ["%-28s %-10s %-18s %9s %8s" % ("Cloud GPUs", "status", "GPU", "$/hour", "GPU use")]
    for i in insts:
        lines.append("%s %-10s %s %9s %8s" % (
            cell("%s/%s" % (i["provider"], i["name"]), 28), cell(i["status"], 10),
            cell("%s x%d" % (i["gpu"], i["gpu_count"] or 1), 18),
            fmt_usd(i["usd_per_hour"]) if i["billing"] else "-",
            "-" if i["gpu_util"] is None else "%d%%" % round(i["gpu_util"])))
    for e in errors or []:
        lines.append("  " + e)
    for a in alerts or []:
        lines.append("! " + a["message"])
    return "\n".join(lines)


def sample_clouds(db, only=None):
    insts, errors = fetch_clouds(only)
