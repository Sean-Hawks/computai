CARD_PERIODS = ("30d", "month", "year", "all")
CARD_THEMES = {
    "dark": {"bg": "#0d1117", "border": "#30363d", "title": "#67e8f9", "label": "#8b949e", "value": "#e6edf3",
             "bar": "#67e8f9"},
    "light": {"bg": "#ffffff", "border": "#d0d7de", "title": "#0969da", "label": "#57606a", "value": "#1f2328",
              "bar": "#0969da"},
}
CARD_FILES = {"dark": "computai-card.svg", "light": "computai-card-light.svg"}


def card_data(db, period="30d", prices=None, plan_table=None, t=None):
    """卡片要的數字。預設看最近 30 天（含今天）：滾動的區間，月初也不會是空的。"""
    if period not in CARD_PERIODS:
        raise SystemExit("computai: bad period %r, expected one of %s" % (period, ", ".join(CARD_PERIODS)))
    t = now() if t is None else t
    today = datetime.date(*time.localtime(t)[:3])
    tomorrow = today + datetime.timedelta(days=1)
    end = local_ts(tomorrow.year, tomorrow.month, tomorrow.day)
    if period == "30d":
        s = tomorrow - datetime.timedelta(days=30)
        start, kind = local_ts(s.year, s.month, s.day), "range"
    elif period == "month":
        start, kind = local_ts(today.year, today.month, 1), "range"
    elif period == "year":
        start, kind = local_ts(today.year, 1, 1), "range"
    else:
        start, kind = 0, "range"
    w = wrapped(db, start, end, period, kind, prices, plan_table if plan_table is not None else {}, compare=False, t=t)
    daily = dict(w["daily"])
    if period in ("30d", "month"):
        days = [today - datetime.timedelta(days=i) for i in range(13, -1, -1)]
        bars, bars_key = [daily.get(d.isoformat(), 0.0) for d in days], "cd_bars_days"
    else:
        months = []
        y, mo = today.year, today.month
        for _ in range(12):
            months.append("%04d-%02d" % (y, mo))
            y, mo = (y - 1, 12) if mo == 1 else (y, mo - 1)
        months.reverse()
        bars = [round(sum(v for d, v in daily.items() if d[:7] == m_), 2) for m_ in months]
        bars_key = "cd_bars_months"
    return {"period": period, "tokens": w["tokens"], "api_equivalent_usd": w["api_equivalent_usd"],
            "top_model": w["top_models"][0]["model"] if w["top_models"] else None,
            "active_days": w["active_days"], "longest_streak": w["longest_streak"],
            "bars": bars, "bars_key": bars_key}


