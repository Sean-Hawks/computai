def claude_settings_path():
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    base = env.split(",")[0].strip() if env else os.path.join(os.path.expanduser("~"), ".claude")
    return os.path.join(base, "settings.json")


def claude_statusline():
    """Claude Code 設定裡的 statusLine 指令（只讀這一個欄位）；沒有就是 None。"""
    try:
        with open(claude_settings_path(), encoding="utf-8") as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    sl = d.get("statusLine") if isinstance(d, dict) else None
    return sl.get("command") if isinstance(sl, dict) else None


def doctor(db, sample=True):
    """檢查每個來源和每台機器，回傳 [{area, level: ok|tip|todo, text, fix}]。"""
    out = []
    add = lambda area, level, text, fix="": out.append({"area": area, "level": level, "text": text, "fix": fix})
    t = now()
    # 訂閱的 log
    roots = claude_roots()
    n_claude = sum(1 for r in roots for _ in walk_files(r))
    if n_claude:
        add("claude", "ok", T("dr_logs") % ("Claude Code", n_claude))
    else:
        add("claude", "tip", T("dr_nologs") % ("Claude Code", "~/.claude/projects"))
    home = codex_home()
    n_codex = sum(1 for sub in ("sessions", "archived_sessions") if os.path.isdir(os.path.join(home, sub))
                  for _ in walk_files(os.path.join(home, sub)))
    if n_codex:
        add("codex", "ok", T("dr_logs") % ("Codex", n_codex))
    else:
        add("codex", "tip", T("dr_nologs") % ("Codex", "~/.codex/sessions"))
    # 月費
    current = plans()
    used = {r[0] for r in db.execute("SELECT DISTINCT source FROM usage WHERE ts > ?", (t - 60 * 86400,))}
    for src in SUBSCRIPTION_SOURCES:
        if src not in used and src not in current:
            continue
        det = detected_plan(db, src)
        if src in current:
            p_ = current[src]
            msg = T("dr_plan") % (src, p_["name"], fmt_usd(p_["usd"]))
            if det and det.lower().replace(" ", "") not in p_["name"].lower().replace(" ", ""):
                add("plans", "tip", msg + " - " + T("dr_plan_det") % det, "computai --setup")
            else:
                add("plans", "ok", msg)
        else:
            add("plans", "todo", T("dr_noplan") % (src, (" (" + T("dr_plan_det") % det + ")") if det else ""),
                "computai --setup")
    # Claude 的額度百分比
    if n_claude:
        sl = claude_statusline()
        if sl and "computai" in sl:
            add("claude", "ok", T("dr_sl_ok"))
        elif sl:
            add("claude", "tip", T("dr_sl_other"), "docs/one-line.md")
        else:
            add("claude", "todo", T("dr_sl_none"), "computai --setup")
    # 機器
    ms = machines()
    snaps = sample_machines(db) if (sample and ms) else {}
    for m in ms:
        name = m["name"]
        d = snaps.get(name)
        if sample and not d:
            add("machine:" + name, "todo", machine_errors.get(name, T("dr_unreach") % name),
                "ssh -o BatchMode=yes %s true" % m["host"] if m["host"] != "local" else "")
            continue
        bits = []
        if d:
            g = d.get("gpus") or []
            bits.append(", ".join(sorted({x.get("model") or x.get("vendor") for x in g})) or T("no_gpu"))
            svcs = ["%s:%d" % (x["kind"], x["port"]) for x in d.get("services") or []]
            if svcs:
                bits.append(" ".join(svcs))
        add("machine:" + name, "ok", "%s (%s)" % (name, "; ".join(bits)) if bits else name)
        measured = d and any(x.get("power") is not None for x in d.get("gpus") or [])
        if m.get("plug"):
            add("machine:" + name, "ok", T("dr_pw_plug") % m["plug"])
        elif m.get("max_watts") or m.get("idle_watts") or (measured and m.get("base_watts")):
            add("machine:" + name, "ok", T("dr_pw_set"))
        elif d:
            sug, why = suggest_power(d)
            fix = "computai " + " ".join("--set machine.%s.%s=%g" % (name, k, v) for k, v in sorted(sug.items()))
            add("machine:" + name, "todo" if not measured else "tip",
                (T("dr_pw_gpu") if measured else T("dr_pw_none")) % why, fix)
        if d and any(x["kind"] == "ollama" for x in d.get("services") or []):
            add("machine:" + name, "tip", T("dr_ollama"), "computai --proxy --machine %s" % name)
    if not ms:
        add("machines", "tip", T("dr_nomachines"), "computai --discover --add")
    # 電價
    ps = power_settings()
    if ps["currency"] != "USD" and not ps["usd_to_local"]:
        add("power", "todo", T("dr_rate") % ps["currency"], "computai --set general.usd_to_local=32")
    else:
        add("power", "ok", T("dr_power") % ("time-of-use" if ps["tou"] else "%g %s/kWh" % (ps["price_per_kwh"], ps["currency"])))
    # 價目表
    s = summary(db, t - 30 * 86400, t + 1, plan_table={})
    if s["unpriced_models"]:
        add("prices", "tip", T("dr_unpriced") % ", ".join(s["unpriced_models"]),
            os.path.join(config_dir(), "prices.ini"))
    # 金鑰
    sec = os.path.join(config_dir(), "secrets.ini")
    if os.path.exists(sec) and os.name != "nt" and os.stat(sec).st_mode & 0o077:
        add("secrets", "todo", T("dr_perm"), "chmod 600 " + sec)
    keys = [env for _n, env, _f in CLOUDS if secret(env)] + [k for k in ("ANTHROPIC_ADMIN_KEY", "OPENAI_ADMIN_KEY")
                                                              if secret(k)]
    if keys:
        add("secrets", "ok", T("dr_keys") % ", ".join(keys))
    return out


def render_doctor(items):
    mark = {"ok": rgb(GREEN, sym("\u2714", "ok")), "tip": rgb(AMBER, sym("\u25b2", "!")),
            "todo": rgb(RED, sym("\u2716", "x"))}
    groups = {}
    for x in items:  # 同一類放在一起，照第一次出現的順序
        groups.setdefault(x["area"].split(":")[0].rstrip("s") if x["area"].startswith("machine") else
                          x["area"].split(":")[0], []).append(x)
    lines = []
    for area, xs in groups.items():
        lines.append(bold(T("dr_area").get(area, area)))
        for x in xs:
            lines.append("  %s %s" % (mark[x["level"]], x["text"]))
            if x["fix"]:
                lines.append("      %s %s" % (dim(sym("\u2192", "->")), rgb(CYAN, x["fix"])))
    todo = sum(1 for x in items if x["level"] == "todo")
    lines.append("")
    lines.append(T("dr_all_ok") if not todo else T("dr_todo") % todo)
    return "\n".join(lines)


