            "kwh": round(sum(r["kwh"] for r in machine_report(db, start, end)), 3),
            "total_cost_usd": s["total_cost_usd"]}


def getpass_user():
    import getpass
    try:
        return getpass.getuser()
    except Exception:
        return "me"


def lab(folder):
    """讀資料夾裡所有 --totals 的 JSON。回傳 (每個人的列, 合計)。看不懂的檔案略過。"""
    rows = []
    for name in sorted(os.listdir(folder)):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(folder, name), encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and d.get("computai_totals") == 1:
            rows.append(d)
    srcs = sorted({k for r in rows for k in r.get("sources", {})})
    total = {"who": "total", "month": ",".join(sorted({str(r.get("month")) for r in rows})),
             "sources": {k: {"cost_usd": round(sum(r["sources"].get(k, {}).get("cost_usd", 0) for r in rows), 2),
                             "tokens": sum(r["sources"].get(k, {}).get("tokens", 0) for r in rows)} for k in srcs},
             "kwh": round(sum(r.get("kwh") or 0 for r in rows), 3),
             "total_cost_usd": round(sum(r.get("total_cost_usd") or 0 for r in rows), 2)}
    return rows, total, srcs


def render_lab(rows, total, srcs):
    if not rows:
        return "No computai --totals files in that folder."
    head = "%s %-8s" % (cell("who", 16), "month") + "".join(" %12s" % cell(s, 12) for s in srcs) + " %9s %12s" % (
        "kWh", "total")
    lines = [head]
    for r in rows + [total]:
        lines.append("%s %-8s" % (cell(str(r.get("who")), 16), str(r.get("month"))[:8]) +
                     "".join(" %12s" % fmt_usd(r["sources"].get(s, {}).get("cost_usd", 0)) for s in srcs) +
                     " %9.2f %12s" % (r.get("kwh") or 0, fmt_usd(r.get("total_cost_usd"))))
    return "\n".join(lines)


