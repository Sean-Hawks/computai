def publish_card(db, period, path, push=False, prices=None, plan_table=None):
    """把深色和淺色兩張卡片寫進本機的 git repo（例如 <帳號>/<帳號> 那個個人頁 repo）並 commit。
    不加 --push 就絕對不會推出去。回傳要印給使用者看的每一行；失敗丟 SystemExit。"""
    root = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(root):
        raise SystemExit("computai: %s is not a folder" % root)
    if not shutil.which("git"):
        raise SystemExit("computai: git is not installed")

    def git(*a):
        return subprocess.run(["git", "-C", root] + list(a), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              universal_newlines=True)

    def fail(what, r):
        lines = [x for x in (r.stderr or r.stdout or "").strip().splitlines() if x.strip()]
        raise SystemExit("computai: %s failed: %s" % (what, lines[-1] if lines else "exit %d" % r.returncode))

    if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
        raise SystemExit("computai: %s is not a git repository" % root)
    c = card_data(db, period, prices, plan_table)
    names = [CARD_FILES["dark"], CARD_FILES["light"]]
    lines = []
    for theme, name in (("dark", names[0]), ("light", names[1])):
        with open(os.path.join(root, name), "w", encoding="utf-8") as f:
            f.write(render_card_svg(c, theme))
        lines.append("wrote %s" % os.path.join(root, name))
    r = git("add", "--", *names)
    if r.returncode:
        fail("git add", r)
    if git("diff", "--cached", "--quiet", "--", *names).returncode == 0:
        lines.append("the cards did not change, so nothing was committed")
    else:
        msg = "Update ComputAI card (%s)" % T("cd_" + period)
        r = git("commit", "-q", "-m", msg, "--", *names)
        if r.returncode:
            fail("git commit", r)
        lines.append("committed %s in %s: %s" % (git("rev-parse", "--short", "HEAD").stdout.strip(), root, msg))
    if push:
        r = git("push")
        if r.returncode:
            fail("git push", r)
        lines.append("pushed with `git push`")
    else:
        lines.append("did not push (add --push to push)")
    return lines


