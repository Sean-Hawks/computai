def svg_escape(s):
    import html
    return html.escape(str(s), quote=True)


SVG_FONT = "ui-monospace,SFMono-Regular,Menlo,Consolas,'Noto Sans Mono CJK TC','PingFang TC',monospace"


def svg_text(x, y, text, size, fill, anchor="start", weight="400", spacing=0, opacity=1):
    """一行 SVG 文字；內容一律跳脫。"""
    return ('<text x="%s" y="%s" font-size="%s" fill="%s" text-anchor="%s" font-weight="%s"%s%s>%s</text>'
            % (x, y, size, fill, anchor, weight, (' letter-spacing="%s"' % spacing) if spacing else "",
               (' opacity="%s"' % opacity) if opacity != 1 else "", svg_escape(text)))


def svg_bars(values, x, y, w, h, fill, gap=3, min_h=3):
    """迷你長條圖：values 平均分在寬度 w 裡，最高的那根撐滿 h；0 的畫一條很短的底線。"""
    if not values:
        return ""
    top = max(values) or 1.0
    bw = max(1.0, (w - gap * (len(values) - 1)) / float(len(values)))
    out = []
    for i, v in enumerate(values):
        bh = max(min_h, h * v / top) if v > 0 else min_h
        out.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" rx="1" fill="%s"%s/>'
                   % (x + i * (bw + gap), y + h - bh, bw, bh, fill, "" if v > 0 else ' opacity="0.25"'))
    return "".join(out)


def clip_text(s, n):
    s = str(s)
    return s if len(s) <= n else s[:n - 1] + "…"


