    "6": "111 100 111 101 111", "7": "111 001 001 010 010", "8": "111 101 111 101 111",
    "9": "111 101 111 001 111", "%": "101 001 010 100 101", "$": "011 110 010 011 110",
    ".": "000 000 000 000 010", ":": "000 010 000 010 000", "-": "000 000 111 000 000",
    "/": "001 001 010 100 100", "k": "100 101 110 101 101", "M": "101 111 111 101 101",
    "h": "100 100 111 101 101", "m": "000 000 111 111 101", "d": "001 001 111 101 111",
    "W": "101 101 111 111 101", "x": "000 101 010 101 000", " ": "000 000 000 000 000",
}


def bigtext(s):
    """把數字和少數符號畫成 3 列高的大字（回傳 3 個字串）；字型裡沒有的字元當空白。
    ASCII 模式用 # 和空白畫（一樣 3 列）。"""
    rows = ["", "", ""]
    for ch in s:
        g = BIG_FONT.get(ch, BIG_FONT[" "]).split() + ["000"]
        for r in range(3):
            top, bot = g[2 * r], g[2 * r + 1]
            for a, b in zip(top, bot):
                if _ascii:
                    rows[r] += "#" if a == "1" or b == "1" else " "
                else:
                    rows[r] += {"11": "\u2588", "10": "\u2580", "01": "\u2584", "00": " "}[a + b]
            rows[r] += " "
    return [r[:-1] for r in rows]


def braille(vals, width, top=None, rows=1, color=None):
    """點字走勢圖：一格 2 個取樣 × 4 個點高，比 ▁▂▃ 細四倍；rows 可以疊好幾列。
    從底部填滿（面積圖）。沒有資料的地方留白；ASCII 模式退回一般走勢。"""
    if _ascii:
        return [spark(vals, width, top=top or 100.0, color=color)] + [""] * (rows - 1)
    v = [x for x in (vals or [])][-(width * 2):]
    known = [x for x in v if x is not None]
    top = top or (max(known) if known else 1.0) or 1.0
    v = [None] * (width * 2 - len(v)) + v
    levels = rows * 4
    h = [None if x is None else max(1 if x > 0 else 0, int(round(min(1.0, x / top) * levels))) for x in v]
    # 點字的點位：左欄 1 2 3 7（上到下），右欄 4 5 6 8
    left, right = (0x01, 0x02, 0x04, 0x40), (0x08, 0x10, 0x20, 0x80)
    out = []
    for r in range(rows):
        base = (rows - 1 - r) * 4      # 這一列從第幾個點高開始
        line = ""
        for c in range(width):
            code = 0
            for col, bits in ((h[2 * c], left), (h[2 * c + 1], right)):
                if col is None:
                    continue
                fill = max(0, min(4, col - base))
                for k in range(fill):
                    code |= bits[3 - k]
            line += chr(0x2800 + code)
        out.append(rgb(color or CYAN, line))
    return out


def gauge(pct, width, level="brand", marker=None):
    """粗的量表（額度用）：有顏色時用背景色塗滿整格，比細線長條醒目；marker（0-100）畫一條白線標出
    這個週期過了多久。沒有顏色時用 █ 和 ░，ASCII 用 # 和 .，標記都是 |。"""
    pct = max(0.0, min(100.0, pct or 0.0))
    filled = int(round(pct / 100 * width))
    if pct > 0 and filled == 0:
        filled = 1
    mk = None if marker is None else min(width - 1, int(marker / 100.0 * width))
    out = []
    for i in range(width):
        on = i < filled
        if _color:
            c = tone(level) if on else (40, 44, 50)
            ch, fg = ("\u2503", "38;2;245;246;247;") if i == mk else (" ", "")
            out.append("\033[%s48;2;%d;%d;%dm%s\033[0m" % (fg, c[0], c[1], c[2], ch))
        else:
            out.append("|" if i == mk else ("#" if _ascii else "\u2588") if on else ("." if _ascii else "\u2591"))
    return "".join(out)


def temp_color(t):
    if theme().get("flat"):
        return RED if t >= 90 else AMBER if t >= 80 else MAG
    return heat(max(0, min(100, (t - 35) / 50 * 100)))


def gradbar(pct, width=12, level=None):
    """長條。classic：每一格依位置做熱度漸層；cyber：實心粗量表，整條一個顏色（見 docs/DESIGN.md）。"""
    if theme().get("flat") and not _ascii and _color:
        # cyber：▆（下方 3/4 的方塊）畫的粗長條，上面留一點縫，上下兩列的長條才不會黏成一塊
        pct = max(0.0, min(100.0, pct or 0.0))
        filled = int(round(pct / 100 * width)) or (1 if pct > 0 else 0)
        return rgb(tone(level or "brand"), "\u2586" * filled) + rgb((40, 44, 50), "\u2586" * (width - filled))
    if theme().get("flat"):
        return gauge(pct, width, level or "brand")
    pct = max(0.0, min(100.0, pct or 0.0))
    filled = int(round(pct / 100 * width))
    _, full, empty, lcap, rcap, _box = glyphs()
    one = tone(level) if level else None
    cells = [rgb(one or heat((i + 1) / width * 100), full) if i < filled else rgb(GREY, empty) for i in range(width)]
    return lcap + "".join(cells) + rcap


def spark(vals, width=12, top=100.0, color=None, relative=False):
    """歷史走勢（預設 0-100 用熱度上色）。relative=True 時依這段資料的最小到最大值縮放
    （功耗、花費這種沒有固定上限的量），一律用 color 這一個顏色，平的時候畫在中間。"""
    if theme().get("flat") and not _ascii:  # cyber：點字走勢，解析度高四倍
        vv = [x for v in (vals or [])[-width:] for x in (v, v)]  # 一個取樣佔一整格（兩個點寬），寬度和原本一樣
        return braille(vv, width, top=None if relative else top, color=color)[0]
    chars = glyphs()[0]
    dot = "." if _ascii else "\u00b7"
    v = [x for x in (vals or [])][-width:]
    if not v:
        return rgb(GREY, dot * width)
    known = [x for x in v if x is not None]
    lo, hi = 0.0, top
    if relative and known:
        lo, hi = min(known), max(known)
        if hi - lo < 1e-9:
            lo, hi = lo - 1, hi + 1
        lo = max(0.0, lo - (hi - lo) * 0.15)
    out = [rgb(GREY, dot)] * (width - len(v))
    for x in v:
        if x is None:
            out.append(rgb(GREY, dot))
            continue
        pct = max(0.0, min(100.0, 100.0 * (x - lo) / (hi - lo))) if hi > lo else 0.0
        idx = min(len(chars) - 1, int(pct / 100 * (len(chars) - 1) + 0.5))
        out.append(rgb(color or heat(pct), chars[idx]))
    return "".join(out)


def clip(s, width):
    """裁到可見寬度；顏色碼不算寬度、也不會被切斷。"""
    if vlen(s) <= width:
        return s
    out, w, i = [], 0, 0
    while i < len(s) and w < width:
        if s[i] == "\033":
            j = s.find("m", i)
            if j == -1:
                break
            out.append(s[i:j + 1])
            i = j + 1
            continue
        cw = 2 if unicodedata.east_asian_width(s[i]) in ("W", "F") else 1
        if w + cw > width:
            break
        out.append(s[i])
        w += cw
        i += 1
    return "".join(out) + ("\033[0m" if "\033" in s else "")


def pad(s, width):
    return s + " " * max(0, width - vlen(s))


def panel(left, right, lines, width, load=0.0, foot="", level=None):
    """面板＝標題列／主體／來源列：標題在上框線左邊、狀態在右邊，來源寫在下框線上。
    classic 的框線顏色跟著負載（0-100）走；cyber 的框線是安靜的細線，只有 level="fail" 時變紅。"""
    tl, tr, bl, br, h, v = glyphs()[5]
    inner = max(10, width - 2)
    o, c = (" ", " ") if _ascii else theme()["title"]
    left = edge_title(o, load) + left + edge_title(c, load)
    right = (" %s " % right) if right else ""
    if vlen(left) + vlen(right) + 2 > inner:
        right = clip(right, max(0, inner - vlen(left) - 2))
    fill = max(0, inner - vlen(left) - vlen(right) - 2)
    if level:
        col = tone(level) if level == "fail" or not theme().get("flat") else GREY
    else:
        col = GREY if theme().get("flat") else heat(load)
    edge = lambda s: rgb(col, s)
    rows = [edge(tl + h * 2) + left + edge(h * fill) + right + edge(tr)]
    for ln in lines:
        rows.append(edge(v) + pad(clip(ln, inner), inner) + edge(v))
    foot = (" %s " % foot) if foot else ""
    if vlen(foot) > inner - 2:
        foot = clip(foot, inner - 2)
    rows.append(edge(bl + h * 2) + foot + edge(h * max(0, inner - 2 - vlen(foot)) + br) if foot
                else edge(bl + h * inner + br))
    return rows


def wrap(text, width, indent=""):
    """依顯示寬度折行（全形字算兩格）；英文在空白處斷，中文可以在任何字之間斷。"""
    out, line = [], ""
    for word in re.split(r"(\s+)", text):
        if not word:
            continue
        if vlen(line) + vlen(word) <= width:
            line += word
        elif word.isspace():
            out.append(line.rstrip())
            line = indent
        elif vlen(indent + word) > width or not all(ord(c) < 128 for c in word):
            for ch in word:  # 太長的字或中文：逐字放，放不下就換行
                if vlen(line) + vlen(ch) > width:
                    out.append(line.rstrip())
                    line = indent
                line += ch
        else:
            out.append(line.rstrip())
            line = indent + word
    if line.strip():
        out.append(line.rstrip())
    return out or [""]


