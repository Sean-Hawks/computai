    return panel(left, right, lines, width, load, foot=foot)


def limit_label(name):
    """額度視窗的白話名稱：5h -> 5 小時額度、week -> 每週額度。"""
    return T("win").get(name, name)


def limit_note(r):
    """額度下面那一行：已用完就講重置時間，用太快就講幾點用完，不然講重置時大約到幾 %。"""
    used = r["used_percent"] or 0
    reset = fmt_dur(r["resets_in"]) if r.get("resets_in") is not None else None
    if used >= LIMIT_FAIL:
        return rgb(RED, T("q_wait") % reset) if reset else ""
    if r.get("eta_full"):
        return rgb(AMBER, T("q_eta") % (fmt_dur(r["eta_full"]), reset))
    if r.get("projected_pct") is not None:
        return dim(T("q_proj") % {"pct": r["projected_pct"], "reset": reset})
    return dim(T("resets") % reset) if reset else ""


def ptitle(n, text):
    """面板標題。cyber：品牌色的 ◢ 加兩位數編號，像儀器上的通道號碼；classic 就是粗體字。"""
    if not theme().get("flat"):
        return bold(text)
    return rgb(CYAN, sym("\u25e2", ">")) + dim("%02d" % n) + " " + bold(text)


def hud_tiles(tiles, width, gap=3):
    """大字讀數一格一格橫著排，放不下就換到下一排。每格是幾列字串（同寬）。"""
    out, row, used = [], [], 0
    for t in tiles:
        w = max(vlen(x) for x in t)
        if row and used + gap + w > width:
            out += side_by_side_many(row, gap)
            out.append("")
            row, used = [], 0
        row.append(t)
        used += (gap if used else 0) + w
    if row:
        out += side_by_side_many(row, gap)
    return out


def side_by_side_many(blocks, gap):
    n = max(len(b) for b in blocks)
    widths = [max(vlen(x) for x in b) for b in blocks]
    return [(" " * gap).join(pad(b[i] if i < len(b) else "", w) for b, w in zip(blocks, widths)).rstrip()
            for i in range(n)]


def hero_panel(st, width, frame=0):
    """[01] 最上面的大字讀數：每個額度一格（大字百分比、粗量表、速度），加上今天的用量價值和本地推論速度。
    最重要的數字最大——這是整個畫面的主角。"""
    tiles = []
    limits = sorted(st["limits"], key=lambda r: -(r["used_percent"] or 0))
    tw = 26
    for r in limits:
        used = r["used_percent"] or 0
        lv = limit_level(used)
        big = bigtext("%d%%" % round(used))
        col = tone(lv) if lv != "brand" else MAG
        label = "%s %s" % (T("src").get(r["source"], r["source"]), limit_label(r["name"]))
        state = (" " + bold(rgb(RED, T("used_up")))) if used >= LIMIT_FAIL else ""
        note = limit_note(r)
        w = max(tw, vlen(big[0]))
        tiles.append([dim(cell(label, w - vlen(state)) ) + state] + [bold(rgb(col, x)) for x in big] +
                     [gauge(used, w, lv, r.get("elapsed_pct"))] + wrap_colored(note, w))
    today = bigtext(fmt_usd(st["today_usd"]).replace(",", ""))
    tiles.append([dim(T("h_today"))] + [bold(rgb(CYAN, x)) for x in today] + [""] +
                 [dim(T("h_month") % fmt_usd(st["total_cost_usd"]))])
    rate = sum(m["recent"]["tok_s"] for m in st["machines"])
    busy = [m for m in st["machines"] if m["ai_active"]]
    if rate:
        spin = "\u280b\u2819\u2839\u2838\u283c\u2834\u2826\u2827\u2807\u280f"[frame % 10] if not _ascii else "*"
        tiles.append([dim(T("h_rate"))] + [bold(rgb(GREEN, x)) for x in bigtext("%d" % round(rate))] + [""] +
                     [rgb(GREEN, spin + " " + T("h_busy") % len(busy))])
    elif st["machines"]:
        watts = sum(m["power_w"] or 0 for m in st["machines"])
        tiles.append([dim(T("h_power"))] + [bold(x) for x in bigtext("%d" % round(watts))] + [""] +
                     [dim(T("machine_1") if len(st["machines"]) == 1 else T("machines_n") % len(st["machines"]))])
    main, extra = tiles[:len(limits) + 1], tiles[len(limits) + 1:]
    fits = sum(max(vlen(x) for x in t) + 3 for t in main + extra) <= width - 4
    lines = [" " + x for x in hud_tiles(main + (extra if fits else []), width - 4)]  # 次要的格子放得下才放
    have = {r["source"] for r in limits}
    for x in st["sources"]:
        if x["source"] in SUBSCRIPTION_SOURCES and x["source"] not in have:
            name = T("src").get(x["source"], x["source"])
            for i, ln in enumerate(wrap(T("q_unlinked"), max(20, width - vlen(name) - 6))):
                lines.append(" %s  %s" % (bold(name) if i == 0 else " " * vlen(name), dim(ln)))
    full = sum(1 for r in limits if (r["used_percent"] or 0) >= LIMIT_FAIL)
    high = sum(1 for r in limits if LIMIT_WARN <= (r["used_percent"] or 0) < LIMIT_FAIL)
    state = rgb(RED, T("n_used_up") % full) if full else rgb(AMBER, T("n_high") % high) if high else ""
    foot = dim(T("q_foot").replace("\u2503", sym("\u2503", "|"))) if any(r.get("elapsed_pct") is not None for r in limits) else ""
    return panel(ptitle(1, T("q_title")), state, lines, width, 0, foot=foot, level="fail" if full else None)


def wrap_colored(text, width):
    """有顏色的一句話折行：去掉色碼折行後，每一行套回第一個顏色。"""
    if not text:
        return [""]
    m = re.match(r"(\033\[[0-9;]*m)", text)
    plain = re.sub(r"\033\[[0-9;]*m", "", text)
    rows = wrap(plain, width)
    return [(m.group(1) + r + "\033[0m") if m else r for r in rows]


def quota_panel(st, width):
    """額度：每個訂閱的每個視窗一條粗量表，後面是大大的百分比，下一行用白話講速度和重置時間。
    有用量卻沒有額度資料的訂閱（通常是 Claude 沒接 statusLine）也列出來，告訴你怎麼接。"""
    lines = []
    limits = sorted(st["limits"], key=lambda r: (r["source"], r["window_minutes"] or 0))
    have = {r["source"] for r in limits}
    names = {id(r): "%s %s" % (T("src").get(r["source"], r["source"]), limit_label(r["name"])) for r in limits}
    name_w = min(28, max([vlen(n) for n in names.values()] + [12]))
    gw = max(10, min(48, width - name_w - 14))
    for r in limits:
        used = r["used_percent"] or 0
        lv = limit_level(used)
        name = names[id(r)]
        pct = T("used_up") if used >= LIMIT_FAIL else "%d%%" % round(used)
        pct = bold(rgb(tone(lv), pct)) if lv != "brand" else bold(pct)
        lines.append(" %s %s  %s" % (cell(name, name_w), gauge(used, gw, lv, r.get("elapsed_pct")), pct))
        note = limit_note(r)
        if note:
            lines.append(" " * (name_w + 2) + note)
    for x in st["sources"]:
        if x["source"] in SUBSCRIPTION_SOURCES and x["source"] not in have:
            lines.append(" %s %s" % (cell(T("src").get(x["source"], x["source"]), name_w), dim(T("q_unlinked"))))
    if not lines:
        return []
    full = sum(1 for r in limits if (r["used_percent"] or 0) >= LIMIT_FAIL)
    high = sum(1 for r in limits if LIMIT_WARN <= (r["used_percent"] or 0) < LIMIT_FAIL)
    state = rgb(RED, T("n_used_up") % full) if full else rgb(AMBER, T("n_high") % high) if high else ""
    foot = dim(T("q_foot").replace("\u2503", sym("\u2503", "|"))) if any(r.get("elapsed_pct") is not None for r in limits) else ""
    return panel(bold(T("q_title")), state, lines, width, 0, foot=foot, level="fail" if full else None)


