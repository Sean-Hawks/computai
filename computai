def pick_range(args):
    if args.since or args.until:
        start = parse_day(args.since) if args.since else 0
        end = parse_day(args.until) + 86400 if args.until else int(now()) + 1
        label = "%s..%s" % (args.since or "", args.until or "")
        return start, end, label
    return month_range(args.month or None)


def emit(obj, text, as_json):
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))   # JSON 會把控制字元跳脫掉
    else:
        # 專案路徑、模型、機器名稱來自 log 和別的機器；資料夾名稱裡的 ESC 序列可以改終端機的畫面、
        # 標題或剪貼簿，所以文字輸出一律去掉控制字元
        print(untrusted(text))


def main(argv=None):
    args = parse_args(argv)
    if args.paths:
        print("config: " + config_dir())
        print("ledger: " + data_dir())
        return 0
    first = ensure_config()
    if first and not (args.json or args.setup or args.statusline or args.line or args.mcp) and sys.stderr.isatty():
        sys.stderr.write("computai: first run - settings are in %s. Run `computai --setup` to tailor them "
                         "(plans, machines, power), or `computai --doctor` to see what is detected.\n" % config_dir())
    db = open_ledger()
    try:
        return run(args, db)
    finally:
        db.close()


def default_machine():
    for m in machines():
        if m["host"] == "local":
            return m["name"]
    return local_hostname()


def local_hostname():
    return socket.gethostname().split(".")[0] or "local"


ACTIONS = ("setup", "doctor", "set", "unset", "sync", "summary", "line", "statusline", "sample", "cloud", "proxy", "analyze", "live", "web",
           "watch", "notify_test", "install_watch", "uninstall_watch", "bench",
           "report", "once", "discover", "csv", "mcp", "recap", "wrapped", "card", "weekly", "wake", "totals", "lab")


def config_theme(cp=None):
    cp = cp or load_config()
    return (cp.get("general", "theme", fallback="cyber") or "cyber").strip().lower()


def run(args, db):
    set_style(theme=args.theme or config_theme())
    if args.set or args.unset:
        changes = [parse_assignment(a) for a in args.set]
        for a in args.unset:
            if "." not in a:
                raise SystemExit("computai: expected SECTION.KEY, got %r" % a)
            sec, key = a.rsplit(".", 1)
            changes.append((sec.strip(), key.strip(), None))
        changed = write_config(changes)
        print("computai: %s %s" % ("updated" if changed else "no change to", os.path.join(config_dir(), "config.ini")))
        return 0
    set_lang(args.lang or config_lang())
    asked = (args.payback is not None or any(getattr(args, a) for a in ACTIONS) or args.json
             or args.html or args.month is not None or args.since or args.until or args.by != "model")
    if not asked and sys.stdout.isatty() and sys.stdin.isatty():
        args.live = True  # 在終端機裡只打 computai 就是 live 畫面；帶了其他選項就照選項做
    if args.once:
        if not args.no_sync:
            sync(db, quiet=True)
            if machines():
                sample_machines(db)
        st = clean_strings(dict(dashboard_state(db), insights=insights(db)))
        if args.json:
            emit(st, "", True)
        else:
            cols = shutil.get_terminal_size((120, 40)).columns
            print(render_live(st, cols, use_color(), ascii_=not can_draw_blocks()))
        return 0
    if args.live:
        db.close()
        intro = not args.no_intro and (load_config().get("general", "intro", fallback="yes") or "yes").strip().lower() \
            not in ("no", "false", "0", "off")
        return run_live(args.interval, args.sample_every, intro)
    if args.web:
        db.close()
        return serve_web(args.web, args.interval, args.sample_every)
    if args.watch:
        db.close()
        return run_watch(args.interval, args.sample_every)
    if args.bench:
        b = bench(db, [args.machine] if args.machine else None)
        emit(b, render_bench(b), args.json)
        return 0
    if args.notify_test:
        settings = notify_settings()
        if not (settings["desktop"] or settings["chat"]):
            print("computai: notifications are off ([notify] desktop / chat in config.ini)")
            return 1
        deliver([("ok", T("nt_test"))], settings)
        print("computai: sent (%s)" % ", ".join(k for k, v in settings.items() if v))
        return 0
    if args.install_watch or args.uninstall_watch:
        what, where = watch_service(install=bool(args.install_watch))
        print("computai: --watch %s: %s" % (what, where))
        return 0
    if args.proxy:
        db.close()
        return serve_proxy(args.listen, args.upstream, args.machine or default_machine(),
                           args.sample_every, not args.no_usage_injection, False if args.no_ledger else None)
    if args.statusline:
        add_limits(db, claude_statusline_limits(read_statusline_stdin(), now()), only_changes=True)
        db.commit()
        args.line = True
    if args.wake:
        mac, addr = wake(args.wake)
        print("computai: sent a wake-up packet to %s (%s via %s)" % (args.wake, mac, addr))
        return 0
    if args.mcp:
        return serve_mcp(db)
    if args.setup:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            raise SystemExit("computai: --setup asks questions, so it needs a terminal; "
                             "use --doctor and --set in scripts")
        if not args.no_sync:
            sync(db, quiet=True)
        set_style(use_color(), not can_draw_blocks())
        try:
            return Setup(db).run()
        except (KeyboardInterrupt, EOFError):
            print("\n" + T("su_cancel"))
            return 1
    if args.doctor:
        if not args.no_sync:
            sync(db, quiet=True)
        set_style(use_color(), not can_draw_blocks())
        items = doctor(db, sample=not args.no_sync)
        emit(items, render_doctor(items), args.json)
        return 0
    if args.discover:
        found = discover()
        if args.add:
            added = add_machines(found)
            text = render_discover(found).split("\n\n")[0]
            text += "\n\n" + ("\n".join("added %s = %s%s" % (a["name"], a["host"], (" (" + ", ".join(
                "%s=%g" % kv for kv in sorted(a["power"].items())) + ")") if a["power"] else "") for a in added)
                               if added else "nothing new to add")
            emit({"found": found, "added": added}, text, args.json)
            return 0
        emit(found, render_discover(found), args.json)
        return 0
    if args.cloud:
        insts, errors = sample_clouds(db)
        if not args.summary and not args.sample:
            al = cloud_alerts(db)
            emit({"cloud": insts, "errors": errors, "alerts": al}, render_cloud(insts, al, errors)
                 if insts or errors else "No cloud GPUs (set RUNPOD_API_KEY, VAST_API_KEY or LAMBDA_API_KEY).",
                 args.json)
            return 0
    if args.sample:
        sample_machines(db)
        if not args.summary:
            start, end, label = pick_range(args)
            rep, al = machine_report(db, start, end), machine_alerts() + idle_alerts(db)
            emit({"machines": rep, "alerts": al}, render_machines(rep, al), args.json)
            return 0
    if args.line:
        if not args.no_sync:
            maybe_sync(db)
        info = line_parts(db)
        emit(info, render_line(info, args.sep), args.json)
        return 0
    if args.payback is not None:
        r = payback(db, args.payback, args.gpu_watts, args.hours_per_day, args.rent_per_hour)
        emit(r, render_payback(r), args.json)
        return 0 if not r.get("error") else 1
    if args.weekly:
        if not args.no_sync:
            sync(db, quiet=True)
        text = untrusted(weekly(db))
        print(text)
        if args.send:
            res = send_report(text)
            if not res:
                warn("nothing to send to: set DISCORD_WEBHOOK_URL or TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID")
                return 1
            for name, ok_, msg in res:
                print("computai: %s %s (%s)" % (name, "sent" if ok_ else "failed", msg))
            return 0 if all(r[1] for r in res) else 1
        return 0
    if args.wrapped is not None:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label, kind = wrapped_period(args.wrapped)
        w = wrapped(db, start, end, label, kind)
        wrote = False
        for path, render in ((args.html, render_wrapped_html), (args.svg, render_wrapped_svg)):
            if path:
                with open(path, "w", encoding="utf-8") as f:
                    f.write(render(w))
                print("computai: wrote %s" % path)
                wrote = True
        if wrote:
            return 0
        emit(w, render_wrapped(w), args.json)
        return 0
    if args.card:
        if not args.no_sync:
            sync(db, quiet=True)
        if args.push and not args.publish:
            raise SystemExit("computai: --push only works together with --card --publish PATH")
        c = card_data(db, args.period)
        if args.publish:
            for line in publish_card(db, args.period, args.publish, args.push):
                print("computai: " + line)
            if not args.svg:
                return 0
        if args.svg:
            with open(args.svg, "w", encoding="utf-8") as f:
                f.write(render_card_svg(c, args.card_theme))
            print("computai: wrote %s" % args.svg)
        elif args.json:
            emit(c, "", True)
        else:
            sys.stdout.write(render_card_svg(c, args.card_theme))
        return 0
    if args.recap is not None:
        if not args.no_sync:
            sync(db, quiet=True)
        r = recap(db, args.recap or time.localtime(now()).tm_year)
        if args.html:
            with open(args.html, "w", encoding="utf-8") as f:
                f.write(render_recap_html(r))
            print("computai: wrote %s" % args.html)
            return 0
        emit(r, render_recap(r), args.json)
        return 0
    if args.lab:
        rows, total, srcs = lab(args.lab)
        emit({"people": rows, "total": total}, render_lab(rows, total, srcs), args.json)
        return 0
    if args.totals:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label = pick_range(args)
        with open(args.totals, "w", encoding="utf-8") as f:
            json.dump(totals(db, start, end, label, args.who), f, ensure_ascii=False, indent=1)
        print("computai: wrote %s" % args.totals)
        return 0
    if args.csv:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label = pick_range(args)
        n = export_csv(db, start, end, args.csv)
        print("computai: wrote %d rows to %s" % (n, args.csv))
        return 0
    if args.report or args.html:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label = pick_range(args)
        r = report_data(db, start, end, label)
        if args.html:
            with open(args.html, "w", encoding="utf-8") as f:
                f.write(render_report_html(r))
            print("computai: wrote %s" % args.html)
            return 0
        emit(r, render_report_text(r), args.json)
        return 0
    if args.analyze:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label = pick_range(args)
        a = analyze(db, start, end, label)
        emit(a, render_analysis(a), args.json)
        return 0
    if args.sync:
        added = sync(db, quiet=args.json)
        if args.json and not args.summary:
            print(json.dumps({"added": added}))
        if not args.summary:
            return 0
    elif not args.no_sync:
        sync(db, quiet=True)
    start, end, label = pick_range(args)
    s = summary(db, start, end, label=label)
    s["limits"] = current_limits(db)
    text = render_summary(s)
    if s["limits"]:
        text += "\n\n" + render_limits(s["limits"])
    s["machines"] = machine_report(db, start, end)
    s["cloud"] = latest_cloud(db)
    s["alerts"] = idle_alerts(db) + cloud_alerts(db)
    if s["machines"]:
        text += "\n\n" + render_machines(s["machines"])
    if s["cloud"]:
        text += "\n\n" + render_cloud(s["cloud"])
    if s["alerts"]:
        text += "\n\nAlerts\n" + "\n".join("! " + a["message"] for a in s["alerts"])
    if args.by != "model":
        s["by_" + args.by] = breakdown(db, start, end, args.by)
        text += "\n\n" + render_breakdown(s["by_" + args.by], args.by)
    emit(s, text, args.json)
    return 0


if __name__ == "__main__":
    sys.exit(main())
