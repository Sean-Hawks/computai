LIMIT_WARN, LIMIT_FAIL = 80.0, 99.5
QUOTA_PANEL = True  # 額度有自己的面板（quota_panel），訂閱面板就只講錢


def verdict(st):
    """畫面最上面那一句：現在有沒有事。回傳等級（ok／warn／fail）、等級的字、
    依嚴重程度排好的事情清單（每件是 (等級, 白話句子)）。終端機和網頁共用這一份判斷。"""
    items = []
    for r in st.get("limits") or []:
        used = r["used_percent"] or 0
        src, win = T("src").get(r["source"], r["source"]), limit_label(r["name"])
        reset = fmt_dur(r["resets_in"]) if r.get("resets_in") is not None else None
        if used >= LIMIT_FAIL:
            items.append(("fail", T("v_used_up") % (src, win, reset) if reset else T("v_used_up_nr") % (src, win)))
        elif used >= LIMIT_WARN:
            items.append(("warn", T("v_high_r") % (src, win, round(used), reset) if reset
                          else T("v_high") % (src, win, round(used))))
    for a in st.get("alerts") or []:
        k = a["kind"]
        if k == "machine_unreachable":
            items.append(("fail", T("v_down") % a["machine"]))
        elif k == "cloud_idle_billing":
            items.append(("fail", T("v_cloud_idle") % ("%s %s" % (a["provider"], a.get("name") or a["id"]),
                                                       fmt_usd(a["usd_per_hour"]))))
        elif k == "idle_model":
            items.append(("warn", T("v_idle") % a["machine"]))
        else:
            items.append(("warn", a["message"]))
    f = st.get("forecast") or {}
    if f.get("over_budget"):
        items.append(("fail", T("v_budget") % (fmt_usd(f["projected_usd"]), fmt_usd(f["budget_usd"]))))
    items.sort(key=lambda x: x[0] != "fail")  # 穩定排序：fail 在前，同等級保持原順序
    level = items[0][0] if items else "ok"
    return {"level": level, "word": T("v_" + level), "items": items}


def hud_header(st, width, clock, frame=0):
    """cyber 的標頭：◢◤ C O M P U T A I ◥◣ 加副標，右邊是時間、在線機器數和全部機器的功耗心電圖。"""
    logo = rgb(CYAN, sym("\u25e2\u25e4 ", "// ")) + bold(rgb(CYAN, " ".join("COMPUTAI"))) + \
        rgb(CYAN, sym(" \u25e5\u25e3", " //"))
    left = " " + logo + "  " + dim(T("hud_tag"))
    ms = st["machines"]
    errors = sum(1 for a in st["alerts"] if a["kind"] == "machine_unreachable")
    bits = []
    if ms or errors:
        total = len(ms) + errors
        bits.append(rgb(GREEN if not errors else AMBER, sym("\u25cf ", "* ") + T("h_online") % (len(ms), total)))
        n = max(len(m["history"]["power"]) for m in ms) if ms else 0
        watts = [sum((m["history"]["power"][-n + i] or 0) if len(m["history"]["power"]) >= n - i else 0 for m in ms)
                 for i in range(n)]
        if any(watts):
            bits.append(braille(watts, 8, color=CYAN)[0])
    bits.append(dim(clock))
    right = "  ".join(bits) + " "
    gap = width - vlen(left) - vlen(right)
    return left + " " * gap + right if gap >= 2 else left


def ticker(st, width, frame=0):
    """底部跑馬燈：正在推論的機器、每個額度、今天的用量價值。frame 每加一就往左捲一格。"""
    items = []
    for m in st["machines"]:
        if m["ai_active"]:
            items.append("%s %s" % (m["machine"], T("t_gen") % m["recent"]["tok_s"] if m["recent"]["tok_s"] else T("busy")))
    for r in sorted(st["limits"], key=lambda r: -(r["used_percent"] or 0)):
        txt = "%s %s %d%%" % (T("src").get(r["source"], r["source"]), limit_label(r["name"]), round(r["used_percent"] or 0))
        if r.get("resets_in") is not None:
            txt += sym(" \u00b7 ", " - ") + T("resets") % fmt_dur(r["resets_in"])
        items.append(txt)
    items.append(T("hdr_today") % fmt_usd(st["today_usd"]))
    sep = sym("  \u25c6  ", "  *  ")
    text = sep.join(items) + sep
    chars = list(text)
    k = frame % len(chars) if chars else 0
    chars = chars[k:] + chars[:k]
    loop = "".join(chars)   # 旋轉過的一整圈；不夠寬就整圈重複，接縫才會對
    line = loop
    while vlen(line) < width - 3:
        line += loop
    return rgb(CYAN, sym("\u25b6 ", "> ")) + clip(line, width - 3)


LOGO = (("\u2584\u2580\u2580", "\u2588  ", "\u2580\u2584\u2584"),
        ("\u2584\u2580\u2580\u2584", "\u2588  \u2588", "\u2580\u2584\u2584\u2580"),
        ("\u2588\u2584 \u2584\u2588", "\u2588 \u2580 \u2588", "\u2588   \u2588"),
        ("\u2588\u2580\u2580\u2584", "\u2588\u2584\u2584\u2580", "\u2588   "),
        ("\u2588  \u2588", "\u2588  \u2588", "\u2580\u2584\u2584\u2580"),
        ("\u2580\u2588\u2580", " \u2588 ", " \u2588 "),
        ("\u2584\u2580\u2580\u2584", "\u2588\u2584\u2584\u2588", "\u2588  \u2588"),
        ("\u2580\u2588\u2580", " \u2588 ", "\u2584\u2588\u2584"))


def boot_checks(st):
    """開機畫面的檢查清單，全部來自真的資料：(項目, 狀態, 等級)。"""
    out = [("LEDGER", "OK", "ok")]
    for x in st["sources"]:
        out.append(("LINK  " + T("src").get(x["source"], x["source"]).upper(), fmt_tok(x["tokens"]) + " tok", "ok"))
    for m in st["machines"]:
        gpus = m.get("gpus") or []
        hw = (gpus[0].get("model") or gpus[0].get("vendor") or "GPU") if gpus else "CPU"
        out.append(("NODE  " + m["machine"], ("GENERATING" if m["ai_active"] else "ONLINE") + "  " + hw,
                    "ok"))
    for a in st["alerts"]:
        if a["kind"] == "machine_unreachable":
            out.append(("NODE  " + a["machine"], "OFFLINE", "fail"))
    for r in st["limits"]:
        used = r["used_percent"] or 0
        out.append(("LIMIT %s %s" % (r["source"], r["name"]), "DEPLETED" if used >= LIMIT_FAIL else "%d%%" % round(used),
                    limit_level(used) if used >= LIMIT_WARN else "ok"))
    return out


def render_boot(st, width, height, shown, frame=0):
    """開機畫面：大字標誌、副標，檢查清單一項一項出現（點導引、狀態靠右），最後是準備好的訊息。
    st 還沒來時顯示正在連線。"""
    rows = []
    logo = ["  ".join(L[r] for L in LOGO) for r in range(3)] if not _ascii else ["COMPUTAI", "", ""]
    lw = vlen(logo[0])
    left = max(0, (width - lw) // 2)
    rows += [""] * max(1, height // 6)
    rows += [" " * left + bold(rgb(CYAN, x)) for x in logo]
    sub = T("hud_tag") + "  //  v" + __version__
    rows += ["", " " * max(0, (width - vlen(sub)) // 2) + dim(sub), ""]
    box = min(64, width - 4)
    pad_ = " " * max(0, (width - box) // 2)
    if st is None:
        rows.append(pad_ + rgb(CYAN, spinner()) + " " + T("b_linking"))
        return "\n".join(rows)
    checks = boot_checks(st)
    for name, state, lv in checks[:shown]:
        dots = max(2, box - vlen(name) - vlen(state) - 2)
        rows.append(pad_ + name + " " + rgb(GREY, sym("\u00b7", ".") * dots) + " " + bold(rgb(tone(lv), state)))
    done = shown >= len(checks)
    pct = min(100.0, 100.0 * shown / max(1, len(checks)))
    rows += ["", pad_ + gauge(pct, box, "brand") + " " + dim("%d/%d" % (min(shown, len(checks)), len(checks)))]
    if done:
        v = verdict(st)
        rows += ["", pad_ + (badge(v["level"], v["word"]) if v["level"] != "ok" else rgb(GREEN, sym("\u25cf ", "* ") + v["word"])) +
                 "  " + bold(T("b_ready"))]
    return "\n".join(rows)


def verdict_line(v, width):
    """總結列：等級（正常是綠字；注意、警告是整個畫面唯一的反白色塊）＋最嚴重那件事＋還有幾件。"""
    if v["level"] == "ok":
        return " " + rgb(GREEN, sym("\u25cf ", "* ") + v["word"])
    more = (dim(sym(" \u00b7 ", " | ")) + dim(T("v_more") % (len(v["items"]) - 1))) if len(v["items"]) > 1 else ""
    lead = " " + badge(v["level"], v["word"]) + " "
    text = rgb(tone(v["level"]), v["items"][0][1]) + more
    rows = wrap(v["items"][0][1], max(20, width - vlen(lead) - 1))
    if len(rows) == 1 and vlen(lead + text) <= width:
        return lead + text
    pad_ = " " * vlen(lead)
    return "\n".join((lead if i == 0 else pad_) + rgb(tone(v["level"]), r) for i, r in enumerate(rows)) + \
        ("\n" + pad_ + more.lstrip(" \u00b7|").strip() if more else "")


def header_parts(st):
    """標頭那一行的白話版：每個訂閱最吃緊的額度、重置時間、今天的用量價值。"""
    parts = []
    for p_ in st["line"]["limits"]:
        used = p_["used_percent"]
        txt = T("hdr_limit") % (p_["label"], limit_label(p_["window"]), round(used))
        if used >= 90 and p_["resets_in"] is not None:
            txt += " (" + T("hdr_reset") % fmt_dur(p_["resets_in"]) + ")"
        parts.append(rgb(RED, txt) if used >= 99.5 else txt)
    parts.append(T("hdr_today") % fmt_usd(st["line"]["today_usd"]))
    return parts


def header_text(st):
    return dim(sym(" \u00b7 ", " | ")).join(header_parts(st))


def render_live(st, width=100, color=False, ascii_=False, height=None, theme_name=None, frame=0):
    """整個畫面：上面一行總覽，下面是算力（每台機器、雲端）、AI 用量、警示。
    寬度夠（>= 150）就兩欄：左邊算力，右邊 AI 用量和警示；不夠就上下排。"""
    global _frame
    set_style(color, ascii_, theme_name)
    _frame = frame
    width = max(60, width)
    clock = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(st["time"]))
    if theme().get("flat"):
        head = hud_header(st, width, clock, frame) + "\n" + verdict_line(verdict(st), width)
    else:
        # 標頭三段：品牌和時間／總結列（現在有沒有事）／每個額度和今天的用量價值（在「·」之間換行）
        head = "%s %s  %s\n%s" % (rgb(CYAN, led()), bold("ComputAI"), dim(clock), verdict_line(verdict(st), width))
    sep, rows = dim(sym(" \u00b7 ", " | ")), [""]
    for part in header_parts(st) if not theme().get("flat") else []:  # cyber 的大字讀數已經講了這些
        if rows[-1] and vlen(rows[-1] + sep + part) > width - 1:
            rows.append("")
        rows[-1] += (sep if rows[-1] else "") + part
    head += "".join("\n " + ln for r in rows if r for ln in wrap(r, width - 1))
    two = width >= 150
    col = (width - 2) // 2 if two else width
    errors = {a["machine"]: a for a in st["alerts"] if a["kind"] == "machine_unreachable"}
    energy = {r["machine"]: r for r in st["energy"]}
    left = []
    for m in st["machines"]:
        left += machine_panel(m, col, energy.get(m["machine"]))
    for name, e in errors.items():
        if name not in {m["machine"] for m in st["machines"]}:
            left += machine_panel(None, col, error=e)
    if st["cloud"]:
        left += cloud_panel(st, col)
    right = (local_panel(st, col) if theme().get("flat") else []) + usage_panel(st, col) + alerts_panel(st, col) + \
        advice_panel(st, col)
    used = 4 + len(hero_panel(st, width, frame) if theme().get("flat") else quota_panel(st, width)) + (max(len(left), len(right)) if two else len(left) + len(right)) + 1
    if height and used > height and st["machines"]:
        # 放不下：機器改成一台一列的精簡版（照 slurmtop 的 dense 模式）
        rows = [machine_compact(m, col - 2) for m in st["machines"]]
        rows += [" %s %s" % (rgb(RED, led()), e["message"]) for n, e in errors.items()
                 if n not in {m["machine"] for m in st["machines"]}]
        left = panel(bold(T("machines")), dim(T("compact")), rows, col,
                     max([m["gpu_util"] or 0 for m in st["machines"]] or [0]))
        if st["cloud"]:
            left += cloud_panel(st, col)
    if not left:
        left = panel(bold(T("compute")), "", [dim(" " + T("no_machines"))], col)
    else:
        watts = sum(m["power_w"] or 0 for m in st["machines"])
        billing = sum(c["usd_per_hour"] or 0 for c in st["cloud"] if c["billing"])
        bits = [T("machine_1") if len(st["machines"]) == 1 else T("machines_n") % len(st["machines"])]
        if watts:
            # 全部機器的功耗走勢：各台的歷史從最新一筆往回對齊加總
            n = max(len(m["history"]["power"]) for m in st["machines"])
            total = [sum((m["history"]["power"][-n + i] or 0) if len(m["history"]["power"]) >= n - i else 0
                         for m in st["machines"]) for i in range(n)]
            bits.append(T("power_now") % rgb(MAG, "%.0f W" % watts) + " " + spark(total, 12, color=MAG, relative=True))
        utils = [g["util"] for m in st["machines"] for g in m.get("gpus") or [] if g.get("util") is not None]
        if utils:
            avg = sum(utils) / len(utils)
            bits.append(T("gpu_avg") % rgb(heat(avg), "%d%%" % round(avg)))
        rate = sum(m["recent"]["tok_s"] for m in st["machines"])
        if rate:
            bits.append(rgb(GREEN, "%s tok/s" % rate))
        if st["cloud"]:
            bits.append("cloud " + rgb(MAG, fmt_usd(billing) + "/h"))
        left = [" " + (ptitle(2, T("compute")) if theme().get("flat") else bold(T("compute"))) + "  " +
                dim(sym(" \u00b7 ", " | ")).join(bits)] + left
    body = side_by_side(left, right) if two else left + right
    quota = hero_panel(st, width, frame) if theme().get("flat") else quota_panel(st, width)
    body = quota + ([""] if quota else []) + body  # 額度最重要，放在最上面、整個寬度
    foot = dim(sym(" \u00b7 ", " | ").join(T("foot")))
    if theme().get("flat"):
        foot = ticker(st, width, frame) + "\n" + foot
    return "\n".join([head, ""] + body + [foot])


def can_draw_blocks(stream=None):
    """輸出的編碼畫得出方塊和框線字元嗎（Windows 舊主控台、LANG=C 時畫不出來就用 ASCII）。"""
    enc = getattr(stream or sys.stdout, "encoding", None) or ""
    try:
        "\u2588\u256d\u25c9\u00b0".encode(enc or "ascii")
        return True
    except (LookupError, UnicodeEncodeError):
        return False


def clean_strings(obj):
    """資料裡的字串（專案路徑、模型、機器名稱）去掉控制字元，畫面上的色碼由我們自己加。"""
    if isinstance(obj, str):
        return untrusted(obj)
    if isinstance(obj, list):
        return [clean_strings(x) for x in obj]
    if isinstance(obj, dict):
        return {k: clean_strings(v) for k, v in obj.items()}
    return obj


def run_live(interval, sample_every, intro=True):
    """終端機 live 畫面：q 或 Ctrl-C 離開。資料照 interval 更新，畫面每 0.25 秒重畫一次讓動畫（旋轉指示、
    跑馬燈）會動；重畫時覆寫每一行而不是清畫面，所以不會閃。cyber 主題先播開機畫面，按任意鍵跳過。"""
    color = use_color()
    box = {"st": None}
    lock = threading.Lock()
    upd = Updater(sample_every=sample_every)

    def on_state(st):
        with lock:
            box["st"] = st
    th = threading.Thread(target=upd.run, args=(on_state, interval), daemon=True)
    th.start()
    old_tty = None
    tick = 0.25

    def draw(text, rows):
        lines = text.splitlines()[:rows - 1]
        sys.stdout.write("\033[H" + "".join(ln + "\033[K\n" for ln in lines) + "\033[J")
        sys.stdout.flush()
    try:
        if os.name != "nt" and sys.stdin.isatty():
            import termios
            import tty
            old_tty = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\033[?1049h\033[?25l\033[2J")  # 換到另一個畫面、藏游標，離開時還原
        frame = 0
        ascii_ = not can_draw_blocks()
        if intro and config_theme() == "cyber":
            set_style(color, ascii_, "cyber")
            arrived, shown, end = None, 0, None
            while True:
                with lock:
                    st = box["st"]
                cols, rows = shutil.get_terminal_size((100, 40))
                if st is not None and arrived is None:
                    arrived = time.time()
                if arrived is not None:
                    shown = int((time.time() - arrived) / 0.12) + 1
                    total = len(boot_checks(clean_strings(st)))
                    if shown > total and end is None:
                        end = time.time() + 0.9
                draw(render_boot(clean_strings(st) if st else None, cols, rows, shown, frame), rows)
                if end is not None and time.time() >= end:
                    break
                k = read_key(0.06)
                if k in ("q", "Q"):
                    return 0
                if k:
                    break
                frame += 1
        while True:
            with lock:
                st = box["st"]
            cols, rows = shutil.get_terminal_size((100, 40))
            text = (render_live(clean_strings(st), cols, color, ascii_=ascii_, height=rows, frame=frame) if st
                    else "ComputAI: reading logs and machines...")
            draw(text, rows)
            if read_key(tick) in ("q", "Q"):
                break
            frame += 1
    except KeyboardInterrupt:
        pass
    finally:
        upd.stop.set()
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        if old_tty is not None:
            import termios
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_tty)
    return 0


def read_key(timeout):
    """等 timeout 秒，回傳按下的鍵（沒按就是空字串）。"""
    if os.name == "nt":
        import msvcrt
        end = time.time() + timeout
        while time.time() < end:
            if msvcrt.kbhit():
                return msvcrt.getwch()
            time.sleep(0.03)
        return ""
    if not sys.stdin.isatty():
        time.sleep(timeout)
        return ""
    import select
    r, _, _ = select.select([sys.stdin], [], [], timeout)
    return sys.stdin.read(1) if r else ""


