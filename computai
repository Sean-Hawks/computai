def group_help(p):
    """--help 照用途分組：把已經定義好的選項搬進各組（只影響 help 的排版）。"""
    by_dest = {a.dest: a for a in p._actions}
    for title, dests in HELP_GROUPS:
        g = p.add_argument_group(title)
        for d in dests:
            a = by_dest.get(d)
            if a is None:
                continue
            for other in p._action_groups:
                if a in other._group_actions and other is not g:
                    other._group_actions.remove(a)
            g._group_actions.append(a)


