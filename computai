        if series and any(series):
            lines.append("   %s %s %s" % (dim(cell(T("d14"), 5)), spark(series, len(series), top=max(series), color=CYAN),
                                           dim(T("today_x") % fmt_usd(series[-1]))))
        if x["source"] == "local" and x["tokens"]:
            lines.append(dim("   " + (T("tok_req") % (fmt_tok(x["tokens"]), fmt_tok(x["requests"])) if x["requests"]
                                      else T("tok_only") % fmt_tok(x["tokens"]))))
    for src, rows in lim.items():  # 有額度但這個月還沒有用量的來源
        for r in rows:
            lines.append(" %s %s %3.0f%%" % (bold(cell(T("src").get(src, src), 14)),
                                            gradbar(r["used_percent"], bar_w), r["used_percent"]))
    if not lines:
        lines.append(dim(" " + T("no_usage")))
    f = st["forecast"]
    lines.append("")
    lines.append(" %s %s   %s %s   %s %s" % (dim(T("today")), bold(fmt_usd(st["today_usd"])), dim(T("month")),
                                           bold(fmt_usd(st["total_cost_usd"])), dim(T("forecast")),
                                           bold(rgb(RED if f.get("over_budget") else CYAN,
                                                    fmt_usd(f["projected_usd"])))))
    return panel(bold(T("usage")) + " " + dim(st["month"]), dim(T("api_equiv")), lines, width, 0)


def cloud_panel(st, width):
    lines = []
    for c in st["cloud"]:
        u = c["gpu_util"]
        lines.append(" %s %s %s %s %s" % (cell(rgb(CYAN, "%s/%s" % (c["provider"], c["name"])), 24),
                                          cell("%s x%d" % (c["gpu"], c["gpu_count"] or 1), 16),
                                          gradbar(u or 0, 8), _num(u, "%3.0f%%", "  ?"),
                                          rgb(MAG, fmt_usd(c["usd_per_hour"]) + "/h") if c["billing"] else dim(c["status"])))
    return panel(bold(T("cloud")), "", lines, width, max([c["gpu_util"] or 0 for c in st["cloud"]] or [0]))


def alerts_panel(st, width):
    warn_ = "!" if _ascii else "⚠"
    lines = [" %s %s" % (rgb(RED, warn_), a["message"]) for a in st["alerts"]] or [dim(" " + T("clear"))]
    return panel(bold(T("alerts")), dim("%d" % len(st["alerts"])) if st["alerts"] else "", lines, width,
                 100 if st["alerts"] else 0)


def advice_panel(st, width):
    items = st.get("insights") or []
    if not items:
        return []
    arrow = sym("\u2192", "->")
    return panel(bold(T("advice")), "", [" %s %s" % (rgb(CYAN, arrow), x["text"]) for x in items], width, 0)


def render_live(st, width=100, color=False, ascii_=False, height=None):
    """整個畫面：上面一行總覽，下面是算力（每台機器、雲端）、AI 用量、警示。
    寬度夠（>= 150）就兩欄：左邊算力，右邊 AI 用量和警示；不夠就上下排。"""
    set_style(color, ascii_)
    width = max(60, width)
    led = "o" if _ascii else "◉"
    head = "%s %s  %s   %s" % (rgb(CYAN, led), bold("ComputAI"),
                               dim(time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(st["time"]))), st["line_text"])
    two = width >= 150
    col = (width - 2) // 2 if two else width
    errors = {a["machine"]: a for a in st["alerts"] if a["kind"] == "machine_unreachable"}
    energy = {r["machine"]: r for r in st["energy"]}
    left = []
    for m in st["machines"]:
        left += machine_panel(m, col, energy.get(m["machine"]))
    for name, e in errors.items():
        if name not in {m["machine"] for m in st["machines"]}:
            left += machine_panel(None, col, error=e)
    if st["cloud"]:
        left += cloud_panel(st, col)
    right = usage_panel(st, col) + alerts_panel(st, col) + advice_panel(st, col)
    used = 3 + (max(len(left), len(right)) if two else len(left) + len(right)) + 1
    if height and used > height and st["machines"]:
        # 放不下：機器改成一台一列的精簡版（照 slurmtop 的 dense 模式）
        rows = [machine_compact(m, col - 2) for m in st["machines"]]
        rows += [" %s %s" % (rgb(RED, sym("\u25c9", "o")), e["message"]) for n, e in errors.items()
                 if n not in {m["machine"] for m in st["machines"]}]
        left = panel(bold(T("machines")), dim(T("compact")), rows, col,
                     max([m["gpu_util"] or 0 for m in st["machines"]] or [0]))
        if st["cloud"]:
            left += cloud_panel(st, col)
    if not left:
        left = panel(bold(T("compute")), "", [dim(" " + T("no_machines"))], col)
    else:
        watts = sum(m["power_w"] or 0 for m in st["machines"])
        billing = sum(c["usd_per_hour"] or 0 for c in st["cloud"] if c["billing"])
        bits = [T("machine_1") if len(st["machines"]) == 1 else T("machines_n") % len(st["machines"])]
        if watts:
            # 全部機器的功耗走勢：各台的歷史從最新一筆往回對齊加總
            n = max(len(m["history"]["power"]) for m in st["machines"])
            total = [sum((m["history"]["power"][-n + i] or 0) if len(m["history"]["power"]) >= n - i else 0
                         for m in st["machines"]) for i in range(n)]
            bits.append(rgb(MAG, "%.0f W" % watts) + " " + spark(total, 12, color=MAG, relative=True))
        utils = [g["util"] for m in st["machines"] for g in m.get("gpus") or [] if g.get("util") is not None]
        if utils:
            avg = sum(utils) / len(utils)
            bits.append("GPU " + rgb(heat(avg), "%d%%" % round(avg)))
        rate = sum(m["recent"]["tok_s"] for m in st["machines"])
        if rate:
            bits.append(rgb(GREEN, "%s tok/s" % rate))
        if st["cloud"]:
            bits.append("cloud " + rgb(MAG, fmt_usd(billing) + "/h"))
        left = [" " + bold(T("compute")) + "  " + dim(sym(" \u00b7 ", " | ")).join(bits)] + left
    body = side_by_side(left, right) if two else left + right
    foot = dim(sym(" \u00b7 ", " | ").join(T("foot")))
    return "\n".join([head, ""] + body + [foot])


def can_draw_blocks(stream=None):
    """輸出的編碼畫得出方塊和框線字元嗎（Windows 舊主控台、LANG=C 時畫不出來就用 ASCII）。"""
    enc = getattr(stream or sys.stdout, "encoding", None) or ""
    try:
        "\u2588\u256d\u25c9\u00b0".encode(enc or "ascii")
        return True
    except (LookupError, UnicodeEncodeError):
        return False


def clean_strings(obj):
    """資料裡的字串（專案路徑、模型、機器名稱）去掉控制字元，畫面上的色碼由我們自己加。"""
    if isinstance(obj, str):
        return untrusted(obj)
    if isinstance(obj, list):
        return [clean_strings(x) for x in obj]
    if isinstance(obj, dict):
        return {k: clean_strings(v) for k, v in obj.items()}
    return obj


def run_live(interval, sample_every):
    """終端機 live 畫面：Ctrl-C 或 q 離開。"""
    color = use_color()
    box = {"st": None}
    lock = threading.Lock()
    upd = Updater(sample_every=sample_every)

    def on_state(st):
        with lock:
            box["st"] = st
    th = threading.Thread(target=upd.run, args=(on_state, interval), daemon=True)
    th.start()
    old_tty = None
    try:
        if os.name != "nt" and sys.stdin.isatty():
            import termios
            import tty
            old_tty = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\033[?1049h\033[?25l")  # 換到另一個畫面、藏游標，離開時還原
        while True:
            with lock:
                st = box["st"]
            cols, rows = shutil.get_terminal_size((100, 40))
            text = (render_live(clean_strings(st), cols, color, ascii_=not can_draw_blocks(), height=rows) if st
                    else "ComputAI: reading logs and machines...")
            lines = text.splitlines()[:rows - 1]
            sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n")
            sys.stdout.flush()
            if wait_key(1.0 if st is None else interval):
                break
    except KeyboardInterrupt:
        pass
    finally:
        upd.stop.set()
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        if old_tty is not None:
            import termios
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_tty)
    return 0


def wait_key(timeout):
    """等 timeout 秒；按了 q 回傳 True。"""
    if os.name == "nt":
        import msvcrt
        end = time.time() + timeout
        while time.time() < end:
            if msvcrt.kbhit() and msvcrt.getwch() in ("q", "Q"):
                return True
            time.sleep(0.1)
        return False
    if not sys.stdin.isatty():
        time.sleep(timeout)
        return False
    import select
    r, _, _ = select.select([sys.stdin], [], [], timeout)
    return bool(r) and sys.stdin.read(1) in ("q", "Q")


