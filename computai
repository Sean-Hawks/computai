def _prom_label(v):
    return str(v).replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def prometheus(st):
    """dashboard_state() -> Prometheus 文字格式（格式寫法移植自 slurmtop 84cd35d）。"""
    lines = []

    def metric(name, help_, rows):
        lines.append("# HELP computai_%s %s" % (name, help_))
        lines.append("# TYPE computai_%s gauge" % name)
        for labels, v in rows:
            if v is None:
                continue
            lab = ",".join('%s="%s"' % (k, _prom_label(x)) for k, x in labels.items())
            lines.append("computai_%s%s %s" % (name, "{%s}" % lab if lab else "", repr(float(v))))

    metric("month_cost_usd", "API-equivalent or billed cost this month",
           [({"source": x["source"]}, x["cost_usd"]) for x in st["sources"]])
    metric("month_tokens", "tokens this month (input, cache and output)",
           [({"source": x["source"]}, x["tokens"]) for x in st["sources"]])
    metric("today_cost_usd", "cost recorded today", [({}, st["today_usd"])])
    metric("limit_used_percent", "subscription limit window used",
           [({"source": r["source"], "window": r["name"]}, r["used_percent"]) for r in st["limits"]])
    metric("limit_resets_in_seconds", "seconds until the limit window resets",
           [({"source": r["source"], "window": r["name"]}, r["resets_in"]) for r in st["limits"]])
    metric("machine_cpu_percent", "machine CPU use", [({"machine": m["machine"]}, m["cpu_pct"]) for m in st["machines"]])
    metric("machine_gpu_percent", "machine GPU use", [({"machine": m["machine"]}, m["gpu_util"]) for m in st["machines"]])
    metric("machine_power_watts", "machine power (measured GPU plus configured rest, or estimated)",
           [({"machine": m["machine"]}, m["power_w"]) for m in st["machines"]])
    metric("machine_ai_active", "1 if the machine was doing inference at the last sample",
           [({"machine": m["machine"]}, int(m["ai_active"])) for m in st["machines"]])
    metric("machine_month_kwh", "energy this month", [({"machine": r["machine"]}, r["kwh"]) for r in st["energy"]])
    metric("cloud_usd_per_hour", "cloud instance price while billing",
           [({"provider": c["provider"], "name": c["name"]}, c["usd_per_hour"] if c["billing"] else 0)
            for c in st["cloud"]])
    metric("cloud_gpu_percent", "cloud instance GPU use",
           [({"provider": c["provider"], "name": c["name"]}, c["gpu_util"]) for c in st["cloud"]])
    metric("forecast_month_usd", "projected spend at month end", [({}, st["forecast"]["projected_usd"])])
    metric("alerts", "active alerts by kind", [({"kind": k}, sum(1 for a in st["alerts"] if a["kind"] == k))
                                               for k in sorted({a["kind"] for a in st["alerts"]})])
    return "\n".join(lines) + "\n"


def insights(db, t=None):
    """給畫面用的幾句建議：方案、快取浪費、離峰。都是 --analyze 的摘要。"""
    t = now() if t is None else t
    start, end, _ = month_range()
    out = []
    names = T("src")
    for r in simulate_plans(db, t=t):
        src = names.get(r["source"], r["source"])
        if r["recommend"] and r["options"]:
            best = [o for o in r["options"] if o["name"] == r["recommend"]][0]
            args = {"src": src, "peak": r["peak_percent"] or 0, "win": r["peak_window"] or "?",
                    "plan": best["name"], "usd": best["usd"], "proj": best["projected_peak"]}
            if best["name"] == r["current"]:
                out.append({"kind": "plan", "text": T("i_plan_ok" if best["fits"] else "i_plan_max") % args})
            else:
                out.append({"kind": "plan", "text": T("i_plan_down" if best["usd"] < (r["current_usd"] or 0)
                                                      else "i_plan_up") % args})
        if r.get("api_cheaper"):
            out.append({"kind": "api", "text": T("i_api") % {"src": src, "cost": fmt_usd(r["api_equivalent_usd"])}})
    c = cache_report(db, start, end)
    if c["wasted_usd"] >= 1:
        out.append({"kind": "cache", "text": T("i_cache") % {"cost": fmt_usd(c["wasted_usd"]),
                                                             "expired": c["expired"], "n": c["rewrites"]}})
    for r in machine_report(db, start, end):
        if r.get("offpeak_saving"):
            out.append({"kind": "offpeak", "text": T("i_offpeak") % {"machine": r["machine"],
                                                                     "save": r["offpeak_saving"], "cur": r["currency"]}})
    return out


class Updater:
    """背景更新帳本：log、機器、雲端各有自己的間隔。"""

    def __init__(self, sample_every=60, cloud_every=300, sync_every=30):
        self.every = {"sync": sync_every, "machines": sample_every, "cloud": cloud_every, "insights": 300}
        self.last = {k: 0.0 for k in self.every}
        self.insights = []
        self.stop = threading.Event()

    def tick(self, db):
        t = time.monotonic()
        if t - self.last["sync"] >= self.every["sync"]:
            self.last["sync"] = t
            sync(db, quiet=True)
        if self.every["machines"] > 0 and t - self.last["machines"] >= self.every["machines"] and machines():
            self.last["machines"] = t
            sample_machines(db)
        if self.every["cloud"] > 0 and t - self.last["cloud"] >= self.every["cloud"]:
            self.last["cloud"] = t
            if any(secret(env) for _n, env, _f in CLOUDS):
                sample_clouds(db)

    def run(self, on_state, interval):
        db = open_ledger()
        try:
            while not self.stop.is_set():
                t0 = time.monotonic()
                try:
                    self.tick(db)
                    if time.monotonic() - self.last["insights"] >= self.every["insights"]:
                        self.last["insights"] = time.monotonic()
                        self.insights = insights(db)
                    on_state(dict(dashboard_state(db), insights=self.insights))
                except Exception as e:  # 更新失敗不能讓畫面或伺服器停掉
                    warn("update failed: %r" % (e,))
                self.stop.wait(max(0.5, interval - (time.monotonic() - t0)))
        finally:
            db.close()


