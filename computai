def _ini():
    import configparser
    # 行尾註解（前面要有空白）：`price_per_kwh = 3.2   ; 台電夏月`
    cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=(";", "#"))
    cp.optionxform = str
    return cp


def ensure_config():
    """設定檔目錄裡缺的檔案補上範本；已經存在的檔案不動。"""
    d = config_dir()
    os.makedirs(d, exist_ok=True)
    for name, text in (("config.ini", DEFAULT_CONFIG), ("prices.ini", DEFAULT_PRICES)):
        path = os.path.join(d, name)
        if not os.path.exists(path):
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)


# 這幾段是清單（每行一個方案或一台機器）：使用者的檔案有這一段，就整段以檔案為準，
# 刪掉的那行不會被預設值補回來。其他段是設定值，缺的鍵才用預設值。
LIST_SECTIONS = ("plans", "plan_options", "machines")


def load_config():
    cp = _ini()
    cp.read_string(DEFAULT_CONFIG)
    user = _ini()
    user.read(os.path.join(config_dir(), "config.ini"), encoding="utf-8")
    for sec in user.sections():
        if sec in LIST_SECTIONS and cp.has_section(sec):
            cp.remove_section(sec)
        if not cp.has_section(sec):
            cp.add_section(sec)
        for k, v in user.items(sec, raw=True):
            cp.set(sec, k, v)
    return cp


# ---- 改設定檔（--set、--unset、--setup 都用這個）
#
# 只改到要改的那一行，使用者寫的註解、空行、順序都保留。configparser 寫回去會把註解全部丟掉，所以不用它寫。

SECTION_RE = re.compile(r"^\s*\[([^\]]+)\]\s*$")


def edit_ini(text, section, key, value=None):
    """在 INI 文字裡設定（value 不是 None）或刪除（value 是 None）一個值，回傳新的文字。
    段落不存在就加在最後；鍵不存在就加在那一段最後一個值的後面。"""
    lines = text.splitlines()
    start = end = None
    for i, ln in enumerate(lines):
        m = SECTION_RE.match(ln)
        if m:
            if start is not None and end is None:
                end = i
            if m.group(1).strip() == section:
                start, end = i, None
    if start is None:
        if value is None:
            return text
        body = (text.rstrip("\n") + "\n\n") if text.strip() else ""
        return body + "[%s]\n%s = %s\n" % (section, key, value)
    end = len(lines) if end is None else end
    key_re = re.compile(r"^\s*%s\s*[=:]" % re.escape(key))
    last_value = start
    for i in range(start + 1, end):
        ln = lines[i]
        if key_re.match(ln):
            if value is None:
                del lines[i]
            else:
                lines[i] = "%s = %s" % (key, value)
            return "\n".join(lines) + "\n"
        if ln.strip() and not ln.lstrip().startswith(("#", ";")):
            last_value = i
    if value is None:
        return text
    lines.insert(last_value + 1, "%s = %s" % (key, value))
    return "\n".join(lines) + "\n"


def write_config(changes, path=None):
    """changes：[(section, key, value 或 None)]。改之前先備份成 config.ini.bak。"""
    path = path or os.path.join(config_dir(), "config.ini")
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        text = DEFAULT_CONFIG
    new = text
    for sec, key, value in changes:
        new = edit_ini(new, sec, key, value)
    if new != text:
        if os.path.exists(path):
            shutil.copyfile(path, path + ".bak")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
    return new != text


def parse_assignment(s):
    """`plans.claude=Max 5x, 100` -> ("plans", "claude", "Max 5x, 100")；段落名稱可以有點（machine.wsl.mac）。"""
    if "=" not in s:
        raise SystemExit("computai: expected SECTION.KEY=VALUE, got %r" % s)
    left, value = s.split("=", 1)
    if "." not in left:
        raise SystemExit("computai: expected SECTION.KEY=VALUE, got %r" % s)
    sec, key = left.rsplit(".", 1)
    return sec.strip(), key.strip(), value.strip()


def plans(cp=None):
    """{source: {"name", "usd", "checked"}}，格式錯的那行略過。"""
    cp = cp or load_config()
    out = {}
    if not cp.has_section("plans"):
        return out
    for src, val in cp.items("plans"):
        parts = [p.strip() for p in val.split(",")]
        try:
            usd = float(parts[1])
        except (IndexError, ValueError):
            continue
        out[src] = {"name": parts[0], "usd": usd, "checked": parts[2] if len(parts) > 2 else ""}
    return out


PRICE_KEYS = ("input", "output", "cache_read", "cache_write_5m", "cache_write_1h")


def load_prices(path=None):
    """{model: {input, output, cache_read, cache_write_5m, cache_write_1h, checked, source}}。"""
    cp = _ini()
    if path is None:
        path = os.path.join(config_dir(), "prices.ini")
        if not os.path.exists(path):
            cp.read_string(DEFAULT_PRICES)
    if path and os.path.exists(path):
        cp.read(path, encoding="utf-8")
    out = {}
    for sec in cp.sections():
        row = {"checked": cp.get(sec, "checked", fallback=""), "source": cp.get(sec, "source", fallback="")}
        for k in PRICE_KEYS:
            try:
                row[k] = float(cp.get(sec, k, fallback=""))
            except ValueError:
                row[k] = None
        if row["input"] is None or row["output"] is None:
            continue
        # 沒寫快取價格就退回輸入價格：寧可高估也不要算成免費
        for k in ("cache_read", "cache_write_5m", "cache_write_1h"):
            if row[k] is None:
                row[k] = row["input"]
        out[sec.lower()] = row
    return out


def normalize_model(model):
    """去掉 Claude Code 加的 `[1m]` 這類標記，統一小寫。"""
    m = (model or "").strip().lower()
    if "[" in m:
        m = m.split("[", 1)[0]
    return m


def price_for(model, prices):
    m = normalize_model(model)
    if m in prices:
        return prices[m]
    best = None
    for name in prices:
        if m.startswith(name) and (best is None or len(name) > len(best)):
            best = name
    return prices[best] if best else None


def secret(name):
    """金鑰只從環境變數，或權限 600 的 secrets.ini 讀；權限太寬就不讀。"""
    v = os.environ.get(name)
    if v:
        return v
    path = os.path.join(config_dir(), "secrets.ini")
    if not os.path.exists(path):
        return None
    if os.name != "nt" and os.stat(path).st_mode & 0o077:
        warn("ignoring %s: permissions must be 600 (run: chmod 600 %s)" % (path, path))
        return None
    cp = _ini()
    try:
        cp.read(path, encoding="utf-8")
    except Exception:
        return None
    return cp.get("secrets", name, fallback=None) or None


_warned = set()


def warn(msg):
    if msg not in _warned:
        _warned.add(msg)
        sys.stderr.write("computai: " + msg + "\n")


