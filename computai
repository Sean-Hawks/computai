_lang = "en"


def set_lang(lang):
    global _lang
    _lang = lang if lang in UI else "en"


def T(key):
    return UI[_lang].get(key, UI["en"][key])


def config_lang(cp=None):
    """[general] lang：en、zh，或 auto（預設，照系統語言）。"""
    cp = cp or load_config()
    v = (cp.get("general", "lang", fallback="auto") or "auto").strip().lower()
    return system_lang() if v in ("", "auto") else v[:2]


_sys_lang = None


def system_lang():
    """系統語言是中文就用 zh，否則 en。先看 LC_ALL／LC_MESSAGES／LANG，macOS 再看系統偏好的語言
    （終端機常常沒設 LANG），Windows 看 locale。"""
    global _sys_lang
    forced = os.environ.get("COMPUTAI_LANG", "").strip().lower()[:2]
    if forced in UI:
        return forced
    if _sys_lang is None:
        _sys_lang = "en"
        for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
            v = os.environ.get(k, "")
            if v and v not in ("C", "POSIX") and not v.startswith("C."):
                _sys_lang = "zh" if v.lower().startswith("zh") else "en"
                break
        # macOS 的終端機（cmux、Ghostty 等）常常不管系統語言一律設 LANG=en_US，所以英文不算數，
        # 再看系統偏好的語言；真的想要英文就設 lang = en。
        if _sys_lang == "zh":
            return _sys_lang
        if sys.platform == "darwin" and not os.environ.get("COMPUTAI_FIXTURES"):
            out = run_cmd(["defaults", "read", "-g", "AppleLanguages"], timeout=3)
            first = re.search(r'"?([A-Za-z-]+)"?', out.replace("(", "").strip())
            if first and first.group(1).lower().startswith("zh"):
                _sys_lang = "zh"
        elif os.name == "nt" and not any(os.environ.get(k) for k in ("LC_ALL", "LC_MESSAGES", "LANG")):
            import locale
            try:
                if (locale.getdefaultlocale()[0] or "").lower().startswith("zh"):
                    _sys_lang = "zh"
            except Exception:
                pass
    return _sys_lang


def use_color(stream=None):
    stream = stream or sys.stdout
    return stream.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def _num(v, fmt, none="-"):
    return none if v is None else fmt % v


def machine_compact(m, width):
    """精簡版：一台機器一列（終端機高度不夠放完整面板時用）。"""
    gpus = m.get("gpus") or []
    load = (m["gpu_util"] if m["gpu_util"] is not None else m["cpu_pct"]) or 0.0
    dot = rgb(heat(load), led())
    gu = m["gpu_util"]
    svc = ""
    if m.get("loaded"):
        svc = (rgb(GREEN, sym("\u25cf ", "* ")) if m["ai_active"] else dim(sym("\u25cb ", "o "))) + \
            ", ".join(x["name"] for x in m["loaded"])
    line = " %s %s %s %s %s %s %s %s" % (
        dot, bold(cell(m["machine"], 14)), dim("CPU"), gradbar(m["cpu_pct"] or 0, 8),
        _num(m["cpu_pct"], "%3.0f%%", "  -"), dim("GPU"),
        gradbar(gu or 0, 8) + _num(gu, "%4.0f%%", "   -") if gpus else dim(cell(T("no_gpu"), 15)),
        rgb(MAG, _num(m["power_w"], "%4.0fW", "     ")))
    return clip(line + " " + svc, width)


def machine_panel(m, width, energy=None, error=None):
    """一台機器的面板（版面照 slurmtop 的 node_panel）：標題列有負載燈號和摘要，
    內容是 CPU、記憶體、每張 GPU（長條、走勢、VRAM、溫度、功耗）、功耗走勢、推論服務。"""
    lines = []
    dot = led()
    if error and not m:
        title = "%s %s" % (bold(rgb(CYAN, error["machine"])), rgb(RED, dot))
        return panel(title, "", ["  " + rgb(RED, error["message"].split(": ", 1)[-1])], width, 100)
    gpus = m.get("gpus") or []
    load = (m["gpu_util"] if m["gpu_util"] is not None else m["cpu_pct"]) or 0.0
    where = T("local") if m.get("host") == "local" else T("ssh")
    ai = " " + rgb(GREEN, spinner() + " " + T("busy")) if m["ai_active"] else ""
    stale = (" " + rgb(AMBER, T("ago") % fmt_dur(m["age"]))) if m["age"] > 300 else ""
    if theme().get("flat"):  # cyber：標題只放名字和狀態字，來源（SSH／本機、多久前取樣）放在下框線
        left = "%s%s%s%s" % (rgb(CYAN, sym("\u25e2", ">")), bold(m["machine"]), ai, stale)
        foot = dim("%s %s %s" % (where, sym("\u00b7", "|"), T("sampled") % fmt_dur(m["age"])))
    else:
        left = "%s %s %s %s%s%s" % (dim(T("node")), bold(rgb(CYAN, m["machine"])), rgb(heat(load), dot), dim(where),
                                    " " + rgb(GREEN, "AI") if m["ai_active"] else "", stale)
        foot = ""
    bits = []
    if gpus:
        names = sorted({g.get("model") or g.get("vendor") or "GPU" for g in gpus})
