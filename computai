    const models = loaded.map((x) => x.name + (x.vram_mb ? ` (${x.vram_mb.toLocaleString()} MB)` : "")).join(", ");
    card.append(el("div", {class: "svc"}, el("span", {class: "k"}, `${s.kind}:${s.port}`),
      el("span", {class: (s.busy ?? m.ai_active) ? "ok" : "muted"}, (s.busy ?? m.ai_active) ? "● " + t.busy : "○ " + t.idle),
      el("span", {class: "m"}, models || t.no_model),
      (s.requests ?? m.recent.requests) ? el("span", {class: "muted"}, fmt(t.rate, s.requests ?? m.recent.requests, s.tok_s ?? m.recent.tok_s))
        : (s.tok_s ?? m.recent.tok_s) ? el("span", {class: "muted"}, fmt(t.rate_tok, s.tok_s ?? m.recent.tok_s)) : null));
  }
  if (!m.services.length) card.append(el("div", {class: "muted"}, t.no_server));
  if (m.fits) card.append(el("div", {class: "legend"}, (m.fits.params_b ? fmt(t.fits, m.fits.free_gb, m.fits.params_b + "B")
                                                       : fmt(t.fits_none, m.fits.free_gb)) + (m.fits.multi_gpu ? " " + t.fits_multi : "")));
  return card;
}

