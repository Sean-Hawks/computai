def render_report_html(r):
    import html
    e = html.escape
    s = r["summary"]
    rng = s["range"]
    f = r["analysis"]["forecast"]
    tiles = [("API-equivalent", fmt_usd(s["total_cost_usd"]))]
    for src in s["sources"]:
        tiles.append((src["source"], fmt_usd(src["cost_usd"])))
    tiles = tiles[:5]
    h = ['<!doctype html><html lang="en"><head><meta charset="utf-8">',
         '<meta name="viewport" content="width=device-width, initial-scale=1">',
         '<meta name="color-scheme" content="light dark">',
         "<title>ComputAI %s</title><style>%s</style></head><body>" % (e(rng["label"]), REPORT_CSS),
         "<h1>ComputAI report %s</h1>" % e(rng["label"]),
         '<div class="muted">%s to %s &middot; computai %s</div>' % (
             e(day_label(rng["start"])), e(day_label(rng["end"] - 1)), e(__version__)),
         '<div class="tiles">' + "".join('<div class="tile"><span class="muted">%s</span><b>%s</b></div>'
                                         % (e(k), e(v)) for k, v in tiles) + "</div>"]
    if r["days"]:
        names = {"claude": "Claude Code", "codex": "Codex", "cloud": "Cloud GPUs", "other": "Other"}
        used = [k for k in REPORT_SERIES if any(d[k] for d in r["days"])]
        h.append("<h2>Daily cost</h2>")
        h.append('<div class="legend">' + "".join('<span><i class="s-%s" style="background:var(--s%d)"></i>%s</span>'
                                                  % (k, REPORT_SERIES.index(k) + 1, names[k]) for k in used) + "</div>")
        h.append(_svg_days(r["days"]))
        h.append("<details><summary>Table</summary><div class=\"wrap\"><table><tr><th>Day</th>%s<th>Total</th></tr>"
                 % "".join("<th>%s</th>" % names[k] for k in used))
        for d in r["days"]:
            h.append("<tr><td>%s</td>%s<td>%s</td></tr>" % (
                e(d["day"]), "".join("<td>%s</td>" % fmt_usd(d[k]) for k in used),
                fmt_usd(sum(d[k] for k in REPORT_SERIES))))
        h.append("</table></div></details>")
    h.append("<h2>By model</h2><div class=\"wrap\"><table><tr><th>Model</th><th>Requests</th><th>Input</th>"
             "<th>Cache read</th><th>Cache write</th><th>Output</th><th>Cost</th></tr>")
    for src in s["sources"]:
        for m in src["models"]:
            h.append("<tr><td>%s &middot; %s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" % (
                e(src["source"]), e(m["model"] or "?"), fmt_tok(m["requests"]), fmt_tok(m["input"]),
                fmt_tok(m["cache_read"]), fmt_tok(m["cache_write_5m"] + m["cache_write_1h"]),
                fmt_tok(m["output"]), fmt_usd(m["cost_usd"])))
    h.append("</table></div>")
    plans_ = [src for src in s["sources"] if src.get("plan")]
    if plans_:
        h.append("<h2>Subscriptions</h2><div class=\"wrap\"><table><tr><th>Plan</th><th>Fee</th>"
                 "<th>Usage at API prices</th><th>Value</th></tr>")
        for src in plans_:
            p = src["plan"]
            h.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%sx</td></tr>" % (
                e(p["name"]), fmt_usd(p["fee_in_range"]), fmt_usd(src["cost_usd"]),
                "?" if p["value_ratio"] is None else "%.1f" % p["value_ratio"]))
        h.append("</table></div>")
    if r["projects"]:
        h.append("<h2>Top projects</h2><div class=\"wrap\"><table><tr><th>Project</th><th>Source</th>"
                 "<th>Requests</th><th>Cost</th></tr>")
        for g in r["projects"]:
            h.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" % (
                e(short_path(g["project"])), e(g["source"]), fmt_tok(g["requests"]), fmt_usd(g["cost_usd"])))
        h.append("</table></div>")
    if r["machines"]:
        h.append("<h2>Machines</h2><div class=\"wrap\"><table><tr><th>Machine</th><th>Hours</th><th>kWh</th>"
                 "<th>AI share</th><th>Electricity</th><th>J/token</th></tr>")
        for m in r["machines"]:
            h.append("<tr><td>%s</td><td>%.1f</td><td>%.3f</td><td>%s</td><td>%.2f %s</td><td>%s</td></tr>" % (
                e(m["machine"]), m["covered_hours"], m["kwh"],
                "-" if m["ai_share"] is None else "%d%%" % round(100 * m["ai_share"]),
                m["energy_cost"], e(m["currency"]), "-" if m["j_per_token"] is None else "%.2f" % m["j_per_token"]))
        h.append("</table></div>")
    h.append("<h2>Analysis</h2><pre>%s</pre>" % e(render_analysis(r["analysis"])))
    h.append('<p class="muted">Month-end forecast %s. API-equivalent cost uses the prices in prices.ini.</p>'
             % e(fmt_usd(f["projected_usd"])))
    h.append("</body></html>\n")
    return "\n".join(h)


# ---------------------------------------------------------------- 指令

def parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="computai",
        description="ComputAI - where your compute and AI money goes.")
    p.add_argument("--version", action="version", version="computai " + __version__)
    p.add_argument("--paths", action="store_true", help="print config and ledger locations")
    p.add_argument("--sync", action="store_true", help="import new usage into the ledger")
    p.add_argument("--summary", action="store_true", help="totals for a time range (default: this month)")
    p.add_argument("--month", nargs="?", const="", metavar="YYYY-MM",
                   help="limit to a month (default: this month)")
    p.add_argument("--since", metavar="YYYY-MM-DD", help="start of the range")
    p.add_argument("--until", metavar="YYYY-MM-DD", help="end of the range (inclusive)")
    p.add_argument("--by", choices=["model"] + sorted(BREAKDOWNS), default="model",
                   help="break the summary down by model (default), project, session or day")
    p.add_argument("--sample", action="store_true",
                   help="read every machine in [machines] once (CPU, GPU, power, loaded models)")
    p.add_argument("--cloud", action="store_true",
                   help="list your RunPod, Vast.ai and Lambda GPUs (read-only API calls)")
    p.add_argument("--proxy", action="store_true",
                   help="run a token-counting proxy in front of Ollama or an OpenAI-compatible server")
    p.add_argument("--listen", metavar="[HOST:]PORT", default="127.0.0.1:11435",
                   help="where --proxy listens (default 127.0.0.1:11435)")
    p.add_argument("--upstream", metavar="URL", default="http://127.0.0.1:11434",
                   help="where --proxy forwards to (default http://127.0.0.1:11434)")
    p.add_argument("--machine", metavar="NAME", default=None,
                   help="which machine the proxied tokens belong to (default: the first local one)")
    p.add_argument("--sample-every", type=float, default=60, metavar="SEC",
                   help="while --proxy, --live or --web run, sample machines this often (0 = never)")
    p.add_argument("--no-usage-injection", action="store_true",
                   help="don't add stream_options.include_usage to streaming OpenAI requests")
    p.add_argument("--analyze", action="store_true",
                   help="cache efficiency, month-end forecast, plan advice and off-peak savings")
    p.add_argument("--payback", type=float, metavar="USD",
                   help="how long a GPU costing USD takes to pay for itself versus renting one")
    p.add_argument("--gpu-watts", type=float, default=350.0, metavar="W", help="for --payback (default 350)")
    p.add_argument("--hours-per-day", type=float, default=8.0, metavar="H", help="for --payback (default 8)")
    p.add_argument("--rent-per-hour", type=float, metavar="USD",
                   help="for --payback: cloud price per GPU-hour (default: your cloud history)")
    p.add_argument("--live", action="store_true",
                   help="live terminal dashboard: compute, AI usage, alerts (default on a terminal)")
    p.add_argument("-n", "--interval", type=float, default=5.0, metavar="SEC",
                   help="refresh interval for --live and --web (default 5)")
    p.add_argument("--web", nargs="?", const="127.0.0.1:8765", metavar="[HOST:]PORT",
                   help="web dashboard with /metrics (default 127.0.0.1:8765, works on phones)")
    p.add_argument("--report", action="store_true",
                   help="monthly report: summary, projects, machines and analysis (use with --month)")
    p.add_argument("--html", metavar="FILE", help="with --report: write the report as an HTML page")
    p.add_argument("--line", action="store_true",
                   help="one line for status bars: limits used and today's API-equivalent spend")
    p.add_argument("--statusline", action="store_true",
                   help="Claude Code statusLine command: records Claude's limits from stdin, prints --line")
    p.add_argument("--sep", default="\uff5c", help="separator for --line (default: \uff5c)")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--no-sync", action="store_true", help="don't import new usage before reporting")
    return p.parse_args(argv)


def pick_range(args):
    if args.since or args.until:
        start = parse_day(args.since) if args.since else 0
        end = parse_day(args.until) + 86400 if args.until else int(now()) + 1
        label = "%s..%s" % (args.since or "", args.until or "")
        return start, end, label
    return month_range(args.month or None)


def emit(obj, text, as_json):
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))   # JSON 會把控制字元跳脫掉
    else:
        # 專案路徑、模型、機器名稱來自 log 和別的機器；資料夾名稱裡的 ESC 序列可以改終端機的畫面、
        # 標題或剪貼簿，所以文字輸出一律去掉控制字元
        print(untrusted(text))


def main(argv=None):
    args = parse_args(argv)
    if args.paths:
        print("config: " + config_dir())
        print("ledger: " + data_dir())
        return 0
    ensure_config()
    db = open_ledger()
    try:
        return run(args, db)
    finally:
        db.close()


def default_machine():
    for m in machines():
        if m["host"] == "local":
            return m["name"]
    return local_hostname()


def local_hostname():
    return socket.gethostname().split(".")[0] or "local"


ACTIONS = ("sync", "summary", "line", "statusline", "sample", "cloud", "proxy", "analyze", "live", "web",
           "report")


def run(args, db):
    asked = (args.payback is not None or any(getattr(args, a) for a in ACTIONS) or args.json
             or args.html or args.month is not None or args.since or args.until or args.by != "model")
    if not asked and sys.stdout.isatty() and sys.stdin.isatty():
        args.live = True  # 在終端機裡只打 computai 就是 live 畫面；帶了其他選項就照選項做
    if args.live:
        db.close()
        return run_live(args.interval, args.sample_every)
    if args.web:
        db.close()
        return serve_web(args.web, args.interval, args.sample_every)
    if args.proxy:
        db.close()
        return serve_proxy(args.listen, args.upstream, args.machine or default_machine(),
                           args.sample_every, not args.no_usage_injection)
    if args.statusline:
        add_limits(db, claude_statusline_limits(read_statusline_stdin(), now()), only_changes=True)
        db.commit()
        args.line = True
    if args.cloud:
        insts, errors = sample_clouds(db)
        if not args.summary and not args.sample:
            al = cloud_alerts(db)
            emit({"cloud": insts, "errors": errors, "alerts": al}, render_cloud(insts, al, errors)
                 if insts or errors else "No cloud GPUs (set RUNPOD_API_KEY, VAST_API_KEY or LAMBDA_API_KEY).",
                 args.json)
            return 0
    if args.sample:
        sample_machines(db)
        if not args.summary:
            start, end, label = pick_range(args)
            rep, al = machine_report(db, start, end), machine_alerts() + idle_alerts(db)
            emit({"machines": rep, "alerts": al}, render_machines(rep, al), args.json)
            return 0
    if args.line:
        if not args.no_sync:
            maybe_sync(db)
        info = line_parts(db)
        emit(info, render_line(info, args.sep), args.json)
        return 0
    if args.payback is not None:
        r = payback(db, args.payback, args.gpu_watts, args.hours_per_day, args.rent_per_hour)
        emit(r, render_payback(r), args.json)
        return 0 if not r.get("error") else 1
    if args.report or args.html:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label = pick_range(args)
        r = report_data(db, start, end, label)
        if args.html:
            with open(args.html, "w", encoding="utf-8") as f:
                f.write(render_report_html(r))
            print("computai: wrote %s" % args.html)
            return 0
        emit(r, render_report_text(r), args.json)
        return 0
    if args.analyze:
        if not args.no_sync:
            sync(db, quiet=True)
        start, end, label = pick_range(args)
        a = analyze(db, start, end, label)
        emit(a, render_analysis(a), args.json)
        return 0
    if args.sync:
        added = sync(db, quiet=args.json)
        if args.json and not args.summary:
            print(json.dumps({"added": added}))
        if not args.summary:
            return 0
    elif not args.no_sync:
        sync(db, quiet=True)
    start, end, label = pick_range(args)
    s = summary(db, start, end, label=label)
    s["limits"] = current_limits(db)
    text = render_summary(s)
    if s["limits"]:
        text += "\n\n" + render_limits(s["limits"])
    s["machines"] = machine_report(db, start, end)
    s["cloud"] = latest_cloud(db)
    s["alerts"] = idle_alerts(db) + cloud_alerts(db)
    if s["machines"]:
        text += "\n\n" + render_machines(s["machines"])
    if s["cloud"]:
        text += "\n\n" + render_cloud(s["cloud"])
    if s["alerts"]:
        text += "\n\nAlerts\n" + "\n".join("! " + a["message"] for a in s["alerts"])
    if args.by != "model":
        s["by_" + args.by] = breakdown(db, start, end, args.by)
        text += "\n\n" + render_breakdown(s["by_" + args.by], args.by)
    emit(s, text, args.json)
    return 0


if __name__ == "__main__":
    sys.exit(main())
