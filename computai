            continue
        if isinstance(d, dict) and d.get("computai_totals") == 1:
            rows.append(d)
    srcs = sorted({k for r in rows for k in r.get("sources", {})})
    total = {"who": "total", "month": ",".join(sorted({str(r.get("month")) for r in rows})),
             "sources": {k: {"cost_usd": round(sum(r["sources"].get(k, {}).get("cost_usd", 0) for r in rows), 2),
                             "tokens": sum(r["sources"].get(k, {}).get("tokens", 0) for r in rows)} for k in srcs},
             "kwh": round(sum(r.get("kwh") or 0 for r in rows), 3),
             "total_cost_usd": round(sum(r.get("total_cost_usd") or 0 for r in rows), 2)}
    return rows, total, srcs


