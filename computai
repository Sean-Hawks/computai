def _svg_days(days, width=720, height=220):
    """每日花費的堆疊長條圖（照 dataviz 規則：固定順序的類別色、細的長條、2px 間隔、
    圓角只在頂端、每段有 <title> 當 hover 提示，另外有表格版）。"""
    import html
    if not days:
        return ""
    pad_l, pad_b, pad_t = 44, 22, 8
    plot_w, plot_h = width - pad_l - 8, height - pad_b - pad_t
    top = max(sum(d[k] for k in REPORT_SERIES) for d in days) or 1.0
    step = [1, 2, 5]
    unit = 1
    while top / unit > 5:
        unit = unit * step[1] if str(unit)[0] == "1" else unit * 2.5 if str(unit)[0] == "2" else unit * 2
    ymax = unit * (int(top / unit) + 1)
    bw = plot_w / len(days)
    out = ['<svg viewBox="0 0 %d %d" role="img" aria-label="Daily cost by source" class="chart">' % (width, height)]
    for i in range(0, int(ymax / unit) + 1):
        y = pad_t + plot_h - plot_h * (i * unit) / ymax
        out.append('<line x1="%d" x2="%d" y1="%.1f" y2="%.1f" class="grid"/>' % (pad_l, width - 8, y, y))
        out.append('<text x="%d" y="%.1f" class="tick" text-anchor="end">$%s</text>'
                   % (pad_l - 6, y + 4, ("%g" % (i * unit))))
    for n, d in enumerate(days):
        x = pad_l + n * bw + 1
        w = max(bw - 2, 1)
        y = pad_t + plot_h
        segs = [(k, d[k]) for k in REPORT_SERIES if d[k] > 0]
        for j, (k, v) in enumerate(segs):
            h = plot_h * v / ymax
            y -= h
            gap = 2 if j < len(segs) - 1 else 0
            r = 2 if j == len(segs) - 1 and h > 4 else 0
            out.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" rx="%d" class="s-%s">'
                       '<title>%s %s: %s</title></rect>'
                       % (x, y + gap / 2.0, w, max(h - gap, 0.5), r, k, html.escape(d["day"]), k, fmt_usd(v)))
        if len(days) <= 16 or n % 5 == 0:
            out.append('<text x="%.1f" y="%d" class="tick" text-anchor="middle">%s</text>'
                       % (x + w / 2, height - 6, html.escape(d["day"][8:])))
    out.append("</svg>")
    return "".join(out)


