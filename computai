REPORT_SERIES = ("claude", "codex", "cloud", "other")


def report_data(db, start, end, label):
    s = summary(db, start, end, label=label)
    days = {}
    for g in breakdown(db, start, end, "day"):
        key = g["source"] if g["source"] in REPORT_SERIES else "other"
        d = days.setdefault(g["day"], dict.fromkeys(REPORT_SERIES, 0.0))
        d[key] += g["cost_usd"]
    t = start  # 沒有用量的日子也要出現在圖上，x 軸才是連續的日期
    while t < min(end, now() + 86400):
        days.setdefault(day_label(t), dict.fromkeys(REPORT_SERIES, 0.0))
        t += 86400
    return {"summary": s, "days": [dict(day=k, **v) for k, v in sorted(days.items())],
