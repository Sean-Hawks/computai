def use_color(stream=None):
    stream = stream or sys.stdout
    return stream.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def _sgr(code, s, on):
    return "\033[%sm%s\033[0m" % (code, s) if on else s


def bar(pct, width=10):
    pct = max(0.0, min(100.0, pct or 0.0))
    full = int(round(pct / 100.0 * width))
    return "█" * full + "░" * (width - full)


def render_live(st, width=80, color=False):
    """三區：算力／AI 用量／警示。"""
    b = lambda s: _sgr("1", s, color)
    d = lambda s: _sgr("2", s, color)
    red = lambda s: _sgr("31", s, color)
    width = max(40, width)

    def rule(title):
        return b("── " + title + " ") + d("─" * max(0, width - vlen(title) - 4))

    out = [b("ComputAI") + "  " + time.strftime("%Y-%m-%d %H:%M", time.localtime(st["time"]))
           + "   " + st["line_text"], ""]
    out.append(rule("Compute"))
    if not st["machines"] and not st["cloud"]:
        out.append(d("  no machines sampled yet ([machines] in config.ini, or --sample)"))
    for m in st["machines"]:
        gpu = "-" if m["gpu_util"] is None else "%3d%%" % round(m["gpu_util"])
        cpu = "-" if m["cpu_pct"] is None else "%3d%%" % round(m["cpu_pct"])
        pw = "" if m["power_w"] is None else "%5.0f W" % m["power_w"]
        state = "AI" if m["ai_active"] else "  "
        out.append("  %s CPU %s  GPU %s %s %s  %s%s" % (
            cell(m["machine"], 16), cpu, gpu, bar(m["gpu_util"], 8), pw, state,
            d("  (%s ago)" % fmt_dur(m["age"])) if m["age"] > 300 else ""))
        for x in m["loaded"]:
            out.append(d("      %s on %s%s" % (x["name"], x["service"],
                                              ", %s MB" % format(x["vram_mb"], ",") if x["vram_mb"] else "")))
    for c in st["cloud"]:
        util = "-" if c["gpu_util"] is None else "%d%%" % round(c["gpu_util"])
        out.append("  %s %-9s %s GPU %4s  %s" % (
            cell("%s/%s" % (c["provider"], c["name"]), 22), c["status"][:9],
            cell("%s x%d" % (c["gpu"], c["gpu_count"] or 1), 16), util,
            (fmt_usd(c["usd_per_hour"]) + "/h") if c["billing"] else d("not billing")))
    for r in st["energy"]:
        if r["kwh"]:
            out.append(d("  %s: %.2f kWh this month, AI %s" % (
                r["machine"], r["kwh"], "-" if r["ai_share"] is None else "%d%%" % round(100 * r["ai_share"]))))
    out.append("")
    out.append(rule("AI usage  " + st["month"]))
    for x in st["sources"]:
        plan = x.get("plan")
        extra = ""
        if plan:
            extra = d("  plan %s %s -> %.1fx" % (plan["name"], fmt_usd(plan["fee_in_range"]),
                                                 plan["value_ratio"] or 0))
        out.append("  %-14s %9s req %9s tok %10s%s" % (x["source"], fmt_tok(x["requests"]),
                                                      fmt_tok(x["tokens"]), fmt_usd(x["cost_usd"]), extra))
    for r in st["limits"]:
        out.append("  %-14s %-6s %s %3d%%  %s" % (r["source"], r["name"], bar(r["used_percent"]),
                                                  round(r["used_percent"]),
                                                  "" if r["resets_in"] is None else "resets in " + fmt_dur(r["resets_in"])))
    f = st["forecast"]
    out.append("  today %s   month so far %s   month-end forecast %s" % (
        fmt_usd(st["today_usd"]), fmt_usd(st["total_cost_usd"]), fmt_usd(f["projected_usd"])))
    out.append("")
    out.append(rule("Alerts"))
    if not st["alerts"]:
        out.append(d("  none"))
    for a in st["alerts"]:
        out.append(red("  ! ") + a["message"])
    return "\n".join(out)


def clean_strings(obj):
    """資料裡的字串（專案路徑、模型、機器名稱）去掉控制字元，畫面上的色碼由我們自己加。"""
    if isinstance(obj, str):
        return untrusted(obj)
    if isinstance(obj, list):
        return [clean_strings(x) for x in obj]
    if isinstance(obj, dict):
        return {k: clean_strings(v) for k, v in obj.items()}
    return obj


def run_live(interval, sample_every):
    """終端機 live 畫面：Ctrl-C 或 q 離開。"""
    color = use_color()
    box = {"st": None}
    lock = threading.Lock()
    upd = Updater(sample_every=sample_every)

    def on_state(st):
        with lock:
            box["st"] = st
    th = threading.Thread(target=upd.run, args=(on_state, interval), daemon=True)
    th.start()
    old_tty = None
    try:
        if os.name != "nt" and sys.stdin.isatty():
            import termios
            import tty
            old_tty = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\033[?1049h\033[?25l")  # 換到另一個畫面、藏游標，離開時還原
        while True:
            with lock:
                st = box["st"]
            cols, rows = shutil.get_terminal_size((100, 40))
            text = render_live(clean_strings(st), cols, color) if st else "ComputAI: reading logs and machines..."
            lines = text.splitlines()[:rows - 1]
            sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n")
            sys.stdout.flush()
            if wait_key(1.0 if st is None else interval):
                break
    except KeyboardInterrupt:
        pass
    finally:
        upd.stop.set()
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        if old_tty is not None:
            import termios
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_tty)
    return 0


def wait_key(timeout):
    """等 timeout 秒；按了 q 回傳 True。"""
    if os.name == "nt":
        import msvcrt
        end = time.time() + timeout
        while time.time() < end:
            if msvcrt.kbhit() and msvcrt.getwch() in ("q", "Q"):
                return True
            time.sleep(0.1)
        return False
    if not sys.stdin.isatty():
        time.sleep(timeout)
        return False
    import select
    r, _, _ = select.select([sys.stdin], [], [], timeout)
    return bool(r) and sys.stdin.read(1) in ("q", "Q")


